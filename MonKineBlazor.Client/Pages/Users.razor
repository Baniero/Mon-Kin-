@page "/users"
@attribute [AdminOnly]
@inject MonKineBlazor.Client.Services.AuthService AuthService
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<h1>Utilisateurs</h1>

@if (!AuthService.IsAuthenticated || AuthService.CurrentUser?.Role != "admin")
{
    <div class="alert alert-danger">Accès refusé. Seul l'administrateur peut gérer les utilisateurs.</div>
}
else
{
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">Créer un utilisateur</div>
                <div class="card-body">
                    <EditForm Model="newUser" OnValidSubmit="CreateUser">
                        <div class="mb-3">
                            <label class="form-label">Nom d'utilisateur</label>
                            <InputText class="form-control" @bind-Value="newUser.Username" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nom complet</label>
                            <InputText class="form-control" @bind-Value="newUser.FullName" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Rôle</label>
                            <InputSelect class="form-select" @bind-Value="newUser.Role">
                                <option value="kine">Kiné</option>
                                <option value="admin">Admin</option>
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mot de passe</label>
                            <InputText type="password" class="form-control" @bind-Value="newUser.Password" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Modules autorisés</label>
                            <div class="row">
                                @foreach (var module in moduleOptions)
                                {
                                    <div class="col-md-6">
                                        <div class="form-check">
                                            <input type="checkbox" class="form-check-input"
                                                   checked="@newUser.Modules.Contains(module.Id)"
                                                   @onchange="() => ToggleModule(newUser.Modules, module.Id)" />
                                            <label class="form-check-label">@module.Label</label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="form-check mb-3">
                            <InputCheckbox class="form-check-input" @bind-Value="newUser.Active" />
                            <label class="form-check-label">Actif</label>
                        </div>
                        <button class="btn btn-success" type="submit">Créer</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>

    @if (editingUser is not null)
    {
        <div class="card mb-4">
            <div class="card-header">Modifier l'utilisateur</div>
            <div class="card-body">
                <EditForm Model="editingUser" OnValidSubmit="UpdateUser">
                    <div class="mb-3">
                        <label class="form-label">Nom d'utilisateur</label>
                        <InputText class="form-control" @bind-Value="editingUser.Username" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nom complet</label>
                        <InputText class="form-control" @bind-Value="editingUser.FullName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Rôle</label>
                        <InputSelect class="form-select" @bind-Value="editingUser.Role">
                            <option value="kine">Kiné</option>
                            <option value="admin">Admin</option>
                        </InputSelect>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nouveau mot de passe</label>
                        <InputText type="password" class="form-control" @bind-Value="editingUser.Password" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Modules autorisés</label>
                        <div class="row">
                            @foreach (var module in moduleOptions)
                            {
                                <div class="col-md-6">
                                    <div class="form-check">
                                        <input type="checkbox" class="form-check-input"
                                               checked="@editingUser.Modules.Contains(module.Id)"
                                               @onchange="() => ToggleModule(editingUser.Modules, module.Id)" />
                                        <label class="form-check-label">@module.Label</label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="form-check mb-3">
                        <InputCheckbox class="form-check-input" @bind-Value="editingUser.Active" />
                        <label class="form-check-label">Actif</label>
                    </div>
                    <button class="btn btn-primary me-2" type="submit">Enregistrer</button>
                    <button class="btn btn-secondary" type="button" @onclick="CancelEdit">Annuler</button>
                </EditForm>
            </div>
        </div>
    }

    <div class="card">
        <div class="card-header">Liste des utilisateurs</div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Utilisateur</th>
                            <th>Nom complet</th>
                            <th>Rôle</th>
                            <th>Téléphone</th>
                            <th>Actif</th>
                            <th>Cabinet demandé</th>
                            <th>N° employeur</th>
                            <th>Message</th>
                            <th>Modules</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in users)
                        {
                            <tr>
                                <td>@user.Username</td>
                                <td>@user.FullName</td>
                                <td>@user.Role</td>
                                <td>@user.Telephone</td>
                                <td>@(user.Active ? "Oui" : "Non")</td>
                                <td>@user.RequestedCabinetName</td>
                                <td>@user.RequestedNumeroEmployeur</td>
                                <td>@user.RequestMessage</td>
                                <td>@string.Join(", ", user.Modules)</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditUser(user)">Modifier</button>
                                    <button class="btn btn-sm btn-outline-danger ms-2" @onclick="() => DeleteUser(user.Id, user.Username)">Supprimer</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@code {
    private string? errorMessage;
    private List<UserDto> users = new();
    private UserCreateRequestDto newUser = new() { Role = "kine", Active = true };
    private UserUpdateRequestDto? editingUser;

    private readonly List<ModuleOption> moduleOptions = new()
    {
        new("cnam", "CNAM"),
        new("appointments", "Rendez-vous"),
        new("finance", "Finance"),
        new("patients", "Patients"),
        new("settings", "Paramètres")
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated && AuthService.CurrentUser?.Role == "admin")
        {
            await LoadUsers();
        }
    }

    private async Task LoadUsers()
    {
        try
        {
            users = await Http.GetFromJsonAsync<List<UserDto>>("api/users") ?? new List<UserDto>();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task CreateUser()
    {
        errorMessage = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/users", newUser);
            if (response.IsSuccessStatusCode)
            {
                newUser = new UserCreateRequestDto { Role = "kine", Active = true };
                await LoadUsers();
            }
            else
            {
                errorMessage = "Impossible de créer l'utilisateur.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void ToggleModule(List<string> modules, string moduleId)
    {
        if (modules.Contains(moduleId))
        {
            modules.Remove(moduleId);
        }
        else
        {
            modules.Add(moduleId);
        }
    }

    private void ShowEditUser(UserDto user)
    {
        editingUser = new UserUpdateRequestDto
        {
            Id = user.Id,
            Username = user.Username,
            FullName = user.FullName,
            Role = user.Role,
            Active = user.Active,
            CabinetId = user.CabinetId,
            Telephone = user.Telephone,
            Modules = user.Modules.ToList()
        };
    }

    private async Task UpdateUser()
    {
        if (editingUser == null)
        {
            return;
        }

        errorMessage = null;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/users/{editingUser.Id}", editingUser);
            if (response.IsSuccessStatusCode)
            {
                editingUser = null;
                await LoadUsers();
            }
            else
            {
                errorMessage = "Impossible de mettre à jour l'utilisateur.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void CancelEdit()
    {
        editingUser = null;
    }

    private async Task DeleteUser(int userId, string username)
    {
        errorMessage = null;
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Supprimer l'utilisateur '{username}' ?"))
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/users/{userId}");
            if (response.IsSuccessStatusCode)
            {
                if (editingUser?.Id == userId)
                {
                    editingUser = null;
                }
                await LoadUsers();
            }
            else
            {
                errorMessage = "Impossible de supprimer l'utilisateur.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    public class ModuleOption
    {
        public string Id { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;

        public ModuleOption(string id, string label)
        {
            Id = id;
            Label = label;
        }
    }
}
