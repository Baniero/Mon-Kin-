else
{
    <div class="dashboard-header mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-4">
            <div>
                <p class="text-uppercase text-secondary mb-2">Cabinet @cabinetInfo.NomCabinet</p>
                <h1 class="display-6 fw-bold mb-2">Tableau de bord du cabinet</h1>
                <div class="dashboard-meta text-muted">
                    <span>Rôle : @AuthService.CurrentUser?.Role</span>
                    <span class="mx-3">·</span>
                    <span>Dernière mise à jour : @lastUpdated</span>
                </div>
            </div>
            <div class="d-flex flex-column flex-md-row gap-2 align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <label class="mb-0 text-muted">Mois :</label>
                    <input type="month" class="form-control form-control-sm" value="@selectedMonth" @onchange="OnSelectedMonthChanged" />
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-outline-secondary btn-sm" href="patients"><i class="bi bi-person-lines-fill me-2"></i>Patients</a>
                    <a class="btn btn-outline-secondary btn-sm" href="appointments"><i class="bi bi-calendar-check me-2"></i>Rendez-vous</a>
                    <a class="btn btn-outline-secondary btn-sm" href="cnam"><i class="bi bi-file-earmark-medical me-2"></i>CNAM</a>
                    <a class="btn btn-outline-secondary btn-sm" href="manage-cabinet"><i class="bi bi-building me-2"></i>Cabinet</a>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-warning">@errorMessage</div>
        }

        <div class="row g-4 mb-4">
            <div class="col-sm-6 col-xl-3">
                <div class="kpi-card shadow-sm p-4 h-100">
                    <div class="kpi-icon bg-primary-soft text-primary"><i class="bi bi-people-fill"></i></div>
                    <p class="kpi-label">Total patients</p>
                    <h2>@totalPatients</h2>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="kpi-card shadow-sm p-4 h-100">
                    <div class="kpi-icon bg-info-soft text-info"><i class="bi bi-heart-pulse"></i></div>
                    <p class="kpi-label">Patients CNAM actifs</p>
                    <h2>@cnamPatients</h2>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="kpi-card shadow-sm p-4 h-100">
                    <div class="kpi-icon bg-warning-soft text-warning"><i class="bi bi-file-earmark-text"></i></div>
                    <p class="kpi-label">Bordereaux à exécuter</p>
                    <h2>@pendingBordereaux</h2>
                </div>
            </div>
            <div class="col-sm-6 col-xl-3">
                <div class="kpi-card shadow-sm p-4 h-100">
                    <div class="kpi-icon bg-secondary-soft text-secondary"><i class="bi bi-file-earmark-ppt"></i></div>
                    <p class="kpi-label">Factures CNAM en attente</p>
                    <h2>@pendingFactures</h2>
                </div>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-4">
                <div class="task-card shadow-sm rounded-4 p-4 h-100">
                    <h5 class="mb-3">Actions prioritaires</h5>
                    <div class="task-item">
                        <div>
                            <p class="mb-1">Rendez-vous aujourd'hui</p>
                            <strong>@todayAppointments</strong>
                        </div>
                        <span class="badge bg-primary-soft text-primary">A vérifier</span>
                    </div>
                    <div class="task-item">
                        <div>
                            <p class="mb-1">Revenus attendus</p>
                            <strong>@($"{expectedRevenue:F2} DT")</strong>
                        </div>
                        <span class="badge bg-info-soft text-info">Prévision</span>
                    </div>
                    <div class="task-item">
                        <div>
                            <p class="mb-1">Revenus encaissés</p>
                            <strong>@($"{collectedRevenue:F2} DT")</strong>
                        </div>
                        <span class="badge bg-success-soft text-success">Réel</span>
                    </div>
                    <div class="task-item">
                        <div>
                            <p class="mb-1">Taux de satisfaction</p>
                            <strong>@satisfactionRate%</strong>
                        </div>
                        <span class="badge bg-secondary-soft text-secondary">Programme</span>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="chart-card shadow-sm rounded-4 p-4 h-100">
                    <h5 class="mb-4">Part CNAM / non CNAM</h5>
                    <div class="chart-bar-group mb-3">
                        <div class="chart-bar-label">CNAM</div>
                        <div class="chart-bar-track">
                            <div class="chart-bar-fill bg-info" style="width:@(totalPatients > 0 ? (int)Math.Round((double)cnamPatients / totalPatients * 100) : 0)%"></div>
                        </div>
                        <div class="chart-value">@(totalPatients > 0 ? (int)Math.Round((double)cnamPatients / totalPatients * 100) : 0)%</div>
                    </div>
                    <div class="chart-bar-group mb-3">
                        <div class="chart-bar-label">Non CNAM</div>
                        <div class="chart-bar-track">
                            <div class="chart-bar-fill bg-secondary" style="width:@(totalPatients > 0 ? 100 - (int)Math.Round((double)cnamPatients / totalPatients * 100) : 0)%"></div>
                        </div>
                        <div class="chart-value">@(totalPatients > 0 ? 100 - (int)Math.Round((double)cnamPatients / totalPatients * 100) : 0)%</div>
                    </div>
                    <div class="chart-bar-group">
                        <div class="chart-bar-label">Satisfaction des programmes</div>
                        <div class="chart-bar-track">
                            <div class="chart-bar-fill bg-success" style="width:@satisfactionRate%"></div>
                        </div>
                        <div class="chart-value">@satisfactionRate%</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="appointments-card shadow-sm rounded-4 p-4 h-100">
                    <h5 class="mb-4">Rendez-vous du jour</h5>
                    @if (!appointments.Any(a => a.Start.HasValue && a.Start.Value.Date == DateTime.Today))
                    {
                        <p class="text-muted mb-0">Aucun rendez-vous prévu aujourd'hui.</p>
                    }
                    else
                    {
                        <div class="list-group list-group-flush">
                            @foreach (var appointment in appointments.Where(a => a.Start.HasValue && a.Start.Value.Date == DateTime.Today).Take(5))
                            {
                                <div class="list-group-item p-3 d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong>@appointment.PatientName</strong>
                                        <div class="text-muted small">@appointment.Start:dd/MM HH:mm - @appointment.Acte</div>
                                    </div>
                                    <span class="badge bg-primary-soft text-primary">@appointment.Status</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private CabinetDto cabinetInfo = new();
    private List<PatientDto> patients = new();
    private List<PatientDto> recentPatients = new();
    private List<AppointmentDto> appointments = new();
    private int totalPatients;
    private int cnamPatients;
    private int pendingBordereaux;
    private int pendingFactures;
    private int todayAppointments;
    private decimal expectedRevenue;
    private decimal collectedRevenue;
    private int satisfactionRate;
    private string selectedMonth = DateTime.Today.ToString("yyyy-MM");
    private string averagePatientAge = "-";
    private string lastUpdated = "-";

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated)
        {
            await LoadDashboardAsync();
        }
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var today = DateTime.Today;
            patients = await Http.GetFromJsonAsync<List<PatientDto>>("api/patients") ?? new List<PatientDto>();
            totalPatients = patients.Count;
            cnamPatients = patients.Count(p => string.Equals(p.Couverture, "CNAM", StringComparison.OrdinalIgnoreCase));
            averagePatientAge = patients.Any() ? Math.Round(patients.Average(p => p.Age)).ToString() : "-";
            recentPatients = patients.OrderByDescending(p => p.Id).Take(5).ToList();

            appointments = await Http.GetFromJsonAsync<List<AppointmentDto>>("api/appointments") ?? new List<AppointmentDto>();
            todayAppointments = appointments.Count(a => a.Start.HasValue && a.Start.Value.Date == today);
            UpdateMonthlyMetrics();

            var startDate = today.AddMonths(-1).ToString("yyyy-MM-dd");
            var endDate = today.AddDays(30).ToString("yyyy-MM-dd");

            await LoadCnamPrograms(startDate, endDate);
            await LoadCnamBordereau(startDate, endDate);

            lastUpdated = DateTime.Now.ToString("dd MMM yyyy HH:mm");
            await LoadCabinetInfo();
        }
        catch (HttpRequestException httpEx)
        {
            errorMessage = "Impossible de charger le tableau de bord : " + httpEx.Message;
        }
        catch (Exception ex)
        {
            errorMessage = "Impossible de charger le tableau de bord : " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadCnamPrograms(string startDate, string endDate)
    {
        try
        {
            var cnamPrograms = await Http.GetFromJsonAsync<List<CnamProgramInvoiceDto>>($"api/finance/cnam-programs?start={Uri.EscapeDataString(startDate)}&end={Uri.EscapeDataString(endDate)}");
            pendingFactures = cnamPrograms?.Count ?? 0;
        }
        catch (Exception ex)
        {
            _ = ex;
            pendingFactures = 0;
        }
    }

    private async Task LoadCnamBordereau(string startDate, string endDate)
    {
        try
        {
            var cnamBordereau = await Http.GetFromJsonAsync<List<CnamBordereauEntryDto>>($"api/finance/cnam-bordereau?start={Uri.EscapeDataString(startDate)}&end={Uri.EscapeDataString(endDate)}");
            pendingBordereaux = cnamBordereau?.Select(r => r.BordereauNumber).Distinct().Count(n => n.HasValue) ?? 0;
        }
        catch (Exception ex)
        {
            _ = ex;
            pendingBordereaux = 0;
        }
    }

    private async Task LoadCabinetInfo()
    {
        try
        {
            var cabinets = await Http.GetFromJsonAsync<List<CabinetDto>>("api/cabinets") ?? new List<CabinetDto>();
            cabinetInfo = cabinets.FirstOrDefault(c => c.Id == AuthService.CurrentUser?.CabinetId) ?? cabinets.FirstOrDefault() ?? new CabinetDto();
        }
        catch
        {
            cabinetInfo = new CabinetDto();
        }
    }

    private void UpdateMonthlyMetrics()
    {
        if (!DateTime.TryParseExact(selectedMonth + "-01", "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var monthDate))
        {
            monthDate = DateTime.Today;
        }

        var monthAppointments = appointments
            .Where(a => a.Start.HasValue && a.Start.Value.Year == monthDate.Year && a.Start.Value.Month == monthDate.Month)
            .ToList();

        expectedRevenue = monthAppointments.Sum(a => a.Amount);
        collectedRevenue = monthAppointments.Sum(a => a.PaidAmount);

        satisfactionRate = expectedRevenue > 0
            ? (int)Math.Round((collectedRevenue / expectedRevenue) * 100)
            : 0;
    }

    private void OnSelectedMonthChanged(ChangeEventArgs e)
    {
        selectedMonth = e.Value?.ToString() ?? selectedMonth;
        UpdateMonthlyMetrics();
    }
}
