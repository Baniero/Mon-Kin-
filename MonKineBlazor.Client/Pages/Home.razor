@page "/"
@attribute [AllowAnonymous]
@using MonKineBlazor.Shared.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject MonKineBlazor.Client.Services.AuthService AuthService
@inject NavigationManager NavigationManager

<PageTitle>Mon kiné</PageTitle>

@if (!AuthService.IsAuthenticated)
{
    <div class="landing-hero py-6">
        <div class="container">
            <div class="row align-items-center gy-5">
                <div class="col-lg-6">
                    <span class="hero-badge">Solution complète pour kinés</span>
                    <h1 class="display-4 fw-bold text-white">Gérez votre cabinet kiné avec élégance et performance</h1>
                    <p class="lead text-white-75 mb-4">Mon kiné vous aide à centraliser les patients, piloter les exports CNAM, organiser les rendez-vous et optimiser chaque séance.</p>

                    <div class="d-flex flex-wrap gap-3 mb-4">
                        <a class="btn btn-hero btn-lg" href="register">S'inscrire</a>
                        <a class="btn btn-outline-hero btn-lg" href="login">Se connecter</a>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="feature-card text-white">
                                <div class="feature-dot bg-light"></div>
                                <h5>Gestion patients</h5>
                                <p class="mb-0">Dossiers, couverture et historique en un seul endroit.</p>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="feature-card text-white">
                                <div class="feature-dot bg-light"></div>
                                <h5>Facturation CNAM</h5>
                                <p class="mb-0">Bordereaux, exports TXT/PDF et suivi d'exécution.</p>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="feature-card text-white">
                                <div class="feature-dot bg-light"></div>
                                <h5>Agenda intégré</h5>
                                <p class="mb-0">Rendez-vous clairs et suivi de séances simplifié.</p>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="feature-card text-white">
                                <div class="feature-dot bg-light"></div>
                                <h5>Paramètres cabinet</h5>
                                <p class="mb-0">Options de programme et nature des séances configurables.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-6 text-center">
                    <div class="hero-image-wrap mx-auto shadow-lg rounded-4">
                        <img src="affiche.png" alt="Affiche Mon kiné" class="img-fluid rounded-4" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container py-5">
        <div class="row align-items-center gy-4 mb-5">
            <div class="col-lg-7">
                <h2 class="fw-bold">Une plateforme professionnelle pour les kinés exigeants</h2>
                <p class="text-muted">Mon kiné regroupe le suivi patient, les commandes CNAM, l'agenda et les paramètres cabinet dans une interface moderne et réactive.</p>
            </div>
            <div class="col-lg-5">
                <div class="info-panel p-4 rounded-4 shadow-sm">
                    <h5>Fonctionnalités clés</h5>
                    <ul class="list-unstyled mt-3 mb-0">
                        <li class="mb-3"><strong>Patients</strong> : fiches, couverture et historique.</li>
                        <li class="mb-3"><strong>CNAM</strong> : bordereaux, export et suivi.</li>
                        <li class="mb-3"><strong>Agenda</strong> : rendez-vous et statut de séance.</li>
                        <li><strong>Paramètres</strong> : options cabinet et natures de séances.</li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="stat-card rounded-4 shadow-sm p-4 h-100">
                    <span class="stat-icon bg-primary-soft text-primary">1</span>
                    <h5 class="mt-3">Inscription simplifiée</h5>
                    <p class="text-muted mb-0">Demandez un compte et l'administrateur validera votre cabinet.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card rounded-4 shadow-sm p-4 h-100">
                    <span class="stat-icon bg-secondary-soft text-secondary">2</span>
                    <h5 class="mt-3">Design épuré</h5>
                    <p class="text-muted mb-0">Une interface claire pour travailler rapidement et en toute confiance.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card rounded-4 shadow-sm p-4 h-100">
                    <span class="stat-icon bg-success-soft text-success">3</span>
                    <h5 class="mt-3">Soutien administratif</h5>
                    <p class="text-muted mb-0">Un accès contrôlé par l'administrateur pour une gestion sécurisée.</p>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6">📊 Tableau de bord professionnel</h1>
            <p class="text-muted">Vue d'ensemble des patients, des flux CNAM et des tendances cliniques.</p>
        </div>
        <div>
            <a class="btn btn-primary" href="patients"><i class="bi bi-person-lines-fill me-2"></i>Gérer les patients</a>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">@errorMessage</div>
    }
    else
    {
        <div class="row g-4 mb-4">
            <div class="col-md-3">
                <div class="card metric-card shadow-sm p-3">
                    <div class="metric-icon"><i class="bi bi-people-fill"></i></div>
                    <h6 class="card-title text-uppercase text-muted">Patients enregistrés</h6>
                    <h2 class="card-text">@totalPatients</h2>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card metric-card shadow-sm p-3">
                    <div class="metric-icon"><i class="bi bi-heart-pulse"></i></div>
                    <h6 class="card-title text-uppercase text-muted">Patients CNAM</h6>
                    <h2 class="card-text">@cnamPatients</h2>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card metric-card shadow-sm p-3">
                    <div class="metric-icon"><i class="bi bi-calendar-check-fill"></i></div>
                    <h6 class="card-title text-uppercase text-muted">Patient moyen</h6>
                    <h2 class="card-text">@averagePatientAge</h2>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card metric-card shadow-sm p-3">
                    <div class="metric-icon"><i class="bi bi-clock-history"></i></div>
                    <h6 class="card-title text-uppercase text-muted">Dernière mise à jour</h6>
                    <p class="mb-0">@lastUpdated</p>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-graph-up-arrow me-2"></i>Analyse rapide</span>
                <span class="badge-emoji">📈 CNAM / non CNAM</span>
            </div>
            <div class="card-body">
                <div class="dashboard-graph">
                    <div class="graph-item">
                        <span class="graph-label">CNAM (% du total)</span>
                        <span class="graph-bar" style="--bar:@(totalPatients > 0 ? (int)Math.Round((double)cnamPatients / totalPatients * 100) : 0)%" data-value="@(totalPatients > 0 ? (int)Math.Round((double)cnamPatients / totalPatients * 100) : 0)%"></span>
                    </div>
                    <div class="graph-item">
                        <span class="graph-label">Non CNAM</span>
                        <span class="graph-bar" style="--bar:@(totalPatients > 0 ? 100 - (int)Math.Round((double)cnamPatients / totalPatients * 100) : 0)%" data-value="@(totalPatients > 0 ? 100 - (int)Math.Round((double)cnamPatients / totalPatients * 100) : 0)%"></span>
                    </div>
                </div>
                <p class="text-muted mt-3 mb-0">Tendances visuelles pour la part CNAM et les patients standards.</p>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">Patients récents</div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Nom</th>
                            <th>Prénom</th>
                            <th>Couverture</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var patient in recentPatients)
                        {
                            <tr>
                                <td>@patient.CodePatient</td>
                                <td>@patient.Nom</td>
                                <td>@patient.Prenom</td>
                                <td>@patient.Couverture</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    private bool isLoading = true;
    private string? errorMessage;
    private List<PatientDto> patients = new();
    private List<PatientDto> recentPatients = new();
    private int totalPatients;
    private int cnamPatients;
    private string averagePatientAge = "-";
    private string lastUpdated = "-";

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated)
        {
            await LoadDashboardAsync();
        }
    }

    private async Task LoadDashboardAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            patients = await Http.GetFromJsonAsync<List<PatientDto>>("api/patients") ?? new List<PatientDto>();
            totalPatients = patients.Count;
            cnamPatients = patients.Count(p => string.Equals(p.Couverture, "CNAM", StringComparison.OrdinalIgnoreCase));
            averagePatientAge = patients.Any() ? Math.Round(patients.Average(p => p.Age)).ToString() : "-";
            recentPatients = patients.OrderByDescending(p => p.Id).Take(5).ToList();
            lastUpdated = DateTime.Now.ToString("dd MMM yyyy HH:mm");
        }
        catch (Exception ex)
        {
            errorMessage = "Impossible de charger le tableau de bord : " + ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
