@page "/manage-cabinet"
@attribute [AdminOnly]
@using MonKineBlazor.Shared.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<h1>Gérer mon cabinet</h1>

<div class="row mb-3">
    <div class="col-md-4">
        <label class="form-label">Rechercher un kiné</label>
        <InputText class="form-control" @bind-Value="searchKeyword" placeholder="Nom, prénom ou username" />
    </div>
    <div class="col-md-4 d-flex align-items-end">
        <button class="btn btn-primary me-2" @onclick="LoadUsers">Rechercher</button>
        <button class="btn btn-success" @onclick="ShowCreateUser">Nouveau kiné</button>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Données Cabinet</div>
    <div class="card-body">
        @if (!string.IsNullOrEmpty(cabinetMessage))
        {
            <div class="alert alert-success">@cabinetMessage</div>
        }
        <EditForm Model="cabinetInfoForm" OnValidSubmit="SaveCabinetInfoAsync">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nom du cabinet / établissement</label>
                    <InputText class="form-control" @bind-Value="cabinetInfoForm.NomCabinet" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Responsable / Nom de l'établissement</label>
                    <InputText class="form-control" @bind-Value="cabinetInfoForm.NomEtablissement" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Code établissement / professionnel</label>
                    <InputText class="form-control" @bind-Value="cabinetInfoForm.CodeEtablissement" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Matricule fiscal</label>
                    <InputText class="form-control" @bind-Value="cabinetInfoForm.MatriculeFiscal" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Racine</label>
                    <InputText class="form-control" @bind-Value="cabinetInfoForm.Racine" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Clé</label>
                    <InputText class="form-control" @bind-Value="cabinetInfoForm.Cle" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Qualité</label>
                    <InputText class="form-control" @bind-Value="cabinetInfoForm.Qualite" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">N° assurée</label>
                    <InputText class="form-control" @bind-Value="cabinetInfoForm.NumeroAssuree" />
                </div>
                <div class="col-md-12 d-flex justify-content-end">
                    <button class="btn btn-success" type="submit">Enregistrer le cabinet</button>
                </div>
            </div>
        </EditForm>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Cabinets</span>
        <button class="btn btn-primary btn-sm" @onclick="ShowCreateCabinet">Nouveau cabinet</button>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Nom du cabinet</th>
                        <th>Responsable / établissement</th>
                        <th>Code établissement</th>
                        <th>Matricule fiscal</th>
                        <th>Qualité</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cabinet in cabinets)
                    {
                        <tr>
                            <td>@cabinet.NomCabinet</td>
                            <td>@cabinet.NomEtablissement</td>
                            <td>@cabinet.CodeEtablissement</td>
                            <td>@cabinet.MatriculeFiscal</td>
                            <td>@cabinet.Qualite</td>
                            <td>
                                <button class="btn btn-sm btn-primary me-2" @onclick="() => EditCabinet(cabinet)">Modifier</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => DeleteCabinet(cabinet.Id)">Supprimer</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (showCabinetForm)
{
    <div class="card mb-4">
        <div class="card-header">@((selectedCabinet?.Id ?? 0) == 0 ? "Créer un nouveau cabinet" : "Modifier le cabinet")</div>
        <div class="card-body">
            <EditForm Model="cabinetForm" OnValidSubmit="SaveCabinetAsync">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nom du cabinet / établissement</label>
                        <InputText class="form-control" @bind-Value="cabinetForm.NomCabinet" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Responsable / Nom de l'établissement</label>
                        <InputText class="form-control" @bind-Value="cabinetForm.NomEtablissement" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Code établissement / professionnel</label>
                        <InputText class="form-control" @bind-Value="cabinetForm.CodeEtablissement" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Matricule fiscal</label>
                        <InputText class="form-control" @bind-Value="cabinetForm.MatriculeFiscal" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Qualité</label>
                        <InputText class="form-control" @bind-Value="cabinetForm.Qualite" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Racine</label>
                        <InputText class="form-control" @bind-Value="cabinetForm.Racine" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Clé</label>
                        <InputText class="form-control" @bind-Value="cabinetForm.Cle" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">N° assurée</label>
                        <InputText class="form-control" @bind-Value="cabinetForm.NumeroAssuree" />
                    </div>
                    <div class="col-md-12 d-flex justify-content-end">
                        <button class="btn btn-success" type="submit">Enregistrer le cabinet</button>
                        <button class="btn btn-outline-secondary ms-2" type="button" @onclick="HideCabinetForm">Annuler</button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (users is null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Nom</th>
                    <th>Username</th>
                    <th>Cabinet</th>
                    <th>Rôle</th>
                    <th>Actif</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in FilteredUsers())
                {
                    <tr>
                        <td>@user.FullName</td>
                        <td>@user.Username</td>
                        <td>@user.CabinetName</td>
                        <td>@user.Role</td>
                        <td>@(user.Active ? "Oui" : "Non")</td>
                        <td>
                            <button class="btn btn-sm btn-primary me-2" @onclick="() => EditUser(user)">Modifier</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => DeleteUser(user.Id)">Supprimer</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (showForm)
{
    <div class="card mt-4">
        <div class="card-header">@((selectedUser?.Id ?? 0) == 0 ? "Créer un praticien" : "Modifier le praticien")</div>
        <div class="card-body">
            <EditForm Model="userForm" OnValidSubmit="SaveUserAsync">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nom complet</label>
                        <InputText class="form-control" @bind-Value="userForm.FullName" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Username</label>
                        <InputText class="form-control" @bind-Value="userForm.Username" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Rôle</label>
                        <InputSelect class="form-select" @bind-Value="userForm.Role">
                            <option value="kine">Kiné</option>
                            <option value="admin">Admin</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Cabinet</label>
                        <InputSelect class="form-select" @bind-Value="userForm.CabinetId">
                            <option value="">Sélectionner un cabinet</option>
                            @foreach (var cabinet in cabinets)
                            {
                                <option value="@cabinet.Id">@cabinet.NomCabinet</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Actif</label>
                        <InputCheckbox class="form-check-input" @bind-Value="userForm.Active" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Mot de passe</label>
                        <InputText class="form-control" type="password" @bind-Value="userPassword" />
                    </div>
                    <div class="col-md-12">
                        <button class="btn btn-success" type="submit">Enregistrer</button>
                        <button class="btn btn-outline-secondary ms-2" type="button" @onclick="HideForm">Annuler</button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<UserDto> users = new();
    private List<UserDto> allUsers = new();
    private List<CabinetDto> cabinets = new();
    private UserDto userForm = new() { Role = "kine", Active = true };
    private UserDto? selectedUser;
    private bool showForm;
    private string searchKeyword = string.Empty;
    private string userPassword = string.Empty;
    private string? errorMessage;
    private CabinetInfoDto cabinetInfo = new();
    private CabinetInfoRequestDto cabinetInfoForm = new();
    private string? cabinetMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadCabinets();
        await LoadUsers();
        await LoadCabinetInfo();
    }

    private async Task LoadCabinets()
    {
        errorMessage = null;
        try
        {
            cabinets = await Http.GetFromJsonAsync<List<CabinetDto>>("api/cabinets") ?? new List<CabinetDto>();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadUsers()
    {
        errorMessage = null;
        try
        {
            allUsers = await Http.GetFromJsonAsync<List<UserDto>>("api/users") ?? new List<UserDto>();
            users = allUsers;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadCabinetInfo()
    {
        cabinetMessage = null;
        try
        {
            cabinetInfo = await Http.GetFromJsonAsync<CabinetInfoDto>("api/cabinetinfo") ?? new CabinetInfoDto();
            cabinetInfoForm = new CabinetInfoRequestDto
            {
                NomCabinet = cabinetInfo.NomCabinet,
                Racine = cabinetInfo.Racine,
                Cle = cabinetInfo.Cle,
                Qualite = cabinetInfo.Qualite,
                NumeroAssuree = cabinetInfo.NumeroAssuree,
                CodeEtablissement = cabinetInfo.CodeEtablissement,
                MatriculeFiscal = cabinetInfo.MatriculeFiscal,
                NomEtablissement = cabinetInfo.NomEtablissement
            };
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task SaveCabinetInfoAsync()
    {
        errorMessage = null;
        cabinetMessage = null;
        try
        {
            var response = await Http.PutAsJsonAsync("api/cabinetinfo", cabinetInfoForm);
            if (response.IsSuccessStatusCode)
            {
                cabinetMessage = "Données du cabinet enregistrées.";
                await LoadCabinetInfo();
            }
            else
            {
                errorMessage = "Impossible d'enregistrer les données du cabinet.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private List<UserDto> FilteredUsers()
    {
        if (string.IsNullOrWhiteSpace(searchKeyword))
        {
            return users;
        }

        var keyword = searchKeyword.Trim().ToLowerInvariant();
        return users.Where(u =>
            (u.FullName ?? string.Empty).ToLowerInvariant().Contains(keyword) ||
            u.Username.ToLowerInvariant().Contains(keyword) ||
            u.Role.ToLowerInvariant().Contains(keyword)
        ).ToList();
    }

    private void ShowCreateUser()
    {
        selectedUser = null;
        userForm = new UserDto { Role = "kine", Active = true, CabinetId = cabinets.FirstOrDefault()?.Id };
        userPassword = string.Empty;
        showForm = true;
    }

    private void EditUser(UserDto user)
    {
        selectedUser = user;
        userForm = new UserDto
        {
            Id = user.Id,
            Username = user.Username,
            FullName = user.FullName,
            Role = user.Role,
            Active = user.Active,
            CabinetId = user.CabinetId
        };
        userPassword = string.Empty;
        showForm = true;
    }

    private void HideForm()
    {
        showForm = false;
        selectedUser = null;
        userForm = new UserDto { Role = "kine", Active = true };
    }

    private async Task SaveUserAsync()
    {
        errorMessage = null;
        try
        {
            if (selectedUser == null || selectedUser.Id == 0)
            {
                var createRequest = new UserCreateRequestDto
                {
                    Username = userForm.Username,
                    FullName = userForm.FullName,
                    Role = userForm.Role,
                    Active = userForm.Active,
                    CabinetId = userForm.CabinetId,
                    Password = userPassword
                };

                var response = await Http.PostAsJsonAsync("api/users", createRequest);
                if (response.IsSuccessStatusCode)
                {
                    await LoadUsers();
                    HideForm();
                }
                else
                {
                    errorMessage = "Impossible de créer le praticien.";
                }
            }
            else
            {
                var updateRequest = new UserUpdateRequestDto
                {
                    Id = selectedUser.Id,
                    Username = userForm.Username,
                    FullName = userForm.FullName,
                    Role = userForm.Role,
                    Active = userForm.Active,
                    CabinetId = userForm.CabinetId,
                    Password = string.IsNullOrWhiteSpace(userPassword) ? null : userPassword
                };

                var response = await Http.PutAsJsonAsync($"api/users/{selectedUser.Id}", updateRequest);
                if (response.IsSuccessStatusCode)
                {
                    await LoadUsers();
                    HideForm();
                }
                else
                {
                    errorMessage = "Impossible de mettre à jour le praticien.";
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task DeleteUser(int userId)
    {
        errorMessage = null;
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Supprimer ce praticien ?"))
        {
            return;
        }

        var response = await Http.DeleteAsync($"api/users/{userId}");
        if (response.IsSuccessStatusCode)
        {
            await LoadUsers();
        }
        else
        {
            errorMessage = "Impossible de supprimer le praticien.";
        }
    }
}
