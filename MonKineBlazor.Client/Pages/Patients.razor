@page "/patients"
@using MonKineBlazor.Shared.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<h1>Patients</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row mb-4">
    <div class="col-md-12 d-flex gap-2">
        <button class="btn btn-primary" @onclick="LoadPatients">Rafraîchir</button>
        <button class="btn btn-secondary" @onclick="CreateNewPatient">Nouveau patient</button>
    </div>
</div>

@if (patients is null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <div class="row">
        <div class="col-md-5">
            <div class="card mb-4">
                <div class="card-header">Liste des patients</div>
                <div class="card-body">
                    <div class="mb-3">
                        <InputText class="form-control" placeholder="Rechercher patient par code, nom, prénom ou dossier" @bind-Value="patientFilter" />
                    </div>
                </div>
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th style="width: 80px">Fiche</th>
                                <th>Code</th>
                                <th>Nom</th>
                                <th>Prénom</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var patient in filteredPatients)
                            {
                                <tr class="@(selectedPatient?.Id == patient.Id ? "table-active" : string.Empty)">
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" @onclick="@(async () => await ShowPatientDetails(patient))">Fiche</button>
                                    </td>
                                    <td @onclick="() => SelectPatient(patient)">@patient.CodePatient</td>
                                    <td @onclick="() => SelectPatient(patient)">@patient.Nom</td>
                                    <td @onclick="() => SelectPatient(patient)">@patient.Prenom</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (!filteredPatients.Any())
                    {
                        <div class="p-3 text-muted">Aucun patient ne correspond à la recherche.</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-7">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>@(patientForm.Id == 0 ? "Créer un patient" : "Modifier un patient")</span>
                    @if (patientForm.Id != 0)
                    {
                        <button class="btn btn-outline-secondary btn-sm" @onclick="CreateNewPatient">Nouveau</button>
                    }
                </div>
                <div class="card-body">
                    <EditForm Model="patientForm" OnValidSubmit="SavePatientAsync">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Code patient</label>
                                <InputText class="form-control" @bind-Value="patientForm.CodePatient" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Numéro dossier</label>
                                <InputText class="form-control" @bind-Value="patientForm.DossierPatient" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Nom</label>
                                <InputText class="form-control" @bind-Value="patientForm.Nom" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Prénom</label>
                                <InputText class="form-control" @bind-Value="patientForm.Prenom" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Date de naissance</label>
                                <InputDate class="form-control" @bind-Value="patientForm.DateNaissance" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Sexe</label>
                                <InputSelect class="form-select" @bind-Value="patientForm.Sexe">
                                    <option value="">-- Sélectionnez --</option>
                                    <option value="Homme">Homme</option>
                                    <option value="Femme">Femme</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Téléphone 1</label>
                                <InputText class="form-control" @bind-Value="patientForm.Telephone1" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Téléphone 2</label>
                                <InputText class="form-control" @bind-Value="patientForm.Telephone2" />
                            </div>
                            <div class="col-md-12">
                                <label class="form-label">Adresse</label>
                                <InputText class="form-control" @bind-Value="patientForm.Adresse" />
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mt-4">
                                    <InputCheckbox class="form-check-input" @bind-Value="isCnam" />
                                    <label class="form-check-label">Patient CNAM</label>
                                </div>
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <button class="btn btn-success w-100" type="submit">Enregistrer</button>
                            </div>
                            @if (isCnam)
                            {
                                <div class="col-md-12">
                                    <div class="card card-body mb-3">
                                        <h5>Informations CNAM</h5>
                                        <div class="row g-3">
                                            <div class="col-md-3">
                                                <label class="form-label">Racine</label>
                                                <InputText class="form-control" @bind-Value="patientForm.Racine" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Clé</label>
                                                <InputText class="form-control" @bind-Value="patientForm.Cle" />
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Qualité</label>
                                                <InputSelect class="form-select" @bind-Value="patientForm.Qualite">
                                                    <option value="">-- Sélectionnez --</option>
                                                    <option value="Assuré lui-même">Assuré lui-même</option>
                                                    <option value="Conjoint">Conjoint</option>
                                                    <option value="Mère">Mère</option>
                                                    <option value="Père">Père</option>
                                                </InputSelect>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">N° assurée</label>
                                                @if (isCnam)
                                                {
                                                    <input class="form-control" value="@ComputedNumeroAssuree" readonly />
                                                }
                                                else
                                                {
                                                    <InputText class="form-control" @bind-Value="patientForm.NumeroAssuree" />
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </EditForm>
                </div>
            </div>

            @if (selectedPatient != null)
            {
                <div class="card mb-4">
                    <div class="card-header">Programmes du patient</div>
                    <div class="card-body p-0">
                        @if (!string.IsNullOrEmpty(statusMessage))
                        {
                            <div class="alert alert-info m-3">@statusMessage</div>
                        }
                        @if (programs is null)
                        {
                            <div class="p-3">Chargement des programmes...</div>
                        }
                        else if (!programs.Any())
                        {
                            <div class="p-3">Aucun programme trouvé.</div>
                        }
                        else
                        {
                            <table class="table table-sm table-striped mb-0">
                                <thead>
                                    <tr>
                                        <th>Titre</th>
                                        <th>Nature</th>
                                        <th>Nb séances</th>
                                        <th>Durée</th>
                                        <th>Date début</th>
                                        <th>Statut</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var program in programs)
                                    {
                                        <tr>
                                            <td>@program.Titre</td>
                                            <td>@program.NatureSeances</td>
                                            <td>@program.NbSeances</td>
                                            <td>@program.DureeSeanceMinutes</td>
                                            <td>@(program.DateDebut.HasValue ? program.DateDebut.Value.ToString("dd/MM/yyyy") : string.Empty)</td>
                                            <td>@program.Statut</td>
                                            <td class="text-end">
                                                <button class="btn btn-sm btn-outline-success me-2" @onclick="() => GenerateProgramInvoice(program)">Facture</button>
                                                <button class="btn btn-sm btn-outline-secondary me-2" @onclick="() => ExportSignatureSheet(program)">Feuille signature</button>
                                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => EditProgram(program)">Modifier</button>
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteProgram(program.Id)">Supprimer</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>

                @if (showPatientDetails)
                {
                    <div class="modal fade show d-block" style="background-color: rgba(0,0,0,0.5);">
                        <div class="modal-dialog modal-xl modal-dialog-centered" role="document">
                            <div class="modal-content" id="patientDetailsPrintArea">
                                <div class="modal-header">
                                    <h5 class="modal-title">Fiche patient</h5>
                                    <button type="button" class="btn-close" aria-label="Close" @onclick="ClosePatientDetails"></button>
                                </div>
                                <div class="modal-body">
                                    <div class="row mb-3">
                                        <div class="col-md-4"><strong>Code :</strong> @selectedPatient.CodePatient</div>
                                        <div class="col-md-4"><strong>Nom :</strong> @selectedPatient.Nom</div>
                                        <div class="col-md-4"><strong>Prénom :</strong> @selectedPatient.Prenom</div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-md-3"><strong>Age :</strong> @selectedPatient.Age</div>
                                        <div class="col-md-3"><strong>Couverture :</strong> @selectedPatient.Couverture</div>
                                        <div class="col-md-3"><strong>N° assurée :</strong> @selectedPatient.NumeroAssuree</div>
                                        <div class="col-md-3"><strong>Téléphone :</strong> @selectedPatient.Telephone1</div>
                                    </div>
                                    <div class="row mb-3">
                                        <div class="col-md-12"><strong>Adresse :</strong> @selectedPatient.Adresse</div>
                                    </div>

                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="card mb-3">
                                                <div class="card-header">État financier</div>
                                                <div class="card-body">
                                                    @if (financialSummary is null)
                                                    {
                                                        <div>Chargement...</div>
                                                    }
                                                    else
                                                    {
                                                        <div><strong>Total dû :</strong> @($"{financialSummary.TotalAmountDue:F2} DT")</div>
                                                        <div><strong>Total payé :</strong> @($"{financialSummary.TotalPaid:F2} DT")</div>
                                                        <div><strong>Restant :</strong> @($"{financialSummary.OutstandingAmount:F2} DT")</div>
                                                        <div><strong>Avance disponible :</strong> @(patientFinanceDetails is null ? "..." : $"{patientFinanceDetails.AdvanceBalance:F2} DT")</div>
                                                        <div><strong>Avance payée :</strong> @(patientFinanceDetails is null ? "..." : $"{patientFinanceDetails.TotalAdvancePaid:F2} DT")</div>
                                                        <div><strong>Avance utilisée :</strong> @(patientFinanceDetails is null ? "..." : $"{GetPatientUsedAdvanceAmount():F2} DT")</div>
                                                        <div><strong>Reste après avance :</strong> @($"{financialSummary.OutstandingAfterAdvance:F2} DT")</div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="card mb-3">
                                                <div class="card-header">Rendez-vous programmés</div>
                                                <div class="card-body p-0">
                                                    @if (patientAppointments is null)
                                                    {
                                                        <div class="p-3">Chargement...</div>
                                                    }
                                                    else if (!patientAppointments.Any())
                                                    {
                                                        <div class="p-3">Aucun rendez-vous trouvé.</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="table-responsive">
                                                            <table class="table table-sm table-striped mb-0">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Date</th>
                                                                        <th>Acte</th>
                                                                        <th>Statut</th>
                                                                        <th>Paiement</th>
                                                                        <th class="text-end">Montant</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var appointment in patientAppointments)
                                                                    {
                                                                        <tr>
                                                                            <td>@(appointment.Start?.ToString("dd/MM/yyyy HH:mm") ?? "")</td>
                                                                            <td>@appointment.Acte</td>
                                                                            <td>@appointment.Status</td>
                                                                            <td>@appointment.PaymentStatus</td>
                                                                            <td class="text-end">@($"{appointment.Amount:F2} DT")</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                            <div class="card mb-3">
                                                <div class="card-header">Avances patient</div>
                                                <div class="card-body">
                                                    @if (patientFinanceDetails is null)
                                                    {
                                                        <div>Chargement du solde avancé...</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="mb-3">
                                                            <div><strong>Total avances reçues :</strong> @($"{patientAdvanceTransactions?.Sum(a => a.Amount) ?? 0m:F2} DT")</div>
                                                            <div><strong>Avance disponible :</strong> @($"{patientFinanceDetails.AdvanceBalance:F2} DT")</div>
                                                            <div><strong>Avance payée :</strong> @($"{patientFinanceDetails.TotalAdvancePaid:F2} DT")</div>
                                                            <div><strong>Avance utilisée :</strong> @($"{GetPatientUsedAdvanceAmount():F2} DT")</div>
                                                        </div>
                                                    }
                                                    @if (patientAdvanceTransactions is null)
                                                    {
                                                        <div class="p-3">Chargement...</div>
                                                    }
                                                    else if (!patientAdvanceTransactions.Any())
                                                    {
                                                        <div class="p-3">Aucune avance enregistrée.</div>
                                                    }
                                                    else
                                                    {
                                                        <div class="table-responsive">
                                                            <table class="table table-sm table-striped mb-0">
                                                                <thead>
                                                                    <tr>
                                                                        <th>Date</th>
                                                                        <th>Montant</th>
                                                                        <th>Note</th>
                                                                        <th>Par</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var advance in patientAdvanceTransactions)
                                                                    {
                                                                        <tr>
                                                                            <td>@advance.TransactionDate.ToString("yyyy-MM-dd HH:mm")</td>
                                                                            <td class="text-end">@($"{advance.Amount:F2} DT")</td>
                                                                            <td>@advance.Note</td>
                                                                            <td>@advance.CreatedBy</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button class="btn btn-secondary" @onclick="ClosePatientDetails">Fermer</button>
                                    <button class="btn btn-primary" @onclick="PrintPatientDetails">Imprimer</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                <div class="card">
                    <div class="card-header">@(isEditingProgram ? "Modifier le programme" : "Ajouter un programme")</div>
                    <div class="card-body">
                        <EditForm Model="newProgram" OnValidSubmit="SaveProgramAsync">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Titre</label>
                                    <InputText class="form-control" @bind-Value="newProgram.Titre" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Type</label>
                                    <InputSelect class="form-select" @bind-Value="newProgram.TypeProgramme">
                                        <option value="">-- Sélectionnez --</option>
                                        @foreach (var typeOption in GetProgramTypeOptions())
                                        {
                                            <option value="@typeOption">@typeOption</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Nature</label>
                                    <InputSelect class="form-select" @bind-Value="newProgram.NatureSeances">
                                        <option value="">-- Sélectionnez --</option>
                                        @foreach (var natureOption in GetNatureSeancesOptions())
                                        {
                                            <option value="@natureOption">@natureOption</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Nb séances</label>
                                    <InputNumber class="form-control" @bind-Value="newProgram.NbSeances" @onchange="_ => RecalculateProgram()" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label">Séances / semaine</label>
                                    <InputSelect class="form-select" @bind-Value="newProgram.NbSeancesParSemaine" @onchange="_ => RecalculateProgram()">
                                        @for (int i = 1; i <= 6; i++)
                                        {
                                            <option value="@i">@i</option>
                                        }
                                    </InputSelect>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Durée (min)</label>
                                    <InputNumber class="form-control" @bind-Value="newProgram.DureeSeanceMinutes" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Date début</label>
                                    <InputDate class="form-control" @bind-Value="newProgram.DateDebut" @onchange="_ => RecalculateProgram()" />
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label">Date fin</label>
                                    <InputDate class="form-control" @bind-Value="newProgram.DateFin" disabled />
                                </div>
                                @if (isCnam)
                                {
                                    <div class="col-md-3">
                                        <label class="form-label">Code bureau</label>
                                        <InputText class="form-control" @bind-Value="newProgram.CodeBureau" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Année</label>
                                        <InputText class="form-control" @bind-Value="newProgram.Annee" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">N° décision</label>
                                        <InputText class="form-control" @bind-Value="newProgram.NumeroDecision" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Prix Unitaire</label>
                                        <InputNumber class="form-control" @bind-Value="newProgram.PrixUnitaire" disabled />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label">Prix HT</label>
                                        <InputNumber class="form-control" @bind-Value="newProgram.PrixHT" disabled />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">TVA (%)</label>
                                        <InputNumber class="form-control" @bind-Value="newProgram.TVA" @onchange="_ => RecalculateProgram()" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Montant TVA</label>
                                        <InputNumber class="form-control" @bind-Value="newProgram.MontantTVA" disabled />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Prix TTC</label>
                                        <InputNumber class="form-control" @bind-Value="newProgram.PrixTTC" step="0.001" @onchange="_ => RecalculateProgram()" />
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">Prix séance TTC</label>
                                        <InputNumber class="form-control" @bind-Value="newProgram.PrixSeanceTTC" step="0.001" @onchange="_ => RecalculateProgram()" />
                                    </div>
                                }
                                <div class="col-md-3">
                                    <label class="form-label">Prix Espèce</label>
                                    <InputNumber class="form-control" @bind-Value="newProgram.PrixEspece" step="0.001" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">Objectifs</label>
                                    <InputText class="form-control" @bind-Value="newProgram.Objectifs" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label">Remarques</label>
                                    <InputText class="form-control" @bind-Value="newProgram.Remarques" />
                                </div>
                                <div class="col-md-12 d-flex gap-2">
                                    <button class="btn btn-success" type="submit">@(isEditingProgram ? "Enregistrer les modifications" : "Ajouter le programme")</button>
                                    <button class="btn btn-outline-secondary" type="button" @onclick="ResetProgramForm">Réinitialiser</button>
                                    @if (isEditingProgram)
                                    {
                                        <button class="btn btn-outline-secondary" type="button" @onclick="CancelProgramEdit">Annuler</button>
                                    }
                                </div>
                            </div>
                        </EditForm>
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    private string patientFilter = string.Empty;
    private List<PatientDto>? patients;
    private List<PatientDto> filteredPatients => string.IsNullOrWhiteSpace(patientFilter)
        ? patients ?? new List<PatientDto>()
        : (patients ?? new List<PatientDto>()).Where(p =>
            (!string.IsNullOrWhiteSpace(p.CodePatient) && p.CodePatient.Contains(patientFilter, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(p.Nom) && p.Nom.Contains(patientFilter, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(p.Prenom) && p.Prenom.Contains(patientFilter, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrWhiteSpace(p.DossierPatient) && p.DossierPatient.Contains(patientFilter, StringComparison.OrdinalIgnoreCase))
        ).ToList();
    private List<PatientProgramDto>? programs;
    private PatientDto? selectedPatient;
    private PatientFinancialSummaryDto? financialSummary;
    private PatientFinanceDto? patientFinanceDetails;
    private List<AppointmentDto>? patientAppointments;
    private List<AdvanceTransactionDto>? patientAdvanceTransactions;
    private bool showPatientDetails;
    private PatientDto patientForm = new();
    private CabinetDto cabinetInfo = new();
    private bool _isCnam;
    private bool isCnam
    {
        get => _isCnam;
        set
        {
            _isCnam = value;
            if (patientForm != null)
            {
                patientForm.Couverture = _isCnam ? "CNAM" : "Civil payant";
            }

            if (!_isCnam)
            {
                patientForm.Racine = null;
                patientForm.Cle = null;
                patientForm.Qualite = null;
                patientForm.NumeroAssuree = null;
            }
        }
    }
    private PatientProgramDto newProgram = new()
    {
        DateDebut = DateTime.Now,
        Statut = "planifie",
        NbSeances = 1,
        NbSeancesParSemaine = 1,
        DureeSeanceMinutes = 30,
        TVA = 7,
        PrixUnitaire = 0,
        PrixEspece = 0,
        PrixHT = 0,
        MontantTVA = 0,
        PrixTTC = 0,
    };

    private class SignatureSessionRow
    {
        public int Sequence { get; set; }
        public string Date { get; set; } = string.Empty;
        public string SignaturePatient { get; set; } = string.Empty;
        public string SignatureKine { get; set; } = string.Empty;
    }

    private async Task ExportSignatureSheet(PatientProgramDto program)
    {
        errorMessage = null;
        statusMessage = null;

        if (selectedPatient == null)
        {
            errorMessage = "Sélectionnez d'abord un patient.";
            return;
        }

        if (patientAppointments == null)
        {
            await LoadPatientAppointments();
        }

        var rows = BuildSignatureRows(program);
        var payload = new
        {
            cabinet = cabinetInfo,
            program,
            patient = selectedPatient,
            rows
        };

        try
        {
            await JSRuntime.InvokeVoidAsync("generateSignatureSheetPdf", $"FeuilleSignature_{program.Id}_{selectedPatient.CodePatient}.pdf", payload);
        }
        catch (JSException jsEx)
        {
            errorMessage = "Erreur lors de l'export de la feuille de signature : " + jsEx.Message;
            Console.Error.WriteLine(jsEx);
        }
        catch (Exception ex)
        {
            errorMessage = "Erreur inattendue lors de l'export de la feuille de signature : " + ex.Message;
            Console.Error.WriteLine(ex);
        }
    }

    private List<SignatureSessionRow> BuildSignatureRows(PatientProgramDto program)
    {
        var rows = new List<SignatureSessionRow>();
        if (program.NbSeances <= 0)
        {
            return rows;
        }

        var appointmentDates = (patientAppointments ?? new List<AppointmentDto>())
            .Where(a => a.Start.HasValue)
            .Where(a =>
                (!program.DateDebut.HasValue || a.Start.Value.Date >= program.DateDebut.Value.Date) &&
                (!program.DateFin.HasValue || a.Start.Value.Date <= program.DateFin.Value.Date))
            .OrderBy(a => a.Start)
            .Select(a => a.Start.Value.Date)
            .Distinct()
            .ToList();

        for (var sequence = 1; sequence <= program.NbSeances; sequence++)
        {
            rows.Add(new SignatureSessionRow
            {
                Sequence = sequence,
                Date = sequence <= appointmentDates.Count ? appointmentDates[sequence - 1].ToString("dd/MM/yyyy") : string.Empty
            });
        }

        return rows;
    }

