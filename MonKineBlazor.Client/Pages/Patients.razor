    private async Task LoadCabinetOptions(int? cabinetId)
    {
        if (!cabinetId.HasValue)
        {
            cabinetProgramTypeOptions = DefaultProgramTypeOptions;
            cabinetNatureSeancesOptions = DefaultNatureSeancesOptions;
            cabinetInfo = new CabinetDto();
            return;
        }

        try
        {
            var cabinet = await Http.GetFromJsonAsync<CabinetDto>($"api/cabinets/{cabinetId.Value}");
            cabinetProgramTypeOptions = ParseOptions(cabinet?.ProgrammeTypeOptions, DefaultProgramTypeOptions);
            cabinetNatureSeancesOptions = ParseOptions(cabinet?.NatureSeancesOptions, DefaultNatureSeancesOptions);
            cabinetInfo = cabinet ?? new CabinetDto();
            if (!isEditingProgram && cabinetInfo != null)
            {
                newProgram.PrixSeanceTTC = cabinetInfo.PrixSeanceTTC;
                RecalculateProgram();
            }
        }
        catch
        {
            cabinetProgramTypeOptions = DefaultProgramTypeOptions;
            cabinetNatureSeancesOptions = DefaultNatureSeancesOptions;
            cabinetInfo = new CabinetDto();
        }
    }

    private IEnumerable<string> GetProgramTypeOptions() => cabinetProgramTypeOptions ?? DefaultProgramTypeOptions;
    private IEnumerable<string> GetNatureSeancesOptions() => cabinetNatureSeancesOptions ?? DefaultNatureSeancesOptions;

    private static string[] ParseOptions(string? options, string[] defaults)
    {
        if (string.IsNullOrWhiteSpace(options))
        {
            return defaults;
        }

        var parsed = options
            .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(o => o.Trim())
            .Where(o => !string.IsNullOrWhiteSpace(o))
            .ToArray();

        return parsed.Length > 0 ? parsed : defaults;
    }

