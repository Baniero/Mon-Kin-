            return;
        }

        var addResponse = await Http.PostAsJsonAsync("api/patientprograms", newProgram);
        if (addResponse.IsSuccessStatusCode)
        {
            await LoadPrograms();
            ResetProgramForm();
            statusMessage = "Programme ajouté avec succès.";
