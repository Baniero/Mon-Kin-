            return;
        }

        RecalculateProgram();
        newProgram.PatientId = selectedPatient.Id;

        if (isEditingProgram && editingProgram != null)
        {
            var response = await Http.PutAsJsonAsync($"api/patientprograms/{editingProgram.Id}", newProgram);
            if (response.IsSuccessStatusCode)
            {
                await LoadPrograms();
                ResetProgramForm();
                statusMessage = "Programme mis à jour avec succès.";
