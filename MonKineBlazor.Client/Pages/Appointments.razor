@page "/appointments"
@attribute [ModuleAccess("appointments")]
@using MonKineBlazor.Shared.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<h1>Rendez-vous</h1>

<div class="btn-group mb-4" role="group">
    <button class="btn @(activeSubmodule == AppointmentSubmodule.ProgramPlanning ? "btn-primary" : "btn-outline-secondary")" @onclick="async () => await SetSubmodule(AppointmentSubmodule.ProgramPlanning)">Planification par programme</button>
    <button class="btn @(activeSubmodule == AppointmentSubmodule.NewAppointment ? "btn-primary" : "btn-outline-secondary")" @onclick="async () => await SetSubmodule(AppointmentSubmodule.NewAppointment)">Nouveau rendez-vous</button>
    <button class="btn @(activeSubmodule == AppointmentSubmodule.Today ? "btn-primary" : "btn-outline-secondary")" @onclick="async () => await SetSubmodule(AppointmentSubmodule.Today)">Rendez-vous du jour</button>
    <button class="btn @(activeSubmodule == AppointmentSubmodule.Weekly ? "btn-primary" : "btn-outline-secondary")" @onclick="async () => await SetSubmodule(AppointmentSubmodule.Weekly)">Planning hebdo</button>
    <button class="btn @(activeSubmodule == AppointmentSubmodule.List ? "btn-primary" : "btn-outline-secondary")" @onclick="async () => await SetSubmodule(AppointmentSubmodule.List)">Liste</button>
    <button class="btn @(activeSubmodule == AppointmentSubmodule.Canceled ? "btn-primary" : "btn-outline-secondary")" @onclick="async () => await SetSubmodule(AppointmentSubmodule.Canceled)">RDV annulé</button>
</div>

<div class="row mb-3">
    <div class="col-md-4">
        <label class="form-label">Rechercher</label>
        <InputText class="form-control" @bind-Value="appointmentSearch" placeholder="Patient, Acte, Salle" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Filtrer par kiné</label>
        <InputSelect class="form-select" @bind-Value="selectedKineFilter">
            <option value="0">Tous</option>
            @foreach (var kine in kines)
            {
                <option value="@kine.Id">@((kine.FullName ?? kine.Username))</option>
            }
        </InputSelect>
    </div>
    <div class="col-md-3">
        <label class="form-label">Filtrer par statut</label>
        <InputSelect class="form-select" @bind-Value="appointmentStatusFilter">
            <option value="">Tous</option>
            <option value="planifie">planifie</option>
            <option value="present">present</option>
            <option value="termine">termine</option>
            <option value="absent">absent</option>
        </InputSelect>
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button class="btn btn-secondary w-100" @onclick="LoadAppointments">Rafraîchir</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
        <div class="toast show align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">
                    @successMessage
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" aria-label="Close" @onclick="DismissSuccessMessage"></button>
            </div>
        </div>
    </div>
}

@if (activeSubmodule == AppointmentSubmodule.ProgramPlanning)
{
    <div class="row">
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">Patients / Programmes</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Patient</label>
                        <div class="input-group">
                            <InputSelect class="form-select" @bind-Value="selectedProgramPatientId" @onchange="OnProgramPatientChanged">
                                <option value="0">-- Sélectionnez --</option>
                                @foreach (var patient in patients)
                                {
                                    <option value="@patient.Id">@patient.Nom @patient.Prenom</option>
                                }
                            </InputSelect>
                            <button class="btn btn-outline-primary" type="button" @onclick="LoadProgramsForSelectedPatient">Charger</button>
                        </div>
                    </div>
                    @if (selectedProgramPatient != null)
                    {
                        <div class="alert alert-info mb-3">
                            <strong>@selectedProgramPatient.Nom @selectedProgramPatient.Prenom</strong><br />
                            @selectedProgramPatient.Couverture
                        </div>
                    }
                    @if (isLoadingPrograms)
                    {
                        <div class="alert alert-info">Chargement des programmes...</div>
                    }
                    else if (!string.IsNullOrEmpty(programLoadError))
                    {
                        <div class="alert alert-danger">@programLoadError</div>
                    }
                    else if (!string.IsNullOrEmpty(programInfoMessage))
                    {
                        <div class="alert alert-info">@programInfoMessage</div>
                    }
                    else if (selectedProgramPatient != null && patientPrograms.Any())
                    {
                        <div class="list-group">
                            @foreach (var program in patientPrograms)
                            {
                                <button class="list-group-item list-group-item-action @(selectedProgram?.Id == program.Id ? "active" : "")" @onclick="() => SelectProgram(program)">
                                    <div class="d-flex justify-content-between">
                                        <div>
                                            <strong>@program.Titre</strong><br />
                                            <small>@program.NatureSeances</small>
                                        </div>
                                        <div class="text-end">
                                            <span>@program.NbSeances séances</span><br />
                                            <span>@program.NbSeancesParSemaine / semaine</span>
                                        </div>
                                    </div>
                                </button>
                            }
                        </div>
                    }
                    else if (selectedProgramPatient != null)
                    {
                        <div class="alert alert-warning">Aucun programme trouvé pour ce patient.</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-8">
            @if (selectedProgram != null)
            {
                <div class="card mb-4">
                    <div class="card-header">Planification du programme</div>
                    <div class="card-body">
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Date de début</label>
                                <InputDate class="form-control" @bind-Value="programStartDate" @onchange="_ => RefreshProgramPreview()" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Heure de début</label>
                                <InputText class="form-control" @bind-Value="programStartTime" @onchange="_ => RefreshProgramPreview()" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Salle</label>
                                <InputText class="form-control" @bind-Value="programRoom" />
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Kiné</label>
                                <InputSelect class="form-select" @bind-Value="programSelectedKineId">
                                    <option value="0">-- Non défini --</option>
                                    @foreach (var kine in kines)
                                    {
                                        <option value="@kine.Id">@((kine.FullName ?? kine.Username))</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Jours de séances</label>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var day in Enum.GetValues<DayOfWeek>())
                                {
                                    var selected = selectedProgramWeekDays.Contains(day);
                                    <button type="button" class="btn btn-sm @(selected ? "btn-primary" : "btn-outline-secondary")" @onclick="() => ToggleProgramWeekDay(day)">@GetDayLabel(day)</button>
                                }
                            </div>
                            <div class="small text-muted mt-2">Sélectionnez jusqu'à @((selectedProgram?.NbSeancesParSemaine ?? 1)) jours par semaine.</div>
                        </div>
                        <div class="mb-3">
                            <strong>Programme :</strong> @selectedProgram.Titre<br />
                            <strong>Durée séance :</strong> @selectedProgram.DureeSeanceMinutes min<br />
                            @if (selectedProgramPatient != null && string.IsNullOrWhiteSpace(selectedProgramPatient.Couverture))
                            {
                                <strong>Prix espèces :</strong> @($"{selectedProgram.PrixEspece:F2} DT")<br />
                                <strong>Montant total du programme :</strong> @($"{selectedProgram.NbSeances * selectedProgram.PrixEspece:F2} DT")<br />
                                <strong>Montant à payer par séance :</strong> @($"{DetermineSessionAmount(selectedProgram, selectedProgramPatient):F2} DT")
                            }
                            else
                            {
                                <strong>Prix unitaire CNAM :</strong> @($"{selectedProgram.PrixUnitaire:F2} DT")<br />
                                <strong>Prix espèces :</strong> @($"{selectedProgram.PrixEspece:F2} DT")<br />
                                <strong>Montant à payer par séance :</strong> @($"{DetermineSessionAmount(selectedProgram, selectedProgramPatient):F2} DT")
                            }
                        </div>
                        <div class="table-responsive mb-3">
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Date</th>
                                        <th>Heure</th>
                                        <th>Durée</th>
                                        <th>Kiné</th>
                                        <th>Salle</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < programPreview.Count; i++)
                                    {
                                        var appointment = programPreview[i];
                                        <tr>
                                            <td>@(i + 1)</td>
                                            <td>@appointment.Start?.ToString("yyyy-MM-dd")</td>
                                            <td>@appointment.Start?.ToString("HH:mm")</td>
                                            <td>@((appointment.End - appointment.Start)?.TotalMinutes ?? 0) min</td>
                                            <td>@(appointment.KineId.HasValue ? kines.FirstOrDefault(k => k.Id == appointment.KineId)?.FullName ?? kines.FirstOrDefault(k => k.Id == appointment.KineId)?.Username : "-")</td>
                                            <td>@appointment.Room</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-primary" @onclick="StartProgram" disabled="@(selectedProgram == null)">Démarrer ce programme</button>
                            <button class="btn btn-success" @onclick="CreateProgramAppointments" disabled="@(programPreview.Count == 0)">Créer les rendez-vous</button>
                        </div>
                    </div>
                </div>
            }
            else if (selectedProgramPatient != null)
            {
                <div class="alert alert-secondary">Sélectionnez un programme pour générer les rendez-vous.</div>
            }
        </div>
    </div>
}

@if (activeSubmodule == AppointmentSubmodule.NewAppointment)
{
    <div class="card mb-4">
        <div class="card-header">Nouveau rendez-vous</div>
        <div class="card-body">
            <div class="mb-3">
                <strong>Ce mode est destiné aux patients sans programme créé.</strong>
            </div>
            <EditForm Model="newAppointment" OnValidSubmit="CreateAppointmentAsync">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Patient</label>
                        <InputSelect class="form-select" @bind-Value="newAppointment.PatientId" @onchange="OnNewAppointmentPatientChanged">
                            <option value="">-- Sélectionnez --</option>
                            @foreach (var patient in patients)
                            {
                                <option value="@patient.Id">@patient.Nom @patient.Prenom</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Kiné</label>
                        <InputSelect class="form-select" @bind-Value="newAppointment.KineId">
                            <option value="">-- Sélectionnez --</option>
                            @foreach (var kine in kines)
                            {
                                <option value="@kine.Id">@((kine.FullName ?? kine.Username))</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Date début</label>
                        <InputDate class="form-control" @bind-Value="newAppointment.Start" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Heure début</label>
                        <InputText class="form-control" @bind-Value="startTime" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Durée (min)</label>
                        <InputNumber class="form-control" @bind-Value="durationMinutes" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Acte</label>
                        <InputText class="form-control" @bind-Value="newAppointment.Acte" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Salle</label>
                        <InputText class="form-control" @bind-Value="newAppointment.Room" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Montant</label>
                        <InputNumber class="form-control" @bind-Value="newAppointment.Amount" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Part CNAM</label>
                        <InputNumber class="form-control" @bind-Value="newAppointment.CnamCovered" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Statut</label>
                        <InputSelect class="form-select" @bind-Value="newAppointment.Status">
                            <option value="planifie">planifie</option>
                            <option value="present">present</option>
                            <option value="termine">termine</option>
                            <option value="annule">annule</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Paiement</label>
                        <InputSelect class="form-select" @bind-Value="newAppointment.PaymentStatus">
                            <option value="non_paye">non_paye</option>
                            <option value="partiellement_paye">partiellement_paye</option>
                            <option value="paye">paye</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Notes</label>
                        <InputTextArea class="form-control" @bind-Value="newAppointment.Notes" Rows="3" />
                    </div>
                    <div class="col-md-12 d-flex gap-2">
                        <button class="btn btn-success" type="submit">@(isEditing ? "Mettre à jour" : "Enregistrer")</button>
                        <button class="btn btn-outline-secondary" type="button" @onclick="HideAddAppointment">Annuler</button>
                    </div>
                </div>
            </EditForm>
            @if (selectedNewPatientHasPrograms)
            {
                <div class="alert alert-warning mt-3">Ce patient a déjà un programme. Utilisez l’onglet "Planification par programme".</div>
            }
        </div>
    </div>
}

@if (activeSubmodule == AppointmentSubmodule.Today)
{
    <div class="card mb-4">
        <div class="card-header">Rendez-vous du jour</div>
        <div class="card-body">
            @if (!todayAppointments.Any())
            {
                <div class="alert alert-info">Aucun rendez-vous planifié pour aujourd'hui.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Heure</th>
                                <th>Patient</th>
                                <th>Kiné</th>
                                <th>Acte</th>
                                <th>Salle</th>
                                <th>Statut</th>
                                <th>Paiement</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in todayAppointments.OrderBy(a => a.Start))
                            {
                                <tr>
                                    <td>@appointment.Start?.ToString("HH:mm")</td>
                                    <td>@appointment.PatientName</td>
                                    <td>@appointment.KineName</td>
                                    <td>@appointment.Acte</td>
                                    <td>@appointment.Room</td>
                                    <td>@appointment.Status</td>
                                    <td>@appointment.PaymentStatus</td>
                                    <td>
                                        <button class="btn btn-sm btn-success me-1" @onclick="() => MarkAppointmentPresent(appointment)">Présent</button>
                                        <button class="btn btn-sm btn-danger me-1" @onclick="() => MarkAppointmentAbsent(appointment)">Absent</button>
                                        <button class="btn btn-sm btn-primary me-1" @onclick="() => OpenPaymentModal(appointment)">Paiement</button>
                                        <button class="btn btn-sm btn-warning" @onclick="() => MarkAppointmentUnpaid(appointment)">Non payé</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (activeSubmodule == AppointmentSubmodule.Weekly)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Planning hebdomadaire</span>
            <div>
                <button class="btn btn-outline-secondary btn-sm me-2" @onclick="PreviousWeek">Semaine précédente</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="NextWeek">Semaine suivante</button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered calendar-table">
                    <thead>
                        <tr>
                            @foreach (var day in GetWeekDays())
                            {
                                <th>@day.ToString("ddd dd/MM")</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            @foreach (var day in GetWeekDays())
                            {
                                <td>
                                    @foreach (var appt in FilteredAppointments().Where(a => a.Start.HasValue && a.Start.Value.Date == day.Date).OrderBy(a => a.Start))
                                    {
                                        <div class="mb-2 p-2 border rounded" style="cursor: pointer;" @ondblclick="() => EditAppointment(appt)">
                                            <strong>@appt.Start?.ToString("HH:mm")</strong><br />
                                            <span>@appt.PatientName</span><br />
                                            <span>@appt.KineName</span><br />
                                            <span>@appt.Status</span>
                                        </div>
                                    }
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (activeSubmodule == AppointmentSubmodule.Canceled)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>RDV annulé</span>
            <button class="btn btn-danger btn-sm" @onclick="BulkDeleteCanceledAppointments" disabled="@(canceledSelectedAppointmentIds.Count == 0)">Supp. définitive sélection</button>
        </div>
        <div class="card-body">
            @if (!CanceledAppointments.Any())
            {
                <div class="alert alert-info">Aucun rendez-vous annulé pour le moment.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Date début</th>
                                <th>Patient</th>
                                <th>Kiné</th>
                                <th>Acte</th>
                                <th>Salle</th>
                                <th>Montant</th>
                                <th>Statut</th>
                                <th>Paiement</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in CanceledAppointments)
                            {
                                <tr>
                                    <td>@appointment.Start</td>
                                    <td>@appointment.PatientName</td>
                                    <td>@appointment.KineName</td>
                                    <td>@appointment.Acte</td>
                                    <td>@appointment.Room</td>
                                    <td>@($"{appointment.Amount:F2} DT")</td>
                                    <td>@appointment.Status</td>
                                    <td>@appointment.PaymentStatus</td>
                                    <td>
                                        <button class="btn btn-sm btn-secondary me-2" @onclick="() => ReactivateAppointment(appointment)">Réactiver</button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => DeleteAppointment(appointment.Id)">Supp. définitive</button>
                                </td>
                                <td class="text-center">
                                    <input type="checkbox" checked="@canceledSelectedAppointmentIds.Contains(appointment.Id)" @onchange="() => ToggleCanceledAppointmentSelection(appointment.Id)" aria-label="Sélectionner ce rendez-vous" />
                                </td>
                            </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (showPaymentModal && paymentAppointment != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Paiement rendez-vous</h5>
                    <button type="button" class="btn-close" aria-label="Fermer" @onclick="ClosePaymentModal"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(paymentErrorMessage))
                    {
                        <div class="alert alert-danger">@paymentErrorMessage</div>
                    }
                    <div class="mb-3">
                        <strong>Patient :</strong> @paymentAppointment.PatientName<br />
                        <strong>Montant total :</strong> @($"{paymentAppointment.Amount:F2} DT")<br />
                        <strong>Montant déjà payé :</strong> @($"{paymentAppointment.PaidAmount:F2} DT")<br />
                        <strong>Montant restant attendu :</strong> @($"{GetAppointmentRemainingAmount(paymentAppointment):F2} DT")
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Montant apporté</label>
                        <InputNumber class="form-control" @bind-Value="paymentInputAmount" />
                    </div>
                    <div class="text-muted">Si le patient apporte plus que le montant attendu, le surplus sera enregistré comme avance.</div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="ClosePaymentModal">Annuler</button>
                    <button class="btn btn-primary" @onclick="ProcessAppointmentPayment">Valider le paiement</button>
                </div>
            </div>
        </div>
    </div>
}

@if (activeSubmodule == AppointmentSubmodule.List)
{
    <div class="mb-3 d-flex justify-content-between align-items-center">
        <div>
            <button class="btn btn-danger btn-sm" @onclick="BulkCancelSelectedAppointments" disabled="@(selectedAppointmentIds.Count == 0)">Supprimer la sélection</button>
            <span class="ms-2 text-muted">@selectedAppointmentIds.Count sélectionné(s)</span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th><button class="btn btn-link btn-sm p-0" type="button" @onclick="() => SetAppointmentSort(AppointmentSortColumn.Start)">Date début @GetSortIcon(AppointmentSortColumn.Start)</button></th>
                    <th><button class="btn btn-link btn-sm p-0" type="button" @onclick="() => SetAppointmentSort(AppointmentSortColumn.PatientName)">Patient @GetSortIcon(AppointmentSortColumn.PatientName)</button></th>
                    <th><button class="btn btn-link btn-sm p-0" type="button" @onclick="() => SetAppointmentSort(AppointmentSortColumn.KineName)">Kiné @GetSortIcon(AppointmentSortColumn.KineName)</button></th>
                    <th><button class="btn btn-link btn-sm p-0" type="button" @onclick="() => SetAppointmentSort(AppointmentSortColumn.Acte)">Acte @GetSortIcon(AppointmentSortColumn.Acte)</button></th>
                    <th><button class="btn btn-link btn-sm p-0" type="button" @onclick="() => SetAppointmentSort(AppointmentSortColumn.Room)">Salle @GetSortIcon(AppointmentSortColumn.Room)</button></th>
                    <th><button class="btn btn-link btn-sm p-0" type="button" @onclick="() => SetAppointmentSort(AppointmentSortColumn.Amount)">Montant @GetSortIcon(AppointmentSortColumn.Amount)</button></th>
                    <th><button class="btn btn-link btn-sm p-0" type="button" @onclick="() => SetAppointmentSort(AppointmentSortColumn.Status)">Statut @GetSortIcon(AppointmentSortColumn.Status)</button></th>
                    <th><button class="btn btn-link btn-sm p-0" type="button" @onclick="() => SetAppointmentSort(AppointmentSortColumn.PaymentStatus)">Paiement @GetSortIcon(AppointmentSortColumn.PaymentStatus)</button></th>
                    <th>Actions</th>
                    <th class="text-center"><input type="checkbox" @onchange="ToggleSelectAllCurrentPage" checked="@AreAllVisibleAppointmentsSelected()" aria-label="Sélectionner tout" /></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var appointment in FilteredAppointments())
                {
                    <tr>
                        <td>@appointment.Start</td>
                        <td>@appointment.PatientName</td>
                        <td>@appointment.KineName</td>
                        <td>@appointment.Acte</td>
                        <td>@appointment.Room</td>
                        <td>@($"{appointment.Amount:F2} DT")</td>
                        <td>@appointment.Status</td>
                        <td>@appointment.PaymentStatus</td>
                        <td>
                            <button class="btn btn-sm btn-primary me-2" @onclick="() => EditAppointment(appointment)">Modifier</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => CancelAppointment(appointment)">Supprimer</button>
                        </td>
                        <td class="text-center">
                            <input type="checkbox" checked="@selectedAppointmentIds.Contains(appointment.Id)" @onchange="() => ToggleAppointmentSelection(appointment.Id)" aria-label="Sélectionner ce rendez-vous" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private List<AppointmentDto>? appointments;
    private List<PatientDto> patients = new();
    private List<UserDto> kines = new();
    private AppointmentDto newAppointment = new()
    {
        Status = "planifie",
        PaymentStatus = "non_paye",
        Amount = 0,
        PaidAmount = 0,
        CnamCovered = 0,
        Start = DateTime.Today,
        End = DateTime.Today.AddHours(1)
    };
    private bool showAppointmentForm;
    private string startTime = "08:00";
    private int durationMinutes = 30;
    private string? errorMessage;
    private string? paymentErrorMessage;
    private bool showPaymentModal;
    private AppointmentDto? paymentAppointment;
    private decimal paymentInputAmount;
    private string appointmentSearch = string.Empty;
    private string appointmentStatusFilter = string.Empty;
    private int selectedKineFilter = 0;

    private AppointmentSubmodule activeSubmodule = AppointmentSubmodule.List;
    private HashSet<int> selectedAppointmentIds = new();
    private HashSet<int> canceledSelectedAppointmentIds = new();
    private AppointmentSortColumn appointmentSortColumn = AppointmentSortColumn.Start;
    private bool appointmentSortDescending;
    private static readonly HashSet<string> CanceledStatuses = new(StringComparer.OrdinalIgnoreCase)
    {
        "annule",
        "annulé",
        "annulee",
        "annulée",
        "annulé ",
        "annule " 
    };

    private int selectedProgramPatientId;
    private PatientDto? selectedProgramPatient;
    private List<PatientProgramDto> patientPrograms = new();
    private PatientProgramDto? selectedProgram;
    private DateTime programStartDate = DateTime.Today;
    private string programStartTime = "08:00";
    private string programRoom = "Salle 1";
    private int programSelectedKineId;
    private List<DayOfWeek> selectedProgramWeekDays = new();
    private List<AppointmentDto> programPreview = new();
    private bool isLoadingPrograms;
    private string? programLoadError;
    private string? programInfoMessage;
    private bool selectedNewPatientHasPrograms;

    private bool isEditing;
    private AppointmentDto? editingAppointment;
    private DateTime currentDate = DateTime.Today;
    private string? successMessage;
    private CancellationTokenSource? successMessageCts;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
        await LoadKines();
        await LoadAppointments();
    }

    private async Task LoadPatients()
    {
        patients = await Http.GetFromJsonAsync<List<PatientDto>>("api/patients") ?? new List<PatientDto>();
    }

    private async Task LoadKines()
    {
        kines = new List<UserDto>();
        try
        {
            var response = await Http.GetFromJsonAsync<List<UserDto>>("api/users/kines");
            if (response != null)
            {
                kines = response;
            }
        }
        catch { }
    }

    private async Task LoadAppointments()
    {
        errorMessage = null;
        try
        {
            appointments = await Http.GetFromJsonAsync<List<AppointmentDto>>("api/appointments");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            appointments = new List<AppointmentDto>();
        }
    }

    private async Task SetSubmodule(AppointmentSubmodule submodule)
    {
        activeSubmodule = submodule;
        showAppointmentForm = submodule == AppointmentSubmodule.NewAppointment;

        if (submodule == AppointmentSubmodule.ProgramPlanning && patients.Any())
        {
            if (selectedProgramPatientId == 0)
            {
                selectedProgramPatientId = patients[0].Id;
                selectedProgramPatient = patients[0];
            }

            await LoadProgramsForPatient(selectedProgramPatientId);
            if (patientPrograms.Any() && selectedProgram == null)
            {
                selectedProgram = patientPrograms[0];
                RefreshProgramPreview();
            }
        }
    }

    private void OnProgramPatientChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var patientId))
        {
            selectedProgramPatientId = patientId;
            selectedProgramPatient = patients.FirstOrDefault(p => p.Id == patientId);
            selectedProgram = null;
            patientPrograms.Clear();
            programPreview.Clear();
            programLoadError = null;
        }
        else
        {
            selectedProgramPatientId = 0;
            selectedProgramPatient = null;
            patientPrograms.Clear();
            selectedProgram = null;
            programPreview.Clear();
            programLoadError = null;
        }
    }

    private async Task LoadProgramsForPatient(int patientId)
    {
        var previousProgramId = selectedProgram?.Id;
        patientPrograms.Clear();
        selectedProgram = null;
        programPreview.Clear();
        programLoadError = null;

        if (patientId <= 0)
        {
            return;
        }

        isLoadingPrograms = true;
        try
        {
            patientPrograms = await Http.GetFromJsonAsync<List<PatientProgramDto>>($"api/patientprograms/patient/{patientId}") ?? new List<PatientProgramDto>();
            var excludedNonPlanifieCount = patientPrograms.Count(p => !string.Equals(p.Statut?.Trim(), "planifie", StringComparison.OrdinalIgnoreCase));
            patientPrograms = patientPrograms
                .Where(p => string.Equals(p.Statut?.Trim(), "planifie", StringComparison.OrdinalIgnoreCase))
                .ToList();
            if (excludedNonPlanifieCount > 0)
            {
                programInfoMessage = $"{excludedNonPlanifieCount} programme(s) non planifié(s) ont été exclus de la liste.";
            }
            ApplyProgramSchedulingFilter(patientId);
            if (previousProgramId.HasValue)
            {
                selectedProgram = patientPrograms.FirstOrDefault(p => p.Id == previousProgramId.Value);
            }
            if (selectedProgram == null && patientPrograms.Any())
            {
                selectedProgram = patientPrograms[0];
            }
            RefreshProgramPreview();
        }
        catch (Exception ex)
        {
            programLoadError = "Impossible de charger les programmes : " + ex.Message;
            patientPrograms = new List<PatientProgramDto>();
            programInfoMessage = null;
        }
        finally
        {
            isLoadingPrograms = false;
        }
    }

    private async Task LoadProgramsForSelectedPatient()
    {
        if (selectedProgramPatientId <= 0)
        {
            return;
        }

        selectedProgramPatient = patients.FirstOrDefault(p => p.Id == selectedProgramPatientId);
        await LoadProgramsForPatient(selectedProgramPatientId);
        if (patientPrograms.Any())
        {
            SelectProgram(patientPrograms[0]);
        }
    }

    private void SelectProgram(PatientProgramDto program)
    {
        selectedProgram = program;
        programStartDate = program.DateDebut ?? DateTime.Today;
        programStartTime = "08:00";
        programRoom = "Salle 1";
        programSelectedKineId = 0;
        selectedProgramWeekDays = GetDefaultWeekDays(program.NbSeancesParSemaine, programStartDate.DayOfWeek);
        RefreshProgramPreview();
    }

    private void ApplyProgramSchedulingFilter(int patientId)
    {
        if (appointments == null || !appointments.Any())
        {
            return;
        }

        var scheduledProgramTitles = appointments
            .Where(a => a.PatientId == patientId && !string.IsNullOrEmpty(a.Notes) && a.Notes.StartsWith("Programme ", StringComparison.OrdinalIgnoreCase))
            .Select(a => a.Notes.Substring("Programme ".Length).Trim())
            .Where(title => !string.IsNullOrEmpty(title))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (!scheduledProgramTitles.Any())
        {
            return;
        }

        var initialCount = patientPrograms.Count;
        patientPrograms = patientPrograms
            .Where(p => !scheduledProgramTitles.Contains(p.Titre ?? string.Empty, StringComparer.OrdinalIgnoreCase))
            .ToList();

        var hiddenCount = initialCount - patientPrograms.Count;
        if (hiddenCount > 0)
        {
            var prefix = string.IsNullOrWhiteSpace(programInfoMessage) ? string.Empty : programInfoMessage + " ";
            programInfoMessage = $"{prefix}{hiddenCount} programme(s) déjà planifié(s) ont été exclus de la liste.";
        }
    }

    private async Task StartProgram()
    {
        if (selectedProgram == null)
        {
            return;
        }

        if (selectedProgram.DateDebut.HasValue)
        {
            programStartDate = selectedProgram.DateDebut.Value.Date;
        }
        else
        {
            programStartDate = DateTime.Today;
        }

        programStartTime = "08:00";
        programRoom = "Salle 1";
        programSelectedKineId = 0;
        RefreshProgramPreview();
        await CreateProgramAppointments();
    }

    private void RefreshProgramPreview()
    {
        if (selectedProgram == null)
        {
            programPreview = new();
            return;
        }
        programPreview = GenerateProgramAppointments(selectedProgram);
    }

    private void ToggleProgramWeekDay(DayOfWeek day)
    {
        if (selectedProgramWeekDays.Contains(day))
        {
            selectedProgramWeekDays.Remove(day);
        }
        else
        {
            selectedProgramWeekDays.Add(day);
        }

        if (selectedProgram != null && selectedProgramWeekDays.Count > selectedProgram.NbSeancesParSemaine)
        {
            selectedProgramWeekDays = selectedProgramWeekDays.OrderBy(d => d).Take(selectedProgram.NbSeancesParSemaine).ToList();
        }

        RefreshProgramPreview();
    }

    private static string GetDayLabel(DayOfWeek day) => day switch
    {
        DayOfWeek.Monday => "Lundi",
        DayOfWeek.Tuesday => "Mardi",
        DayOfWeek.Wednesday => "Mercredi",
        DayOfWeek.Thursday => "Jeudi",
        DayOfWeek.Friday => "Vendredi",
        DayOfWeek.Saturday => "Samedi",
        DayOfWeek.Sunday => "Dimanche",
        _ => day.ToString(),
    };

    private static List<DayOfWeek> GetDefaultWeekDays(int count, DayOfWeek startDay)
    {
        var days = new List<DayOfWeek>();
        for (var i = 0; i < 7 && days.Count < count; i++)
        {
            var next = (DayOfWeek)(((int)startDay + i) % 7);
            days.Add(next);
        }
        return days;
    }

    private List<AppointmentDto> GenerateProgramAppointments(PatientProgramDto program)
    {
        var totalSessions = Math.Max(1, program.NbSeances);
        var perWeek = Math.Max(1, program.NbSeancesParSemaine);
        var startDate = programStartDate.Date;
        if (!TimeSpan.TryParse(programStartTime, out var startTimeSpan))
        {
            startTimeSpan = TimeSpan.FromHours(8);
        }

        var effectiveWeekDays = selectedProgramWeekDays.Any() ? selectedProgramWeekDays.OrderBy(d => d).Take(perWeek).ToList() : GetDefaultWeekDays(perWeek, startDate.DayOfWeek);
        if (!effectiveWeekDays.Any())
        {
            effectiveWeekDays = GetDefaultWeekDays(perWeek, startDate.DayOfWeek);
        }

        var result = new List<AppointmentDto>();
        var currentDate = startDate;

        while (result.Count < totalSessions)
        {
            if (effectiveWeekDays.Contains(currentDate.DayOfWeek))
            {
                var startDateTime = currentDate + startTimeSpan;
                var endDateTime = startDateTime.AddMinutes(program.DureeSeanceMinutes > 0 ? program.DureeSeanceMinutes : 30);
                result.Add(new AppointmentDto
                {
                    PatientId = program.PatientId,
                    PatientName = selectedProgramPatient?.Nom + " " + selectedProgramPatient?.Prenom,
                    KineId = programSelectedKineId > 0 ? programSelectedKineId : null,
                    Start = startDateTime,
                    End = endDateTime,
                    Acte = program.NatureSeances,
                    Room = programRoom,
                    Status = "planifie",
                    PaymentStatus = "non_paye",
                    Amount = DetermineSessionAmount(program, selectedProgramPatient),
                    CnamCovered = 0,
                    Notes = $"Programme {program.Titre}"
                });
            }

            currentDate = currentDate.AddDays(1);
        }

        return result;
    }

    private decimal DetermineSessionAmount(PatientProgramDto program, PatientDto? patient)
    {
        if (program.PrixEspece > 0)
        {
            return program.PrixEspece;
        }

        if (patient == null)
        {
            return program.PrixUnitaire;
        }

        var hasCnam = !string.IsNullOrWhiteSpace(patient.Couverture);
        return hasCnam ? 0m : program.PrixUnitaire;
    }

    private async Task ShowSuccessMessage(string message)
    {
        successMessageCts?.Cancel();
        successMessage = message;
        StateHasChanged();

        successMessageCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(5000, successMessageCts.Token);
            successMessage = null;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
            // Ignorer l'annulation lorsque l'utilisateur ferme manuellement.
        }
    }

    private void DismissSuccessMessage()
    {
        successMessageCts?.Cancel();
        successMessage = null;
    }

    private async Task CreateProgramAppointments()
    {
        if (!programPreview.Any())
        {
            return;
        }

        errorMessage = null;
        foreach (var appointment in programPreview)
        {
            var response = await Http.PostAsJsonAsync("api/appointments", appointment);
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Erreur lors de la création des rendez-vous du programme.";
                return;
            }
        }

        await LoadAppointments();

        if (selectedProgramPatientId > 0)
        {
            await LoadProgramsForPatient(selectedProgramPatientId);
        }

        programPreview.Clear();
        await ShowSuccessMessage("Rendez-vous du programme créés avec succès.");
    }

    private async Task OnNewAppointmentPatientChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var patientId))
        {
            newAppointment.PatientId = patientId;
            if (patientId > 0)
            {
                var programs = await Http.GetFromJsonAsync<List<PatientProgramDto>>($"api/patientprograms/patient/{patientId}") ?? new List<PatientProgramDto>();
                selectedNewPatientHasPrograms = programs.Any();
            }
            else
            {
                selectedNewPatientHasPrograms = false;
            }
        }
        else
        {
            selectedNewPatientHasPrograms = false;
        }
    }

    private async Task CreateAppointmentAsync()
    {
        errorMessage = null;

        if (!newAppointment.Start.HasValue)
        {
            errorMessage = "La date de début est requise.";
            return;
        }

        if (!TimeSpan.TryParse(startTime, out var parsedStartTime))
        {
            errorMessage = "Heure de début invalide.";
            return;
        }

        newAppointment.Start = newAppointment.Start.Value.Date + parsedStartTime;
        newAppointment.End = newAppointment.Start.Value.AddMinutes(durationMinutes > 0 ? durationMinutes : 30);

        if (isEditing && editingAppointment != null)
        {
            await UpdateAppointmentFromForm();
            return;
        }

        var response = await Http.PostAsJsonAsync("api/appointments", newAppointment);
        if (response.IsSuccessStatusCode)
        {
            await LoadAppointments();
            HideAddAppointment();
        }
        else
        {
            errorMessage = "Impossible de créer le rendez-vous.";
        }
    }

    private async Task UpdateAppointmentFromForm()
    {
        if (editingAppointment == null)
        {
            errorMessage = "Aucun rendez-vous sélectionné pour la mise à jour.";
            return;
        }

        var update = new AppointmentDto
        {
            Id = editingAppointment.Id,
            PatientId = newAppointment.PatientId,
            PatientName = newAppointment.PatientName,
            KineId = newAppointment.KineId,
            KineName = newAppointment.KineName,
            Start = newAppointment.Start,
            End = newAppointment.End,
            Acte = newAppointment.Acte,
            Room = newAppointment.Room,
            Status = newAppointment.Status,
            PaymentStatus = newAppointment.PaymentStatus,
            Amount = newAppointment.Amount,
            PaidAmount = newAppointment.PaidAmount,
            CnamCovered = newAppointment.CnamCovered,
            Notes = newAppointment.Notes
        };

        var response = await Http.PutAsJsonAsync($"api/appointments/{editingAppointment.Id}", update);
        if (response.IsSuccessStatusCode)
        {
            await LoadAppointments();
            HideAddAppointment();
        }
        else
        {
            errorMessage = "Impossible de mettre à jour le rendez-vous.";
        }
    }

    private IEnumerable<AppointmentDto> todayAppointments => FilteredAppointments().Where(a => a.Start.HasValue && a.Start.Value.Date == DateTime.Today);

    private IEnumerable<AppointmentDto> FilteredAppointments()
    {
        if (appointments == null)
        {
            return Array.Empty<AppointmentDto>();
        }

        var filtered = appointments.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(appointmentSearch))
        {
            var keyword = appointmentSearch.Trim().ToLowerInvariant();
            filtered = filtered.Where(a =>
                (a.PatientName ?? string.Empty).ToLowerInvariant().Contains(keyword) ||
                (a.Acte ?? string.Empty).ToLowerInvariant().Contains(keyword) ||
                (a.Room ?? string.Empty).ToLowerInvariant().Contains(keyword)
            );
        }

        if (selectedKineFilter > 0)
        {
            filtered = filtered.Where(a => a.KineId == selectedKineFilter);
        }

        filtered = filtered.Where(a => !CanceledStatuses.Contains((a.Status ?? string.Empty).Trim()));

        if (!string.IsNullOrWhiteSpace(appointmentStatusFilter))
        {
            filtered = filtered.Where(a => string.Equals(a.Status?.Trim(), appointmentStatusFilter.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        return SortFilteredAppointments(filtered);
    }

    private IEnumerable<AppointmentDto> SortFilteredAppointments(IEnumerable<AppointmentDto> appointments)
    {
        return (appointmentSortColumn, appointmentSortDescending) switch
        {
            (AppointmentSortColumn.Start, false) => appointments.OrderBy(a => a.Start),
            (AppointmentSortColumn.Start, true) => appointments.OrderByDescending(a => a.Start),
            (AppointmentSortColumn.PatientName, false) => appointments.OrderBy(a => a.PatientName),
            (AppointmentSortColumn.PatientName, true) => appointments.OrderByDescending(a => a.PatientName),
            (AppointmentSortColumn.KineName, false) => appointments.OrderBy(a => a.KineName),
            (AppointmentSortColumn.KineName, true) => appointments.OrderByDescending(a => a.KineName),
            (AppointmentSortColumn.Acte, false) => appointments.OrderBy(a => a.Acte),
            (AppointmentSortColumn.Acte, true) => appointments.OrderByDescending(a => a.Acte),
            (AppointmentSortColumn.Room, false) => appointments.OrderBy(a => a.Room),
            (AppointmentSortColumn.Room, true) => appointments.OrderByDescending(a => a.Room),
            (AppointmentSortColumn.Amount, false) => appointments.OrderBy(a => a.Amount),
            (AppointmentSortColumn.Amount, true) => appointments.OrderByDescending(a => a.Amount),
            (AppointmentSortColumn.Status, false) => appointments.OrderBy(a => a.Status),
            (AppointmentSortColumn.Status, true) => appointments.OrderByDescending(a => a.Status),
            (AppointmentSortColumn.PaymentStatus, false) => appointments.OrderBy(a => a.PaymentStatus),
            (AppointmentSortColumn.PaymentStatus, true) => appointments.OrderByDescending(a => a.PaymentStatus),
            _ => appointments.OrderBy(a => a.Start)
        };
    }

    private void SetAppointmentSort(AppointmentSortColumn sortColumn)
    {
        if (appointmentSortColumn == sortColumn)
        {
            appointmentSortDescending = !appointmentSortDescending;
        }
        else
        {
            appointmentSortColumn = sortColumn;
            appointmentSortDescending = false;
        }
    }

    private string GetSortIcon(AppointmentSortColumn sortColumn)
    {
        if (appointmentSortColumn != sortColumn)
        {
            return string.Empty;
        }

        return appointmentSortDescending ? "▼" : "▲";
    }

    private IEnumerable<AppointmentDto> CanceledAppointments => appointments?.Where(a => CanceledStatuses.Contains((a.Status ?? string.Empty).Trim())) ?? Enumerable.Empty<AppointmentDto>();

    private void ToggleAppointmentSelection(int appointmentId)
    {
        if (selectedAppointmentIds.Contains(appointmentId))
        {
            selectedAppointmentIds.Remove(appointmentId);
        }
        else
        {
            selectedAppointmentIds.Add(appointmentId);
        }
    }

    private async Task BulkCancelSelectedAppointments()
    {
        if (selectedAppointmentIds.Count == 0 || appointments == null)
        {
            return;
        }

        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Supprimer les rendez-vous sélectionnés ?"))
        {
            return;
        }

        errorMessage = null;
        foreach (var appointmentId in selectedAppointmentIds.ToList())
        {
            var appointment = appointments.FirstOrDefault(a => a.Id == appointmentId);
            if (appointment != null)
            {
                await UpdateAppointmentStatus(appointment, "annule", appointment.PaymentStatus ?? "non_paye", appointment.PaidAmount);
            }
        }

        selectedAppointmentIds.Clear();
        await LoadAppointments();
        await ShowSuccessMessage("Rendez-vous sélectionnés annulés.");
    }

    private void ToggleSelectAllCurrentPage(ChangeEventArgs e)
    {
        var visibleIds = FilteredAppointments().Select(a => a.Id).ToList();
        if (visibleIds.All(id => selectedAppointmentIds.Contains(id)))
        {
            foreach (var id in visibleIds)
            {
                selectedAppointmentIds.Remove(id);
            }
        }
        else
        {
            foreach (var id in visibleIds)
            {
                selectedAppointmentIds.Add(id);
            }
        }
    }

    private bool AreAllVisibleAppointmentsSelected()
    {
        var visibleIds = FilteredAppointments().Select(a => a.Id).ToList();
        return visibleIds.Any() && visibleIds.All(id => selectedAppointmentIds.Contains(id));
    }

    private void ToggleCanceledAppointmentSelection(int appointmentId)
    {
        if (canceledSelectedAppointmentIds.Contains(appointmentId))
        {
            canceledSelectedAppointmentIds.Remove(appointmentId);
        }
        else
        {
            canceledSelectedAppointmentIds.Add(appointmentId);
        }
    }

    private void ToggleSelectAllCanceledPage(ChangeEventArgs e)
    {
        var visibleIds = CanceledAppointments.Select(a => a.Id).ToList();
        if (visibleIds.All(id => canceledSelectedAppointmentIds.Contains(id)))
        {
            foreach (var id in visibleIds)
            {
                canceledSelectedAppointmentIds.Remove(id);
            }
        }
        else
        {
            foreach (var id in visibleIds)
            {
                canceledSelectedAppointmentIds.Add(id);
            }
        }
    }

    private bool AreAllVisibleCanceledAppointmentsSelected()
    {
        var visibleIds = CanceledAppointments.Select(a => a.Id).ToList();
        return visibleIds.Any() && visibleIds.All(id => canceledSelectedAppointmentIds.Contains(id));
    }

    private async Task BulkDeleteCanceledAppointments()
    {
        if (canceledSelectedAppointmentIds.Count == 0)
        {
            return;
        }

        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Supprimer définitivement les rendez-vous sélectionnés ?"))
        {
            return;
        }

        foreach (var appointmentId in canceledSelectedAppointmentIds.ToList())
        {
            await DeleteAppointment(appointmentId);
        }

        canceledSelectedAppointmentIds.Clear();
        await LoadAppointments();
        await ShowSuccessMessage("Rendez-vous annulés supprimés définitivement.");
    }

    private async Task CancelAppointment(AppointmentDto appointment)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Supprimer ce rendez-vous ?"))
        {
            return;
        }

        await UpdateAppointmentStatus(appointment, "annule", appointment.PaymentStatus ?? "non_paye", appointment.PaidAmount);
        selectedAppointmentIds.Remove(appointment.Id);
        await LoadAppointments();
        await ShowSuccessMessage("Rendez-vous annulé.");
    }

    private async Task ReactivateAppointment(AppointmentDto appointment)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Réactiver ce rendez-vous annulé ?"))
        {
            return;
        }

        await UpdateAppointmentStatus(appointment, "planifie", appointment.PaymentStatus ?? "non_paye", appointment.PaidAmount);
        await LoadAppointments();
        await ShowSuccessMessage("Rendez-vous réactivé.");
    }

    private async Task MarkAppointmentPresent(AppointmentDto appointment)
    {
        await UpdateAppointmentStatus(appointment, "present", appointment.PaymentStatus ?? "non_paye", appointment.PaidAmount);
    }

    private async Task MarkAppointmentAbsent(AppointmentDto appointment)
    {
        await UpdateAppointmentStatus(appointment, "absent", "non_paye", 0);
    }

    private void OpenPaymentModal(AppointmentDto appointment)
    {
        paymentAppointment = appointment;
        paymentInputAmount = GetAppointmentRemainingAmount(appointment);
        paymentErrorMessage = null;
        showPaymentModal = true;
    }

    private void ClosePaymentModal()
    {
        showPaymentModal = false;
        paymentAppointment = null;
        paymentErrorMessage = null;
    }

    private decimal GetAppointmentRemainingAmount(AppointmentDto appointment)
    {
        return Math.Max(0, appointment.Amount - appointment.PaidAmount);
    }

    private static string ComputePaymentStatus(decimal amount, decimal paidAmount)
    {
        if (amount <= 0)
        {
            return "paye";
        }

        return paidAmount >= amount ? "paye" : (paidAmount > 0 ? "partiel" : "non_paye");
    }

    private async Task ProcessAppointmentPayment()
    {
        if (paymentAppointment == null)
        {
            return;
        }

        var remaining = GetAppointmentRemainingAmount(paymentAppointment);
        if (paymentInputAmount <= 0)
        {
            paymentErrorMessage = "Entrez un montant valide.";
            return;
        }

        var newPaidAmount = paymentAppointment.PaidAmount + Math.Min(paymentInputAmount, remaining);
        var paymentStatus = ComputePaymentStatus(paymentAppointment.Amount, newPaidAmount);
        var overpayment = paymentInputAmount - remaining;

        var update = new AppointmentDto
        {
            Id = paymentAppointment.Id,
            PatientId = paymentAppointment.PatientId,
            PatientName = paymentAppointment.PatientName,
            KineId = paymentAppointment.KineId,
            KineName = paymentAppointment.KineName,
            Start = paymentAppointment.Start,
            End = paymentAppointment.End,
            Acte = paymentAppointment.Acte,
            Room = paymentAppointment.Room,
            Status = paymentAppointment.Status,
            PaymentStatus = paymentStatus,
            Amount = paymentAppointment.Amount,
            PaidAmount = newPaidAmount,
            CnamCovered = paymentAppointment.CnamCovered,
            Notes = paymentAppointment.Notes
        };

        var response = await Http.PutAsJsonAsync($"api/appointments/{paymentAppointment.Id}", update);
        if (!response.IsSuccessStatusCode)
        {
            paymentErrorMessage = "Impossible de mettre à jour le paiement du rendez-vous.";
            return;
        }

        if (overpayment > 0)
        {
            var advanceRequest = new AdvanceTransactionRequestDto
            {
                PatientId = paymentAppointment.PatientId,
                Amount = overpayment,
                TransactionDate = DateTime.UtcNow,
                Note = $"Surplus de paiement RDV {paymentAppointment.Id}",
                CreatedBy = "Web"
            };

            var advanceResponse = await Http.PostAsJsonAsync("api/finance/advance-transactions", advanceRequest);
            if (!advanceResponse.IsSuccessStatusCode)
            {
                paymentErrorMessage = "Paiement enregistré, mais impossible de créer l'avance pour le surplus.";
                await LoadAppointments();
                showPaymentModal = false;
                return;
            }
        }

        await LoadAppointments();
        showPaymentModal = false;
        paymentAppointment = null;
        paymentErrorMessage = null;
    }

    private async Task MarkAppointmentUnpaid(AppointmentDto appointment)
    {
        await UpdateAppointmentStatus(appointment, appointment.Status ?? "planifie", "non_paye", 0);
    }

    private async Task UpdateAppointmentStatus(AppointmentDto appointment, string status, string paymentStatus, decimal paidAmount)
    {
        var update = new AppointmentDto
        {
            Id = appointment.Id,
            PatientId = appointment.PatientId,
            PatientName = appointment.PatientName,
            KineId = appointment.KineId,
            KineName = appointment.KineName,
            Start = appointment.Start,
            End = appointment.End,
            Acte = appointment.Acte,
            Room = appointment.Room,
            Status = status,
            PaymentStatus = paymentStatus,
            Amount = appointment.Amount,
            PaidAmount = paidAmount,
            CnamCovered = appointment.CnamCovered,
            Notes = appointment.Notes
        };

        var response = await Http.PutAsJsonAsync($"api/appointments/{appointment.Id}", update);
        if (response.IsSuccessStatusCode)
        {
            await LoadAppointments();
        }
        else
        {
            errorMessage = "Impossible de mettre à jour le rendez-vous.";
        }
    }

    private IEnumerable<UserDto> AvailableKines()
    {
        if (!newAppointment.Start.HasValue || durationMinutes <= 0)
        {
            return kines;
        }

        if (!TimeSpan.TryParse(startTime, out var parsedTime))
        {
            return kines;
        }

        var start = newAppointment.Start.Value.Date + parsedTime;
        var end = start.AddMinutes(durationMinutes);
        return kines.Where(k => appointments == null || !appointments.Any(a => a.KineId == k.Id && a.Id != newAppointment.Id &&
            a.Start.HasValue && a.End.HasValue && (start < a.End.Value && a.Start.Value < end))).ToList();
    }

    private async Task EditAppointment(AppointmentDto appointment)
    {
        editingAppointment = appointment;
        isEditing = true;
        activeSubmodule = AppointmentSubmodule.NewAppointment;
        showAppointmentForm = true;
        newAppointment = new AppointmentDto
        {
            Id = appointment.Id,
            PatientId = appointment.PatientId,
            KineId = appointment.KineId,
            PatientName = appointment.PatientName,
            KineName = appointment.KineName,
            Start = appointment.Start,
            End = appointment.End,
            Acte = appointment.Acte,
            Room = appointment.Room,
            Status = appointment.Status,
            PaymentStatus = appointment.PaymentStatus,
            Amount = appointment.Amount,
            PaidAmount = appointment.PaidAmount,
            CnamCovered = appointment.CnamCovered,
            Notes = appointment.Notes
        };
        if (newAppointment.Start.HasValue)
        {
            startTime = newAppointment.Start.Value.ToString("HH:mm");
            durationMinutes = newAppointment.End.HasValue ? (int)(newAppointment.End.Value - newAppointment.Start.Value).TotalMinutes : 30;
        }
    }

    private async Task DeleteAppointment(int id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Supprimer ce rendez-vous ?"))
        {
            return;
        }

        var response = await Http.DeleteAsync($"api/appointments/{id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadAppointments();
        }
        else
        {
            errorMessage = "Impossible de supprimer le rendez-vous.";
        }
    }

