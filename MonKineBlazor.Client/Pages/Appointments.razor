@page "/appointments"
@using MonKineBlazor.Shared.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<h1>Rendez-vous</h1>

<div class="row mb-3">
    <div class="col-md-12 d-flex flex-wrap gap-2">
        <button class="btn btn-primary" @onclick="LoadAppointments">Rafraîchir</button>
        <button class="btn btn-success" @onclick="ShowAddAppointment">Nouveau rendez-vous</button>
        <button class="btn btn-outline-secondary" @onclick="() => SetCalendarView(CalendarView.Week)">Semaine</button>
        <button class="btn btn-outline-secondary" @onclick="() => SetCalendarView(CalendarView.Month)">Mois</button>
        <button class="btn btn-outline-secondary" @onclick="() => SetCalendarView(CalendarView.List)">Liste</button>
    </div>
</div>
<div class="row mb-3">
    <div class="col-md-4">
        <label class="form-label">Rechercher</label>
        <InputText class="form-control" @bind-Value="appointmentSearch" placeholder="Patient, Acte, Salle" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Filtrer par kiné</label>
        <InputSelect class="form-select" @bind-Value="selectedKineFilter">
            <option value="0">Tous</option>
            @foreach (var kine in kines)
            {
                <option value="@kine.Id">@((kine.FullName ?? kine.Username))</option>
            }
        </InputSelect>
    </div>
    <div class="col-md-3">
        <label class="form-label">Filtrer par statut</label>
        <InputSelect class="form-select" @bind-Value="appointmentStatusFilter">
            <option value="">Tous</option>
            <option value="planifie">planifie</option>
            <option value="termine">termine</option>
            <option value="annule">annule</option>
        </InputSelect>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (appointments is null)
{
    <p><em>Chargement...</em></p>
}
else if (!appointments.Any())
{
    <div class="alert alert-info">Aucun rendez-vous trouvé.</div>
}
else if (calendarView != CalendarView.List)
{
    @if (calendarView == CalendarView.Week)
    {
        <div class="table-responsive">
            <table class="table table-bordered calendar-table">
                <thead>
                    <tr>
                        @foreach (var day in GetWeekDays())
                        {
                            <th>@day.ToString("ddd dd/MM")</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        @foreach (var day in GetWeekDays())
                        {
                            <td>
                                @foreach (var appt in appointments.Where(a => a.Start.HasValue && a.Start.Value.Date == day.Date).OrderBy(a => a.Start))
                                {
                                    <div class="mb-2 p-2 border rounded">
                                        <strong>@appt.Start:HH:mm</strong><br />
                                        <span>@appt.PatientName</span><br />
                                        <span>@appt.KineName</span><br />
                                        <span>@appt.Acte</span>
                                    </div>
                                }
                            </td>
                        }
                    </tr>
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered calendar-table">
                <thead>
                    <tr>
                        <th>Lun</th>
                        <th>Mar</th>
                        <th>Mer</th>
                        <th>Jeu</th>
                        <th>Ven</th>
                        <th>Sam</th>
                        <th>Dim</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var week in GetMonthWeeks())
                    {
                        <tr>
                            @foreach (var day in week)
                            {
                                <td class="align-top" style="min-height: 120px; vertical-align: top;">
                                    <div class="fw-bold">@day.Day</div>
                                    @foreach (var appt in appointments.Where(a => a.Start.HasValue && a.Start.Value.Date == day.Date).OrderBy(a => a.Start).Take(3))
                                    {
                                        <div class="mb-1 p-1 border rounded small">
                                            <strong>@appt.Start:HH:mm</strong> @appt.KineName
                                        </div>
                                    }
                                    @if (appointments.Count(a => a.Start.HasValue && a.Start.Value.Date == day.Date) > 3)
                                    {
                                        <div class="small text-muted">+ autres</div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Date début</th>
                <th>Patient</th>
                <th>Kiné</th>
                <th>Acte</th>
                <th>Salle</th>
                <th>Montant</th>
                <th>Statut</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appointment in appointments)
            {
                <tr>
                    <td>@appointment.Start</td>
                    <td>@appointment.PatientName</td>
                    <td>@appointment.KineName</td>
                    <td>@appointment.Acte</td>
                    <td>@appointment.Room</td>
                    <td>@appointment.Amount</td>
                    <td>@appointment.Status</td>
                    <td>
                        <button class="btn btn-sm btn-primary me-2" @onclick="() => EditAppointment(appointment)">Modifier</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteAppointment(appointment.Id)">Supprimer</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@if (showAppointmentForm)
{
    <div class="card mt-4">
        <div class="card-header">Nouveau rendez-vous</div>
        <div class="card-body">
            <EditForm Model="newAppointment" OnValidSubmit="CreateAppointmentAsync">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Patient</label>
                        <InputSelect class="form-select" @bind-Value="newAppointment.PatientId">
                            <option value="">-- Sélectionnez --</option>
                            @foreach (var patient in patients)
                            {
                                <option value="@patient.Id">@patient.Nom @patient.Prenom</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Kiné</label>
                        <InputSelect class="form-select" @bind-Value="newAppointment.KineId">
                            <option value="">-- Sélectionnez --</option>
                            @foreach (var kine in kines)
                            {
                                <option value="@kine.Id">@((kine.FullName ?? kine.Username))</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Date début</label>
                        <InputDate class="form-control" @bind-Value="newAppointment.Start" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Heure début</label>
                        <InputText class="form-control" @bind-Value="startTime" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Durée (min)</label>
                        <InputNumber class="form-control" @bind-Value="durationMinutes" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Acte</label>
                        <InputText class="form-control" @bind-Value="newAppointment.Acte" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Salle</label>
                        <InputText class="form-control" @bind-Value="newAppointment.Room" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Montant</label>
                        <InputNumber class="form-control" @bind-Value="newAppointment.Amount" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Part CNAM</label>
                        <InputNumber class="form-control" @bind-Value="newAppointment.CnamCovered" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Kinés disponibles</label>
                        <div class="form-control" style="height: auto; min-height: 110px;">
                            @foreach (var available in AvailableKines())
                            {
                                <div>@((available.FullName ?? available.Username))</div>
                            }
                        </div>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Statut</label>
                        <InputSelect class="form-select" @bind-Value="newAppointment.Status">
                            <option value="planifie">planifie</option>
                            <option value="termine">termine</option>
                            <option value="annule">annule</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Paiement</label>
                        <InputSelect class="form-select" @bind-Value="newAppointment.PaymentStatus">
                            <option value="non_paye">non_paye</option>
                            <option value="partiellement_paye">partiellement_paye</option>
                            <option value="paye">paye</option>
                        </InputSelect>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">Notes</label>
                        <InputTextArea class="form-control" @bind-Value="newAppointment.Notes" Rows="3" />
                    </div>
                    <div class="col-md-12 d-flex gap-2">
                        <button class="btn btn-success" type="submit">Enregistrer</button>
                        <button class="btn btn-outline-secondary" type="button" @onclick="HideAddAppointment">Annuler</button>
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    private List<AppointmentDto>? appointments;
    private List<PatientDto> patients = new();
    private List<UserDto> kines = new();
    private AppointmentDto newAppointment = new()
    {
        Status = "planifie",
        PaymentStatus = "non_paye",
        Amount = 0,
        PaidAmount = 0,
        CnamCovered = 0,
        Start = DateTime.Today,
        End = DateTime.Today.AddHours(1)
    };
    private bool showAppointmentForm;
    private string startTime = "08:00";
    private int durationMinutes = 30;
    private string? errorMessage;
    private string appointmentSearch = string.Empty;
    private string appointmentStatusFilter = string.Empty;
    private int selectedKineFilter = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
        await LoadKines();
        await LoadAppointments();
    }

    private async Task LoadPatients()
    {
        patients = await Http.GetFromJsonAsync<List<PatientDto>>("api/patients") ?? new List<PatientDto>();
    }

    private async Task LoadKines()
    {
        kines = new List<UserDto>();
        try
        {
            var response = await Http.GetFromJsonAsync<List<UserDto>>("api/users/kines");
            if (response != null)
            {
                kines = response;
            }
        }
        catch { }
    }

    private async Task LoadAppointments()
    {
        errorMessage = null;
        try
        {
            appointments = await Http.GetFromJsonAsync<List<AppointmentDto>>("api/appointments");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            appointments = new List<AppointmentDto>();
        }
    }

    private void ShowAddAppointment()
    {
        showAppointmentForm = true;
    }

    private async Task CreateAppointmentAsync()
    {
        if (newAppointment.Start.HasValue)
        {
            if (TimeSpan.TryParse(startTime, out var parsedTime))
            {
                newAppointment.Start = newAppointment.Start.Value.Date + parsedTime;
                newAppointment.End = newAppointment.Start.Value.AddMinutes(durationMinutes);
            }
        }

        var response = await Http.PostAsJsonAsync("api/appointments", newAppointment);
        if (response.IsSuccessStatusCode)
        {
            await LoadAppointments();
            HideAddAppointment();
        }
        else
        {
            errorMessage = "Erreur lors de l'enregistrement du rendez-vous.";
        }
    }

    private CalendarView calendarView = CalendarView.List;
    private DateTime currentDate = DateTime.Today;
    private bool isEditing;
    private AppointmentDto? editingAppointment;

    private IEnumerable<AppointmentDto> FilteredAppointments()
    {
        if (appointments == null)
        {
            return Array.Empty<AppointmentDto>();
        }

        var filtered = appointments.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(appointmentSearch))
        {
            var keyword = appointmentSearch.Trim().ToLowerInvariant();
            filtered = filtered.Where(a =>
                (a.PatientName ?? string.Empty).ToLowerInvariant().Contains(keyword) ||
                (a.Acte ?? string.Empty).ToLowerInvariant().Contains(keyword) ||
                (a.Room ?? string.Empty).ToLowerInvariant().Contains(keyword)
            );
        }

        if (selectedKineFilter > 0)
        {
            filtered = filtered.Where(a => a.KineId == selectedKineFilter);
        }

        if (!string.IsNullOrWhiteSpace(appointmentStatusFilter))
        {
            filtered = filtered.Where(a => string.Equals(a.Status, appointmentStatusFilter, StringComparison.OrdinalIgnoreCase));
        }

        return filtered;
    }

    private void SetCalendarView(CalendarView view)
    {
        calendarView = view;
    }

    private IEnumerable<DateTime> GetWeekDays()
    {
        var startOfWeek = currentDate.AddDays(-((int)currentDate.DayOfWeek + 6) % 7);
        return Enumerable.Range(0, 7).Select(i => startOfWeek.AddDays(i));
    }

    private IEnumerable<List<DateTime>> GetMonthWeeks()
    {
        var firstOfMonth = new DateTime(currentDate.Year, currentDate.Month, 1);
        var firstDay = firstOfMonth.AddDays(-((int)firstOfMonth.DayOfWeek + 6) % 7);
        var weeks = new List<List<DateTime>>();

        for (var weekStart = firstDay; weekStart < firstOfMonth.AddMonths(1) || weeks.Count < 5; weekStart = weekStart.AddDays(7))
        {
            weeks.Add(Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i)).ToList());
        }

        return weeks;
    }

    private void EditAppointment(AppointmentDto appointment)
    {
        editingAppointment = appointment;
        isEditing = true;
        showAppointmentForm = true;
        newAppointment = new AppointmentDto
        {
            Id = appointment.Id,
            PatientId = appointment.PatientId,
            KineId = appointment.KineId,
            PatientName = appointment.PatientName,
            KineName = appointment.KineName,
            Start = appointment.Start,
            End = appointment.End,
            Acte = appointment.Acte,
            Room = appointment.Room,
            Status = appointment.Status,
            PaymentStatus = appointment.PaymentStatus,
            Amount = appointment.Amount,
            PaidAmount = appointment.PaidAmount,
            CnamCovered = appointment.CnamCovered,
            Notes = appointment.Notes
        };
        if (newAppointment.Start.HasValue)
        {
            startTime = newAppointment.Start.Value.ToString("HH:mm");
            durationMinutes = newAppointment.End.HasValue ? (int)(newAppointment.End.Value - newAppointment.Start.Value).TotalMinutes : 30;
        }
    }

    private async Task DeleteAppointment(int id)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Supprimer ce rendez-vous ?"))
        {
            return;
        }

        var response = await Http.DeleteAsync($"api/appointments/{id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadAppointments();
        }
        else
        {
            errorMessage = "Impossible de supprimer le rendez-vous.";
        }
    }

    private IEnumerable<UserDto> AvailableKines()
    {
        if (!newAppointment.Start.HasValue || durationMinutes <= 0)
        {
            return kines;
        }

        var start = newAppointment.Start.Value.Date + TimeSpan.Parse(startTime);
        var end = start.AddMinutes(durationMinutes);
        return kines.Where(k => !appointments?.Any(a => a.KineId == k.Id && a.Id != newAppointment.Id &&
            a.Start.HasValue && (start < (a.End ?? a.Start) && a.Start < end)) == true).ToList();
    }

    private async Task SaveAppointmentAsync()
    {
        errorMessage = null;
        if (newAppointment.Start.HasValue)
        {
            if (TimeSpan.TryParse(startTime, out var parsedTime))
            {
                newAppointment.Start = newAppointment.Start.Value.Date + parsedTime;
                newAppointment.End = newAppointment.Start.Value.AddMinutes(durationMinutes);
            }
        }

        HttpResponseMessage response;
        if (isEditing && editingAppointment != null)
        {
            response = await Http.PutAsJsonAsync($"api/appointments/{newAppointment.Id}", newAppointment);
        }
        else
        {
            response = await Http.PostAsJsonAsync("api/appointments", newAppointment);
        }

        if (response.IsSuccessStatusCode)
        {
            await LoadAppointments();
            HideAddAppointment();
            isEditing = false;
            editingAppointment = null;
        }
        else
        {
            errorMessage = "Erreur lors de l'enregistrement du rendez-vous.";
        }
    }

    private void HideAddAppointment()
    {
        showAppointmentForm = false;
        isEditing = false;
        editingAppointment = null;
        newAppointment = new AppointmentDto
        {
            Status = "planifie",
            PaymentStatus = "non_paye",
            Amount = 0,
            PaidAmount = 0,
            CnamCovered = 0,
            Start = DateTime.Today,
            End = DateTime.Today.AddHours(1)
        };
        startTime = "08:00";
        durationMinutes = 30;
    }

    private enum CalendarView
    {
        List,
        Week,
        Month
    }
}
