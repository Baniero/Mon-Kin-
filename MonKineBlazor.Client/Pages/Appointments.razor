    private void PreviousWeek()
    {
        currentDate = currentDate.AddDays(-7);
    }

    private void NextWeek()
    {
        currentDate = currentDate.AddDays(7);
    }

    private IEnumerable<DateTime> GetWeekDays()
    {
        var startOfWeek = currentDate.AddDays(-((int)currentDate.DayOfWeek + 6) % 7);
        return Enumerable.Range(0, 7).Select(i => startOfWeek.AddDays(i));
    }

    private IEnumerable<List<DateTime>> GetMonthWeeks()
    {
        var firstOfMonth = new DateTime(currentDate.Year, currentDate.Month, 1);
        var firstDay = firstOfMonth.AddDays(-((int)firstOfMonth.DayOfWeek + 6) % 7);
        var weeks = new List<List<DateTime>>();
        for (var weekStart = firstDay; weekStart < firstOfMonth.AddMonths(1) || weeks.Count < 5; weekStart = weekStart.AddDays(7))
        {
            weeks.Add(Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i)).ToList());
        }
        return weeks;
    }

