@page "/finance"
@using MonKineBlazor.Shared.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JSRuntime
@inject MonKineBlazor.Client.Services.AuthService AuthService

<h1>Finance</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1100;">
        <div class="toast show align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body">@successMessage</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" aria-label="Close" @onclick="DismissSuccessMessage"></button>
            </div>
        </div>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-2">
        <div class="card metric-card text-center p-3">
            <div class="metric-icon"><i class="bi bi-cash-stack"></i></div>
            <div class="text-muted">Cash attendu</div>
            <div class="h4">@($"{TotalCashExpected:F2} DT")</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card metric-card text-center p-3">
            <div class="metric-icon"><i class="bi bi-wallet2"></i></div>
            <div class="text-muted">Cash réel</div>
            <div class="h4">@($"{TotalCashActual:F2} DT")</div>
        </div>
    </div>
    <div class="col-md-2">
        <div class="card metric-card text-center p-3">
            <div class="metric-icon"><i class="bi bi-arrow-repeat"></i></div>
            <div class="text-muted">Écart total</div>
            <div class="h4">@($"{TotalCashDiff:F2} DT")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card metric-card text-center p-3">
            <div class="metric-icon"><i class="bi bi-coin"></i></div>
            <div class="text-muted">Total avances reçues</div>
            <div class="h4">@($"{TotalAdvances:F2} DT")</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card metric-card text-center p-3">
            <div class="metric-icon"><i class="bi bi-shield-check"></i></div>
            <div class="text-muted">Total CNAM recouvré</div>
            <div class="h4">@($"{TotalCnamRecovered:F2} DT")</div>
        </div>
    </div>
</div>

<div class="card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Du</label>
                <InputDate class="form-control" @bind-Value="cashStart" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Au</label>
                <InputDate class="form-control" @bind-Value="cashEnd" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Patient</label>
                <InputText class="form-control" @bind-Value="patientSearch" placeholder="Rechercher patient" />
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button class="btn btn-primary w-100" @onclick="FilterFinance">Filtrer</button>
                <button class="btn btn-outline-secondary w-100" @onclick="ResetFilters">Réinitialiser</button>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <button class="btn btn-outline-primary w-100" @onclick="() => SetSection(FinanceSection.Cash)"><i class="bi bi-currency-dollar me-2"></i>Caisse</button>
    </div>
    <div class="col-md-3">
        <button class="btn btn-outline-primary w-100" @onclick="() => SetSection(FinanceSection.Advances)"><i class="bi bi-wallet-fill me-2"></i>Avances</button>
    </div>
    <div class="col-md-3">
        <button class="btn btn-outline-primary w-100" @onclick="() => SetSection(FinanceSection.Projections)"><i class="bi bi-bar-chart-line me-2"></i>Projections</button>
    </div>
    <div class="col-md-3">
        <button class="btn btn-outline-primary w-100" @onclick="() => SetSection(FinanceSection.Cnam)"><i class="bi bi-shield-fill-check me-2"></i>CNAM</button>
    </div>
    <div class="col-md-3">
        <button class="btn btn-outline-primary w-100" @onclick="() => SetSection(FinanceSection.Transactions)"><i class="bi bi-list-check me-2"></i>Transactions</button>
    </div>
    <div class="col-md-3">
        <button class="btn btn-outline-primary w-100" @onclick="() => SetSection(FinanceSection.Stats)"><i class="bi bi-graph-up me-2"></i>Stats mensuelles</button>
    </div>
    <div class="col-md-3">
        <button class="btn btn-outline-primary w-100" @onclick="() => SetSection(FinanceSection.History)"><i class="bi bi-clock-history me-2"></i>Historique</button>
    </div>
</div>

@if (activeSection == FinanceSection.Cash)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Caisse journalière</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick='() => ExportCsv(cashClosings, "caisse_journaliere.csv")'>Exporter CSV</button>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label">Date</label>
                    <InputDate class="form-control" @bind-Value="cashClosingRequest.DateJour" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Montant réel</label>
                    <InputNumber class="form-control" @bind-Value="cashClosingRequest.ActualAmount" />
                </div>
                <div class="col-md-4 d-flex align-items-end gap-2">
                    <button class="btn btn-success w-100" @onclick="ValidateCashClosing">Enregistrer</button>
                </div>
            </div>
            @if (!cashClosings.Any())
            {
                <div class="alert alert-info">Aucune donnée trouvée pour cette plage de dates.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Attendu</th>
                                <th>Réel</th>
                                <th>Écart</th>
                                <th>Validé</th>
                                <th>Utilisateur</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in cashClosings)
                            {
                                <tr class="@(GetEcartClass(row.Diff))">
                                    <td>@row.DateJour.ToString("yyyy-MM-dd")</td>
                                    <td>@($"{row.ExpectedAmount:F2} DT")</td>
                                    <td>@($"{row.ActualAmount:F2} DT")</td>
                                    <td>@($"{row.Diff:F2} DT")</td>
                                    <td>@(row.Validated ? "Oui" : "Non")</td>
                                    <td>@row.ValidatedBy</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditCashClosing(row)">Modifier</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCashClosing(row.DateJour)">Supprimer</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr>
                                <th>Total</th>
                                <th>@($"{TotalCashExpected:F2} DT")</th>
                                <th>@($"{TotalCashActual:F2} DT")</th>
                                <th>@($"{TotalCashDiff:F2} DT")</th>
                                <th colspan="3"></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (activeSection == FinanceSection.Advances)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Avances patient</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick='() => ExportCsv(advanceTransactions, "avances_patient.csv")'>Exporter CSV</button>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3">
                <div class="col-md-5">
                    <label class="form-label">Patient</label>
                    <InputSelect class="form-select"
                                 Value="selectedPatientId"
                                 ValueChanged="async (int value) => await OnPatientSelected(value)"
                                 ValueExpression="@(() => selectedPatientId)">
                        <option value="0">-- Sélectionnez --</option>
                        @foreach (var patient in FilteredPatients)
                        {
                            <option value="@patient.Id">@patient.Nom @patient.Prenom</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Rechercher</label>
                    <InputText class="form-control" @bind-Value="patientSearch" placeholder="Rechercher patient" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-outline-secondary w-100" @onclick="FilterPatients">Actualiser</button>
                </div>
            </div>
            @if (selectedPatientId == 0)
            {
                <div class="alert alert-info">Sélectionnez un patient pour voir ses avances et lots.</div>
            }
            else
            {
                <div class="mb-3">
                    <strong>Solde avance :</strong> @($"{(patientFinance?.AdvanceBalance ?? 0m):F2} DT")<br />
                    <strong>Avances totales :</strong> @($"{(patientFinance?.TotalAdvancePaid ?? 0m):F2} DT")<br />
                    <strong>Total dû :</strong> @($"{(patientSummary?.TotalAmountDue ?? 0m):F2} DT")<br />
                    <strong>Total payé :</strong> @($"{(patientSummary?.TotalPaid ?? 0m):F2} DT")<br />
                    <strong>Reste à payer :</strong> @($"{(patientSummary?.OutstandingAmount ?? 0m):F2} DT")<br />
                    <strong>Reste après avances :</strong> @($"{(patientSummary?.OutstandingAfterAdvance ?? 0m):F2} DT")
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Montant avance</label>
                        <InputNumber class="form-control" @bind-Value="advanceRequest.Amount" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Note</label>
                        <InputText class="form-control" @bind-Value="advanceRequest.Note" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-success w-100" @onclick="CreateOrUpdateAdvance">@(isEditingAdvance ? "Mettre à jour" : "Enregistrer")</button>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button class="btn btn-outline-secondary w-100" @onclick="ResetAdvanceForm">Réinitialiser</button>
                    </div>
                </div>
                @if (advanceLots.Any())
                {
                    <div class="mb-3">
                        <h5>Lots d'avance</h5>
                        <div class="table-responsive">
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th>Transaction</th>
                                        <th>Original</th>
                                        <th>Restant</th>
                                        <th>Créé le</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var lot in advanceLots)
                                    {
                                        <tr>
                                            <td>@lot.TransactionId</td>
                                            <td>@($"{lot.OriginalAmount:F2} DT")</td>
                                            <td>@($"{lot.RemainingAmount:F2} DT")</td>
                                            <td>@lot.CreatedAt.ToString("yyyy-MM-dd")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">Aucun lot d'avance trouvé pour ce patient.</div>
                }
                @if (advanceTransactions.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-striped">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Montant</th>
                                    <th>Note</th>
                                    <th>Par</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var transaction in advanceTransactions)
                                {
                                    <tr>
                                        <td>@transaction.TransactionDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td>@($"{transaction.Amount:F2} DT")</td>
                                        <td>@transaction.Note</td>
                                        <td>@transaction.CreatedBy</td>
                                        <td>
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => BeginEditAdvance(transaction)">Modifier</button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAdvanceTransaction(transaction.Id)">Annuler</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
        </div>
    </div>
}

@if (activeSection == FinanceSection.Projections)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Projection de paiement</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick='() => ExportCsv(paymentProjections, "projection_paiement.csv")'>Exporter CSV</button>
        </div>
        <div class="card-body">
            @if (selectedPatientId == 0)
            {
                <div class="alert alert-info">Sélectionnez un patient dans le filtre ci-dessus pour voir la projection de paiement.</div>
            }
            else if (!paymentProjections.Any())
            {
                <div class="alert alert-info">Aucune projection disponible pour ce patient.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Rendez-vous</th>
                                <th>Montant dû</th>
                                <th>Paiement projeté</th>
                                <th>Avance projetée</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in paymentProjections)
                            {
                                <tr>
                                    <td>@item.AppointmentId</td>
                                    <td>@($"{item.PaidTotal:F2} DT")</td>
                                    <td>@item.PaymentStatus</td>
                                    <td>@($"{item.ProjectedAdvance:F2} DT")</td>
                                    <td>@item.SourceStatus</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (activeSection == FinanceSection.Cnam)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Reporting CNAM</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick='() => ExportCsv(cnamRecovery, "cnam_recovery.csv")'>Exporter CSV</button>
        </div>
        <div class="card-body">
            @if (!cnamRecovery.Any())
            {
                <div class="alert alert-info">Aucun recouvrement CNAM trouvé pour cette plage.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Patient</th>
                                <th>Couverture</th>
                                <th>Nb séances</th>
                                <th>Montant CNAM</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in cnamRecovery)
                            {
                                <tr>
                                    <td>@item.PatientName</td>
                                    <td>@item.Couverture</td>
                                    <td>@item.NbSeances</td>
                                    <td>@($"{item.MontantCnam:F2} DT")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (activeSection == FinanceSection.Transactions)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Transactions d'avances</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick='() => ExportCsv(allTransactions, "transactions_avances.csv")'>Exporter CSV</button>
        </div>
        <div class="card-body">
            @if (!allTransactions.Any())
            {
                <div class="alert alert-info">Aucune transaction d'avance trouvée.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Patient</th>
                                <th>Montant</th>
                                <th>Note</th>
                                <th>Par</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var transaction in allTransactions)
                            {
                                <tr>
                                    <td>@transaction.TransactionDate.ToString("yyyy-MM-dd HH:mm")</td>
                                    <td>@(transaction.PatientName ?? GetPatientName(transaction.PatientId))</td>
                                    <td>@($"{transaction.Amount:F2} DT")</td>
                                    <td>@transaction.Note</td>
                                    <td>@transaction.CreatedBy</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => EditTransaction(transaction)">Modifier</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAdvanceTransaction(transaction.Id)">Supprimer</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@if (activeSection == FinanceSection.Stats)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Statistiques financières mensuelles</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick='() => ExportCsv(monthlyStatsRange.Any() ? monthlyStatsRange : (monthlyStats is null ? Enumerable.Empty<MonthlyFinanceStatsDto>() : new [] { monthlyStats }), "statistiques_mensuelles.csv")' disabled="@(monthlyStatsRange.Count == 0 && monthlyStats == null)">Exporter CSV</button>
        </div>
        <div class="card-body">
            <div class="row g-3 mb-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Début</label>
                    <div class="input-group">
                        <InputNumber class="form-control" @bind-Value="statsStartYear" />
                        <InputSelect class="form-select" @bind-Value="statsStartMonth">
                            @for (var m = 1; m <= 12; m++)
                            {
                                <option value="@m">@m</option>
                            }
                        </InputSelect>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fin</label>
                    <div class="input-group">
                        <InputNumber class="form-control" @bind-Value="statsEndYear" />
                        <InputSelect class="form-select" @bind-Value="statsEndMonth">
                            @for (var m = 1; m <= 12; m++)
                            {
                                <option value="@m">@m</option>
                            }
                        </InputSelect>
                    </div>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="LoadMonthlyStatsRange">Charger plage</button>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-outline-secondary w-100" @onclick="LoadMonthlyStats">Charger mois</button>
                </div>
            </div>

            @if (monthlyStatsRange.Any())
            {
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Année</th>
                                <th>Mois</th>
                                <th>Attendu</th>
                                <th>Réel</th>
                                <th>Écart</th>
                                <th>Avances</th>
                                <th>Partiels</th>
                                <th>Impayé</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in monthlyStatsRange)
                            {
                                <tr>
                                    <td>@row.Year</td>
                                    <td>@row.Month</td>
                                    <td>@($"{row.ExpectedAmount:F2} DT")</td>
                                    <td>@($"{row.ActualAmount:F2} DT")</td>
                                    <td>@($"{row.Diff:F2} DT")</td>
                                    <td>@($"{row.TotalAdvances:F2} DT")</td>
                                    <td>@row.PartialPaymentsCount</td>
                                    <td>@($"{row.OutstandingAmount:F2} DT")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else if (monthlyStats == null)
            {
                <div class="alert alert-info">Aucune statistique calculée pour ce mois.</div>
            }

            @if (monthlyStats != null)
            {
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="card metric-card text-center p-3">
                            <div class="text-muted">Attendu</div>
                            <div class="h4">@($"{monthlyStats.ExpectedAmount:F2} DT")</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card metric-card text-center p-3">
                            <div class="text-muted">Réel</div>
                            <div class="h4">@($"{monthlyStats.ActualAmount:F2} DT")</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card metric-card text-center p-3">
                            <div class="text-muted">Écart</div>
                            <div class="h4">@($"{monthlyStats.Diff:F2} DT")</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card metric-card text-center p-3">
                            <div class="text-muted">Avances</div>
                            <div class="h4">@($"{monthlyStats.TotalAdvances:F2} DT")</div>
                        </div>
                    </div>
                </div>
                <div class="row g-3 mt-3">
                    <div class="col-md-3">
                        <div class="card metric-card text-center p-3">
                            <div class="text-muted">Paiements partiels</div>
                            <div class="h4">@monthlyStats.PartialPaymentsCount</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card metric-card text-center p-3">
                            <div class="text-muted">Montant impayé</div>
                            <div class="h4">@($"{monthlyStats.OutstandingAmount:F2} DT")</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card metric-card text-center p-3">
                            <div class="text-muted">Revenu attendu ce mois</div>
                            <div class="h4">@($"{monthlyStats.ExpectedProgramRevenueThisMonth:F2} DT")</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card metric-card text-center p-3">
                            <div class="text-muted">Revenu total attendu</div>
                            <div class="h4">@($"{monthlyStats.ExpectedTotalRevenue:F2} DT")</div>
                        </div>
                    </div>
                </div>
                <div class="row g-3 mt-3">
                    <div class="col-md-3">
                        <div class="card metric-card text-center p-3">
                            <div class="text-muted">Prix espèces patient</div>
                            <div class="h4">@($"{monthlyStats.ExpectedPatientPriceEspeceRevenue:F2} DT")</div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card metric-card text-center p-3">
                            <div class="text-muted">Revenu CNAM</div>
                            <div class="h4">@($"{monthlyStats.ExpectedCnamRevenue:F2} DT")</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (activeSection == FinanceSection.History)
{
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Historique financier patient</span>
            <button class="btn btn-sm btn-outline-secondary" @onclick='() => ExportCsv(patientHistory, "historique_financier.csv")'>Exporter CSV</button>
        </div>
        <div class="card-body">
            @if (selectedPatientId == 0)
            {
                <div class="alert alert-info">Sélectionnez un patient pour afficher l'historique financier.</div>
            }
            else if (!patientHistory.Any())
            {
                <div class="alert alert-info">Aucun historique financier trouvé pour ce patient.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Description</th>
                                <th>Montant</th>
                                <th>Solde</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in patientHistory)
                            {
                                <tr>
                                    <td>@entry.Date.ToString("yyyy-MM-dd")</td>
                                    <td>@entry.Type</td>
                                    <td>@entry.Description</td>
                                    <td>@($"{entry.Amount:F2} DT")</td>
                                    <td>@($"{entry.Balance:F2} DT")</td>
                                    <td>@entry.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    private string? errorMessage;
    private string? successMessage;
    private CancellationTokenSource? successMessageCts;

    private FinanceSection activeSection = FinanceSection.Cash;
    private List<CashClosingDto> cashClosings = new();
    private List<PatientDto> patients = new();
    private List<AdvanceTransactionDto> advanceTransactions = new();
    private List<AdvanceTransactionDto> allTransactions = new();
    private List<AdvanceLotDto> advanceLots = new();
    private List<PaymentProjectionEntryDto> paymentProjections = new();
    private List<CnamRecoveryDto> cnamRecovery = new();
    private PatientFinanceDto? patientFinance;
    private PatientFinancialSummaryDto? patientSummary;
    private MonthlyFinanceStatsDto? monthlyStats;
    private List<MonthlyFinanceStatsDto> monthlyStatsRange = new();
    private List<FinancialHistoryEntryDto> patientHistory = new();
    private int selectedPatientId;
    private int statsStartYear = DateTime.Today.Year;
    private int statsStartMonth = DateTime.Today.Month;
    private int statsEndYear = DateTime.Today.Year;
    private int statsEndMonth = DateTime.Today.Month;
    private string patientSearch = string.Empty;
    private DateTime cashStart = DateTime.Today.AddDays(-7);
    private DateTime cashEnd = DateTime.Today;
    private CashClosingRequestDto cashClosingRequest = new() { DateJour = DateTime.Today, ActualAmount = 0, ValidatedBy = "Web" };
    private AdvanceTransactionRequestDto advanceRequest = new() { TransactionDate = DateTime.UtcNow, Amount = 0, CreatedBy = "Web" };
    private bool isEditingAdvance;
    private int editingAdvanceTransactionId;

    protected override async Task OnInitializedAsync()
    {
        await LoadPatients();
        await LoadFinanceData();
    }

    private IEnumerable<PatientDto> FilteredPatients => string.IsNullOrWhiteSpace(patientSearch)
        ? patients
        : patients.Where(p => $"{p.Nom} {p.Prenom}".Contains(patientSearch, StringComparison.OrdinalIgnoreCase));

    private async Task LoadPatients()
    {
        patients = await Http.GetFromJsonAsync<List<PatientDto>>("api/patients") ?? new List<PatientDto>();
    }

    private async Task LoadFinanceData()
    {
        errorMessage = null;
        try
        {
            await LoadCashClosings();
            await LoadCnamRecovery();
            if (AuthService.CurrentUser?.Role == "admin")
            {
                await LoadAllTransactions();
            }
            if (selectedPatientId > 0)
            {
                await LoadAdvanceData();
                await LoadAdvanceLots();
                await LoadPaymentProjections();
                if (activeSection == FinanceSection.History)
                {
                    await LoadPatientHistory();
                }
            }
            if (activeSection == FinanceSection.Stats)
            {
                await LoadMonthlyStats();
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadCashClosings()
    {
        cashClosings = await Http.GetFromJsonAsync<List<CashClosingDto>>($"api/finance/cash-closings?start={cashStart:yyyy-MM-dd}&end={cashEnd:yyyy-MM-dd}") ?? new List<CashClosingDto>();
    }

    private async Task LoadCnamRecovery()
    {
        cnamRecovery = await Http.GetFromJsonAsync<List<CnamRecoveryDto>>($"api/finance/cnam-recovery?start={cashStart:yyyy-MM-dd}&end={cashEnd:yyyy-MM-dd}") ?? new List<CnamRecoveryDto>();
    }

    private async Task LoadAdvanceData()
    {
        if (selectedPatientId <= 0)
        {
            advanceTransactions = new();
            patientFinance = null;
            patientSummary = null;
            return;
        }

        advanceTransactions = await Http.GetFromJsonAsync<List<AdvanceTransactionDto>>($"api/finance/advance-transactions/patient/{selectedPatientId}") ?? new List<AdvanceTransactionDto>();
        patientFinance = await Http.GetFromJsonAsync<PatientFinanceDto>($"api/finance/patient-finance/{selectedPatientId}");
        patientSummary = await Http.GetFromJsonAsync<PatientFinancialSummaryDto>($"api/finance/patient-summary/{selectedPatientId}");
    }

    private async Task LoadAllTransactions()
    {
        allTransactions = await Http.GetFromJsonAsync<List<AdvanceTransactionDto>>("api/finance/advance-transactions") ?? new List<AdvanceTransactionDto>();
    }

    private async Task LoadAdvanceLots()
    {
        if (selectedPatientId <= 0)
        {
            advanceLots = new();
            return;
        }

        advanceLots = await Http.GetFromJsonAsync<List<AdvanceLotDto>>($"api/finance/advance-lots/patient/{selectedPatientId}") ?? new List<AdvanceLotDto>();
    }

    private async Task LoadPaymentProjections()
    {
        if (selectedPatientId <= 0)
        {
            paymentProjections = new();
            return;
        }

        paymentProjections = await Http.GetFromJsonAsync<List<PaymentProjectionEntryDto>>($"api/finance/payment-projections/patient/{selectedPatientId}") ?? new List<PaymentProjectionEntryDto>();
    }

    private async Task LoadMonthlyStats()
    {
        errorMessage = null;
        try
        {
            monthlyStatsRange.Clear();
            monthlyStats = await Http.GetFromJsonAsync<MonthlyFinanceStatsDto>($"api/finance/monthly-stats?year={statsStartYear}&month={statsStartMonth}");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            monthlyStats = null;
        }
    }

    private async Task LoadMonthlyStatsRange()
    {
        errorMessage = null;
        try
        {
            monthlyStats = null;
            monthlyStatsRange = await Http.GetFromJsonAsync<List<MonthlyFinanceStatsDto>>($"api/finance/monthly-stats/range?startYear={statsStartYear}&startMonth={statsStartMonth}&endYear={statsEndYear}&endMonth={statsEndMonth}") ?? new List<MonthlyFinanceStatsDto>();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            monthlyStatsRange = new();
        }
    }

    private async Task LoadPatientHistory()
    {
        if (selectedPatientId <= 0)
        {
            patientHistory = new();
            return;
        }

        try
        {
            patientHistory = await Http.GetFromJsonAsync<List<FinancialHistoryEntryDto>>($"api/finance/patient-history/{selectedPatientId}") ?? new List<FinancialHistoryEntryDto>();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            patientHistory = new();
        }
    }

    private async Task FilterFinance()
    {
        await LoadFinanceData();
    }

    private async Task ResetFilters()
    {
        selectedPatientId = 0;
        patientSearch = string.Empty;
        cashStart = DateTime.Today.AddDays(-7);
        cashEnd = DateTime.Today;
        await LoadFinanceData();
    }

    private async Task SetSection(FinanceSection section)
    {
        activeSection = section;
        if (section == FinanceSection.Transactions && AuthService.CurrentUser?.Role == "admin")
        {
            await LoadAllTransactions();
        }
        if ((section == FinanceSection.Advances || section == FinanceSection.Projections) && selectedPatientId > 0)
        {
            await LoadFinanceData();
        }
        if (section == FinanceSection.Stats)
        {
            await LoadMonthlyStats();
        }
        if (section == FinanceSection.History && selectedPatientId > 0)
        {
            await LoadPatientHistory();
        }
    }

    private async Task ValidateCashClosing()
    {
        errorMessage = null;
        try
        {
            cashClosingRequest.ValidatedBy = AuthService.CurrentUser?.Username ?? "Web";
            var response = await Http.PostAsJsonAsync("api/finance/cash-closings", cashClosingRequest);
            if (response.IsSuccessStatusCode)
            {
                await LoadCashClosings();
                await ShowSuccessMessage("Caisse enregistrée avec succès.");
            }
            else
            {
                errorMessage = "Impossible de valider la caisse.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task EditCashClosing(CashClosingDto row)
    {
        cashClosingRequest.DateJour = row.DateJour;
        cashClosingRequest.ActualAmount = row.ActualAmount;
        cashClosingRequest.ValidatedBy = row.ValidatedBy;
        await SetSection(FinanceSection.Cash);
    }

    private async Task DeleteCashClosing(DateTime dateJour)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Supprimer cette clôture de caisse ?"))
        {
            return;
        }

        var response = await Http.DeleteAsync($"api/finance/cash-closings/{dateJour:yyyy-MM-dd}");
        if (response.IsSuccessStatusCode)
        {
            await LoadCashClosings();
            await ShowSuccessMessage("Clôture de caisse supprimée.");
        }
        else
        {
            errorMessage = "Impossible de supprimer la clôture de caisse.";
        }
    }

    private async Task CreateOrUpdateAdvance()
    {
        errorMessage = null;
        if (selectedPatientId <= 0)
        {
            errorMessage = "Sélectionnez un patient avant d'enregistrer une avance.";
            return;
        }

        if (advanceRequest.Amount <= 0)
        {
            errorMessage = "Entrez un montant d'avance valide.";
            return;
        }

        try
        {
            advanceRequest.PatientId = selectedPatientId;
            advanceRequest.TransactionDate = DateTime.UtcNow;
            advanceRequest.CreatedBy = AuthService.CurrentUser?.Username ?? "Web";

            if (isEditingAdvance)
            {
                var response = await Http.PutAsJsonAsync($"api/finance/advance-transactions/{editingAdvanceTransactionId}", advanceRequest);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = "Impossible de modifier l'avance.";
                    return;
                }
                await ShowSuccessMessage("Avance modifiée.");
            }
            else
            {
                var response = await Http.PostAsJsonAsync("api/finance/advance-transactions", advanceRequest);
                if (!response.IsSuccessStatusCode)
                {
                    errorMessage = "Impossible d'enregistrer l'avance.";
                    return;
                }
                await ShowSuccessMessage("Avance enregistrée.");
            }

            await LoadFinanceData();
            ResetAdvanceForm();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void BeginEditAdvance(AdvanceTransactionDto transaction)
    {
        selectedPatientId = transaction.PatientId;
        advanceRequest.Amount = transaction.Amount;
        advanceRequest.Note = transaction.Note;
        advanceRequest.TransactionDate = transaction.TransactionDate;
        advanceRequest.CreatedBy = transaction.CreatedBy;
        isEditingAdvance = true;
        editingAdvanceTransactionId = transaction.Id;
    }

    private async Task DeleteAdvanceTransaction(int transactionId)
    {
        if (!await JSRuntime.InvokeAsync<bool>("confirm", "Annuler cette avance ?"))
        {
            return;
        }

        try
        {
            var response = await Http.DeleteAsync($"api/finance/advance-transactions/{transactionId}");
            if (response.IsSuccessStatusCode)
            {
                await LoadFinanceData();
                await LoadAllTransactions();
                await ShowSuccessMessage("Avance annulée.");
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                errorMessage = "Accès refusé pour annuler cette avance.";
            }
            else if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                errorMessage = "L'avance est introuvable ou a déjà été supprimée.";
                await LoadFinanceData();
                await LoadAllTransactions();
            }
            else
            {
                errorMessage = "Impossible d'annuler l'avance.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Erreur lors de la suppression de l'avance : " + ex.Message;
        }
    }

    private async Task OnPatientSelected(int patientId)
    {
        selectedPatientId = patientId;
        advanceTransactions = new();
        patientFinance = null;
        advanceLots = new();
        paymentProjections = new();

        if (selectedPatientId > 0)
        {
            await LoadAdvanceData();
            await LoadAdvanceLots();
            await LoadPaymentProjections();
        }
    }

    private async Task EditTransaction(AdvanceTransactionDto transaction)
    {
        selectedPatientId = transaction.PatientId;
        await LoadFinanceData();
        BeginEditAdvance(transaction);
        await SetSection(FinanceSection.Advances);
    }

    private void FilterPatients()
    {
    }

    private void ResetAdvanceForm()
    {
        isEditingAdvance = false;
        editingAdvanceTransactionId = 0;
        advanceRequest = new AdvanceTransactionRequestDto { TransactionDate = DateTime.UtcNow, Amount = 0, CreatedBy = AuthService.CurrentUser?.Username ?? "Web" };
    }

    private decimal GetUsedAdvanceAmount() => Math.Max(0, (advanceTransactions?.Sum(a => a.Amount) ?? 0m) - (patientFinance?.AdvanceBalance ?? 0m));

    private async Task ExportCsv<T>(IEnumerable<T> items, string filename)
    {
        var csv = GenerateCsv(items);
        var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
        var base64 = Convert.ToBase64String(bytes);
        await JSRuntime.InvokeVoidAsync("downloadFile", filename, base64);
    }

    private static string GenerateCsv<T>(IEnumerable<T> items)
    {
        var props = typeof(T).GetProperties();
        var csvBuilder = new System.Text.StringBuilder();
        csvBuilder.AppendLine(string.Join(',', props.Select(p => p.Name)));
        foreach (var item in items)
        {
            var values = props.Select(p => EscapeCsvValue(p.GetValue(item)?.ToString() ?? string.Empty));
            csvBuilder.AppendLine(string.Join(',', values));
        }
        return csvBuilder.ToString();
    }

    private static string EscapeCsvValue(string value)
    {
        if (value.Contains(',') || value.Contains('"') || value.Contains('\n'))
        {
            return '"' + value.Replace("\"", "\"\"") + '"';
        }
        return value;
    }

    private async Task ShowSuccessMessage(string message)
    {
        successMessageCts?.Cancel();
        successMessage = message;
        StateHasChanged();

        successMessageCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(5000, successMessageCts.Token);
            successMessage = null;
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void DismissSuccessMessage()
    {
        successMessageCts?.Cancel();
        successMessage = null;
    }

    private string GetEcartClass(decimal diff)
    {
        if (diff == 0m) return "table-success";
        if (Math.Abs(diff) <= 10m) return "table-warning";
        return "table-danger";
    }

    private decimal TotalCashExpected => cashClosings.Sum(c => c.ExpectedAmount);
    private decimal TotalCashActual => cashClosings.Sum(c => c.ActualAmount);
    private decimal TotalCashDiff => cashClosings.Sum(c => c.Diff);
    private decimal TotalAdvances => advanceTransactions.Sum(a => a.Amount);
    private decimal TotalCnamRecovered => cnamRecovery.Sum(c => c.MontantCnam);

    private string GetPatientName(int patientId)
    {
        var patient = patients.FirstOrDefault(p => p.Id == patientId);
        return patient is null ? string.Empty : $"{patient.Nom} {patient.Prenom}".Trim();
    }

    private enum FinanceSection
    {
        Cash,
        Advances,
        Projections,
        Cnam,
        Transactions,
        Stats,
        History
    }
}
