@page "/cnam"
@using MonKineBlazor.Shared.Models
@using System.Net.Http.Json
@inject HttpClient Http

<h1>CNAM</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

<div class="row mb-4">
    <div class="col-md-12 d-flex flex-wrap gap-2">
        <button class="btn btn-primary" @onclick="LoadCnamRecovery">Rafraîchir</button>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Recouvrement CNAM</div>
    <div class="card-body">
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label class="form-label">Du</label>
                <InputDate class="form-control" @bind-Value="cnamStart" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Au</label>
                <InputDate class="form-control" @bind-Value="cnamEnd" />
            </div>
            <div class="col-12 d-flex gap-2 mt-2">
                <button class="btn btn-success" @onclick="LoadCnamRecovery">Calculer</button>
                <button class="btn btn-outline-secondary" @onclick="LoadCnamRecovery">Recharger</button>
            </div>
        </div>

        @if (!cnamRecovery.Any())
        {
            <div class="alert alert-info">Aucun recouvrement CNAM trouvé pour cette période.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-striped">
                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>Couverture</th>
                            <th>Nb séances</th>
                            <th>Montant CNAM</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in cnamRecovery)
                        {
                            <tr>
                                <td>@row.PatientName</td>
                                <td>@row.Couverture</td>
                                <td>@row.NbSeances</td>
                                <td>@($"{row.MontantCnam:F2} DT")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="mt-3">
                <strong>Total CNAM à réclamer:</strong> @($"{cnamRecovery.Sum(r => r.MontantCnam):F2} DT")
            </div>
        }
    </div>
</div>

@code {
    private string? errorMessage;
    private List<CnamRecoveryDto> cnamRecovery = new();
    private DateTime cnamStart = DateTime.Today.AddDays(-30);
    private DateTime cnamEnd = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        await LoadCnamRecovery();
    }

    private async Task LoadCnamRecovery()
    {
        errorMessage = null;
        try
        {
            cnamRecovery = await Http.GetFromJsonAsync<List<CnamRecoveryDto>>($"api/finance/cnam-recovery?start={cnamStart:yyyy-MM-dd}&end={cnamEnd:yyyy-MM-dd}") ?? new List<CnamRecoveryDto>();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }
}
