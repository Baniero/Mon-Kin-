@page "/cnam"
@using MonKineBlazor.Shared.Models
@using System.Net.Http.Json
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<h1>CNAM</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="mb-4">
    <div class="btn-group" role="group">
        <button class="btn btn-icon @(activeSection == CnamSection.Recovery ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetSection(CnamSection.Recovery)"><i class="bi bi-wallet2"></i>Recouvrement</button>
        <button class="btn btn-icon @(activeSection == CnamSection.Invoice ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetSection(CnamSection.Invoice)"><i class="bi bi-receipt"></i>Facture séance</button>
        <button class="btn btn-icon @(activeSection == CnamSection.Bordereau ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetSection(CnamSection.Bordereau)"><i class="bi bi-file-earmark-spreadsheet"></i>Bordereau CNAM</button>
    </div>
</div>

<div class="card section-card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Du</label>
                <InputDate class="form-control" @bind-Value="cnamStart" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Au</label>
                <InputDate class="form-control" @bind-Value="cnamEnd" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary btn-icon w-100" @onclick="RefreshCurrentSection"><i class="bi bi-arrow-repeat"></i>Charger</button>
            </div>
            <div class="col-md-3 text-end">
                <span class="badge-soft">Période active</span>
            </div>
        </div>
    </div>
</div>

@if (activeSection == CnamSection.Recovery)
{
    <div class="card section-card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Recouvrement CNAM</span>
            <span class="badge-soft">Rapide</span>
        </div>
        <div class="card-body">
            @if (!cnamRecovery.Any())
            {
                <div class="alert alert-info">Aucun recouvrement CNAM trouvé pour cette période.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Patient</th>
                                <th>Couverture</th>
                                <th>Nb séances</th>
                                <th>Montant CNAM</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in cnamRecovery)
                            {
                                <tr>
                                    <td>@row.PatientName</td>
                                    <td>@row.Couverture</td>
                                    <td>@row.NbSeances</td>
                                    <td>@($"{row.MontantCnam:F2} DT")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <strong>Total CNAM à réclamer :</strong> @($"{cnamRecovery.Sum(r => r.MontantCnam):F2} DT")
                </div>
            }
        </div>
    </div>
}

@if (activeSection == CnamSection.Invoice)
{
    <div class="card section-card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Facture séance CNAM</span>
            <button class="btn btn-outline-secondary btn-icon" @onclick="ExportInvoicePdf" disabled="@(selectedProgram == null)"><i class="bi bi-file-earmark-pdf"></i>Exporter PDF</button>
        </div>
        <div class="card-body">
            @if (!cnamPrograms.Any())
            {
                <div class="alert alert-info">Cliquez sur "Charger" pour lister les programmes CNAM démarrés.</div>
            }
            else
            {
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Patient</th>
                                <th>N° assurée</th>
                                <th>Date début</th>
                                <th>Total TTC</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in cnamPrograms)
                            {
                                <tr class="@(selectedProgram?.ProgramId == item.ProgramId ? "table-active" : string.Empty)">
                                    <td>@item.PatientName</td>
                                    <td>@item.NumeroAssuree</td>
                                    <td>@item.DateDebut?.ToString("yyyy-MM-dd")</td>
                                    <td>@($"{item.PrixTTC:F2} DT")</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-primary" @onclick="() => SelectProgram(item)">Sélectionner</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (selectedProgram != null)
            {
                <div class="border rounded p-3">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h5>Cabinet</h5>
                            <p class="mb-1"><strong>Nom :</strong> @cabinetInfo.NomCabinet</p>
                            <p class="mb-1"><strong>CNAM :</strong> @cabinetInfo.CodeEtablissement</p>
                            <p class="mb-1"><strong>Responsable :</strong> @(string.IsNullOrWhiteSpace(cabinetInfo.NomEtablissement) ? (string.IsNullOrWhiteSpace(cabinetInfo.Qualite) ? "" : cabinetInfo.Qualite) : cabinetInfo.NomEtablissement)</p>
                            <p class="mb-1"><strong>Matricule fiscal :</strong> @cabinetInfo.MatriculeFiscal</p>
                            <p class="mb-1"><strong>N° EMPLOYEUR :</strong> @cabinetInfo.NumeroEmployeur</p>
                            <p class="mb-0"><strong>Code CNAM :</strong> @cabinetInfo.CodeCnam</p>
                        </div>
                        <div class="col-md-6">
                            <h5>Facture</h5>
                            <p class="mb-1"><strong>N° facture :</strong> @invoiceNumber</p>
                            <p class="mb-0"><strong>Date facture :</strong> @invoiceDate</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6>Assurée</h6>
                            <p class="mb-1"><strong>Patient :</strong> @selectedProgram.PatientName</p>
                            @if (!string.IsNullOrWhiteSpace(selectedProgram.NumeroAssuree))
                            {
                                <p class="mb-1"><strong>N° assurée :</strong> @selectedProgram.NumeroAssuree</p>
                            }
                            <p class="mb-1"><strong>Code patient :</strong> @selectedProgram.CodePatient</p>
                            <p class="mb-0"><strong>Couverture :</strong> @selectedProgram.Couverture</p>
                        </div>
                        <div class="col-md-6">
                            <h6>Séance</h6>
                            <p class="mb-1"><strong>Nature :</strong> @selectedProgram.NatureSeances</p>
                            <p class="mb-1"><strong>N° décision :</strong> @($"{selectedProgram.CodeBureau}/{selectedProgram.Annee}/{selectedProgram.NumeroDecision}")</p>
                            <p class="mb-1"><strong>Date début :</strong> @selectedProgram.DateDebut?.ToString("yyyy-MM-dd")</p>
                            <p class="mb-1"><strong>Date fin :</strong> @selectedProgram.DateFin?.ToString("yyyy-MM-dd")</p>
                            <p class="mb-1"><strong>Nb séances :</strong> @selectedProgram.NbSeances</p>
                            <p class="mb-1"><strong>Durée séance :</strong> @selectedProgram.DureeSeanceMinutes min</p>
                            <p class="mb-1"><strong>Prix unitaire :</strong> @($"{selectedProgram.PrixUnitaire:F2} DT")</p>
                            <p class="mb-0"><strong>Total TTC :</strong> @($"{selectedProgram.PrixTTC:F2} DT")</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(selectedProgram.NumeroAssuree))
                    {
                        <div class="row mb-3">
                            <div class="col-md-4"><strong>Code bordereau :</strong> @selectedProgram.CodeBureau</div>
                            <div class="col-md-4"><strong>Année :</strong> @selectedProgram.Annee</div>
                            <div class="col-md-4"><strong>N° décision :</strong> @selectedProgram.NumeroDecision</div>
                        </div>
                        <div class="row">
                            <div class="col-md-6"><strong>N° ordre :</strong> @selectedProgram.NumeroOrdre</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@if (activeSection == CnamSection.Bordereau)
{
    <div class="card section-card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Bordereau CNAM</span>
            <div>
                <button type="button" class="btn btn-outline-secondary btn-icon me-2" @onclick="ExportBordereauPdf" disabled="@(!HasSelectedBordereau)"><i class="bi bi-file-earmark-pdf"></i>Exporter Bordereau</button>
                <button type="button" class="btn btn-outline-secondary btn-icon" @onclick="ExportBordereauTxt" disabled="@(!HasSelectedBordereau)"><i class="bi bi-file-earmark-text"></i>Exporter TXT</button>
            </div>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Factures à exécuter</h5>
                <div>
                    <button class="btn btn-primary btn-icon me-2" @onclick="ExecuteSelectedBordereau" disabled="@(!HasSelectedBordereau)"><i class="bi bi-check2-circle"></i>Exécuter la sélection</button>
                    <button class="btn btn-outline-secondary btn-icon" @onclick="ClearBordereauSelection" disabled="@(!HasSelectedBordereau)"><i class="bi bi-x-circle"></i>Désélectionner</button>
                </div>
            </div>
            @if (!cnamBordereau.Any())
            {
                <div class="alert alert-info">Aucune facture à exécuter pour cette durée.</div>
            }
            else
            {
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th style="width: 40px"></th>
                                <th>Programme</th>
                                <th>N° facture</th>
                                <th>Date facture</th>
                                <th>N° assurée</th>
                                <th>Patient</th>
                                <th>Total TTC</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in cnamBordereau)
                            {
                                <tr>
                                    <td>
                                        <input class="form-check-input" type="checkbox" checked="@IsSelectedBordereau(row.ProgramId)" @onchange="e => ToggleBordereauSelection(row.ProgramId, e)" />
                                    </td>
                                    <td>@row.ProgramId</td>
                                    <td>@row.FactureNumber</td>
                                    <td>@row.DateFacture?.ToString("dd/MM/yyyy")</td>
                                    <td>@row.NumeroAssuree</td>
                                    <td>@row.PatientName</td>
                                    <td>@($"{row.TotalTTC:F2} DT")</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-success btn-icon" @onclick="() => ExecuteBordereau(row)"><i class="bi bi-play-circle"></i>Exécuter</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <strong>Total général TTC :</strong> @($"{cnamBordereau.Sum(r => r.TotalTTC):F2} DT")
                </div>
            }
        </div>
    </div>

    <div class="card section-card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Bordereau exécuté</span>
            <span class="badge-soft">Historique</span>
        </div>
        <div class="card-body">
            @if (!ExecutedBordereaux.Any())
            {
                <div class="alert alert-info">Aucun bordereau exécuté pour cette période.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>N° bordereau</th>
                                <th>Nb factures</th>
                                <th>Total TTC</th>
                                <th>Date exécution</th>
                                <th>Exécuté par</th>
                                <th>Encaisse</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bordereau in ExecutedBordereaux)
                            {
                                <tr>
                                    <td>@bordereau.BordereauNumber</td>
                                    <td>@bordereau.NbFactures</td>
                                    <td>@($"{bordereau.TotalTTC:F2} DT")</td>
                                    <td>@bordereau.ExecutedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@bordereau.ExecutedBy</td>
                                    <td>@(bordereau.IsEncaisse ? "Oui" : "Non")</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ExportExecutedBordereauPdf(bordereau.BordereauNumber)">Exporter Bordereau</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ExportExecutedBordereauTxt(bordereau.BordereauNumber)">Exporter TXT</button>
                                        <button type="button" class="btn btn-sm btn-info me-1" @onclick="() => ToggleEncaisseStatus(bordereau.BordereauNumber, !bordereau.IsEncaisse)">@(bordereau.IsEncaisse ? "Marquer non encaissé" : "Marquer encaissé")</button>
                                        <button type="button" class="btn btn-sm btn-warning me-1" @onclick="() => CancelExecutedBordereau(bordereau.BordereauNumber)">Annuler exécution</button>
                                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => DeleteExecutedBordereau(bordereau.BordereauNumber)">Supprimer définitivement</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@code {
    private string? errorMessage;
    private string? successMessage;
    private CnamSection activeSection = CnamSection.Recovery;
    private List<CnamRecoveryDto> cnamRecovery = new();
    private List<CnamProgramInvoiceDto> cnamPrograms = new();
    private List<CnamBordereauEntryDto> cnamBordereau = new();
    private List<CnamBordereauEntryDto> cnamBordereauExecuted = new();
    private HashSet<int> selectedBordereauProgramIds = new();
    private CnamProgramInvoiceDto? selectedProgram;
    private CabinetInfoDto cabinetInfo = new();

    private IEnumerable<ExecutedBordereauSummary> ExecutedBordereaux => cnamBordereauExecuted
        .Where(r => r.BordereauNumber.HasValue)
        .GroupBy(r => r.BordereauNumber!.Value)
        .Select(g => new ExecutedBordereauSummary
        {
            BordereauNumber = g.Key,
            NbFactures = g.Count(),
            TotalTTC = g.Sum(x => x.TotalTTC),
            ExecutedAt = g.Max(x => x.ExecutedAt),
            ExecutedBy = g.Select(x => x.ExecutedBy).FirstOrDefault() ?? string.Empty,
            IsEncaisse = g.Any(x => x.IsEncaisse)
        })
        .OrderByDescending(g => g.BordereauNumber);

    private class ExecutedBordereauSummary
    {
        public int BordereauNumber { get; set; }
        public int NbFactures { get; set; }
        public decimal TotalTTC { get; set; }
        public DateTime? ExecutedAt { get; set; }
        public string? ExecutedBy { get; set; }
        public bool IsEncaisse { get; set; }
    }
    private DateTime cnamStart = DateTime.Today.AddDays(-30);
    private DateTime cnamEnd = DateTime.Today;
    private string invoiceDate => DateTime.Today.ToString("yyyy-MM-dd");

    private string invoiceNumber => selectedProgram?.FactureNumber ?? string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadCabinetInfo();
        await LoadCnamRecovery();
    }

    private async Task SetSection(CnamSection section)
    {
        activeSection = section;
        successMessage = null;
        errorMessage = null;
        selectedProgram = null;

        if (section == CnamSection.Invoice)
        {
            await LoadCnamPrograms();
        }
        else if (section == CnamSection.Bordereau)
        {
            await LoadCnamBordereau();
        }
    }

    private async Task RefreshCurrentSection()
    {
        errorMessage = null;
        successMessage = null;

        if (activeSection == CnamSection.Recovery)
        {
            await LoadCnamRecovery();
        }
        else if (activeSection == CnamSection.Invoice)
        {
            await LoadCnamPrograms();
        }
        else if (activeSection == CnamSection.Bordereau)
        {
            await LoadCnamBordereau();
        }
    }

    private async Task LoadCabinetInfo()
    {
        try
        {
            var cabinets = await Http.GetFromJsonAsync<List<CabinetDto>>("api/cabinets") ?? new List<CabinetDto>();
            var cabinet = cabinets.FirstOrDefault();
            cabinetInfo = cabinet != null
                ? new CabinetInfoDto
                {
                    Id = cabinet.Id,
                    NomCabinet = cabinet.NomCabinet,
                    NumeroEmployeur = cabinet.NumeroEmployeur,
                    CodeCnam = cabinet.CodeCnam,
                    Qualite = cabinet.Qualite,
                    CodeEtablissement = cabinet.CodeEtablissement,
                    MatriculeFiscal = cabinet.MatriculeFiscal,
                    NomEtablissement = cabinet.NomEtablissement,
                    AdresseCabinet = cabinet.AdresseCabinet,
                    NomCabinetArabe = cabinet.NomCabinetArabe,
                    NomKineArabe = cabinet.NomKineArabe,
                    AdresseKineArabe = cabinet.AdresseKineArabe,
                    Telephone = cabinet.Telephone,
                    Rib = cabinet.Rib
                }
                : new CabinetInfoDto();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadCnamRecovery()
    {
        try
        {
            cnamRecovery = await Http.GetFromJsonAsync<List<CnamRecoveryDto>>($"api/finance/cnam-recovery?start={cnamStart:yyyy-MM-dd}&end={cnamEnd:yyyy-MM-dd}") ?? new List<CnamRecoveryDto>();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadCnamPrograms()
    {
        try
        {
            cnamPrograms = await Http.GetFromJsonAsync<List<CnamProgramInvoiceDto>>($"api/finance/cnam-programs?start={cnamStart:yyyy-MM-dd}&end={cnamEnd:yyyy-MM-dd}") ?? new List<CnamProgramInvoiceDto>();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private async Task LoadCnamBordereau()
    {
        selectedBordereauProgramIds.Clear();

        try
        {
            cnamBordereau = await Http.GetFromJsonAsync<List<CnamBordereauEntryDto>>($"api/finance/cnam-bordereau?start={cnamStart:yyyy-MM-dd}&end={cnamEnd:yyyy-MM-dd}") ?? new List<CnamBordereauEntryDto>();
            cnamBordereauExecuted = await Http.GetFromJsonAsync<List<CnamBordereauEntryDto>>($"api/finance/cnam-bordereau-executed?start={cnamStart:yyyy-MM-dd}&end={cnamEnd:yyyy-MM-dd}") ?? new List<CnamBordereauEntryDto>();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    private void SelectProgram(CnamProgramInvoiceDto program)
    {
        selectedProgram = program;
    }

    private async Task ExportInvoicePdf()
    {
        if (selectedProgram == null)
        {
            errorMessage = "Sélectionnez un programme avant d'exporter la facture.";
            return;
        }

        errorMessage = null;
        successMessage = null;

        var montantHT = selectedProgram.PrixTTC / 1.07m;
        var montantTVA = selectedProgram.PrixTTC - montantHT;

        var pdfData = new
        {
            cabinet = cabinetInfo,
            invoiceNumber,
            invoiceDate,
            program = new
            {
                selectedProgram.ProgramId,
                selectedProgram.PatientId,
                selectedProgram.PatientName,
                selectedProgram.CodePatient,
                selectedProgram.NumeroAssuree,
                selectedProgram.Couverture,
                selectedProgram.Titre,
                selectedProgram.NatureSeances,
                selectedProgram.DateDebut,
                selectedProgram.DateFin,
                selectedProgram.NbSeances,
                selectedProgram.DureeSeanceMinutes,
                selectedProgram.PrixUnitaire,
                selectedProgram.PrixTTC,
                selectedProgram.CodeBureau,
                selectedProgram.Annee,
                selectedProgram.NumeroDecision,
                selectedProgram.NumeroOrdre,
                selectedProgram.FactureNumber,
                MontantHT = montantHT,
                MontantTVA = montantTVA
            }
        };

        try
        {
            await JSRuntime.InvokeVoidAsync("generateInvoicePdf", $"facture_cnam_{selectedProgram.ProgramId}_{DateTime.Today:yyyyMMdd}.pdf", pdfData);
            successMessage = "Facture PDF générée.";
        }
        catch (JSException jsEx)
        {
            errorMessage = $"Erreur PDF : {jsEx.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors de l'export PDF : {ex.Message}";
        }
    }

    private async Task ExportBordereauPdf()
    {
        if (!HasSelectedBordereau)
        {
            errorMessage = "Sélectionnez au moins une facture pour exporter le bordereau.";
            return;
        }

        var selectedRows = cnamBordereau
            .Where(r => selectedBordereauProgramIds.Contains(r.ProgramId))
            .ToList();

        if (!selectedRows.Any())
        {
            errorMessage = "Aucune ligne sélectionnée trouvée pour l'export.";
            return;
        }

        errorMessage = null;
        successMessage = null;

        var totalTTC = selectedRows.Sum(r => r.TotalTTC);
        var totalHT = totalTTC / 1.07m;
        var totalTVA = totalTTC - totalHT;
        var bordereauReference = $"SEL-{selectedRows.Count:000}";

        var pdfData = new
        {
            cabinet = cabinetInfo,
            title = $"Bordereau CNAM N° {bordereauReference}",
            summary = new
            {
                Date = DateTime.Today.ToString("dd/MM/yyyy"),
                Centre = cabinetInfo.NomEtablissement ?? string.Empty,
                BordereauNumber = bordereauReference,
                MontantHT = totalHT,
                Annee = cnamStart.Year.ToString(),
                NbFactures = selectedRows.Count,
                MontantTotalTTC = totalTTC,
                MontantTVA = totalTVA
            },
            rows = selectedRows.Select(r => new
            {
                r.FactureNumber,
                DateFacture = r.DateFacture?.ToString("dd/MM/yyyy"),
                PriseEnCharge = r.CodePatient ?? string.Empty,
                r.NumeroAssuree,
                r.PatientName,
                r.CodeBureau,
                r.Annee,
                r.NumeroDecision,
                r.Racine,
                r.Cle,
                MontantHT = r.TotalTTC / 1.07m,
                MontantTVA = r.TotalTTC - (r.TotalTTC / 1.07m),
                MontantTTC = r.TotalTTC
            }).ToList()
        };

        try
        {
            await JSRuntime.InvokeVoidAsync("generateBordereauPdf", $"bordereau_cnam_selected_{DateTime.Today:yyyyMMdd}.pdf", pdfData);
            successMessage = "Bordereau PDF généré.";
        }
        catch (JSException jsEx)
        {
            errorMessage = $"Erreur PDF : {jsEx.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors de l'export PDF : {ex.Message}";
        }
    }

    private async Task ExportBordereauTxt()
    {
        if (!HasSelectedBordereau)
        {
            errorMessage = "Sélectionnez au moins une facture pour exporter le bordereau.";
            return;
        }

        var selectedIds = selectedBordereauProgramIds.ToList();
        if (!selectedIds.Any())
        {
            errorMessage = "Aucune ligne sélectionnée trouvée pour l'export.";
            return;
        }

        errorMessage = null;
        successMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/finance/cnam-bordereau-execute-bulk", new { ProgramIds = selectedIds });
            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"Impossible d'exécuter la sélection pour générer le bordereau : {response.ReasonPhrase}";
                return;
            }

            var executedRows = await response.Content.ReadFromJsonAsync<List<CnamBordereauEntryDto>>() ?? new List<CnamBordereauEntryDto>();
            if (!executedRows.Any())
            {
                errorMessage = "Aucune ligne n'a été exécutée pour générer le bordereau.";
                return;
            }

            var bordereauNumber = executedRows.Select(r => r.BordereauNumber).FirstOrDefault();
            if (!bordereauNumber.HasValue)
            {
                errorMessage = "Impossible de déterminer le numéro du bordereau généré.";
                return;
            }

            var textContent = await Http.GetStringAsync($"api/finance/cnam-bordereau-text?start={cnamStart:yyyy-MM-dd}&end={cnamEnd:yyyy-MM-dd}&bordereauNumber={bordereauNumber.Value}");
            var filename = $"bordereau_cnam_{bordereauNumber.Value:000}_{DateTime.Today:yyyyMMdd}.txt";
            await JSRuntime.InvokeVoidAsync("downloadTextFile", filename, textContent, "text/plain;charset=utf-8");

            successMessage = $"Fichier texte bordereau généré avec le numéro {bordereauNumber.Value:000}.";
            await LoadCnamBordereau();
        }
        catch (HttpRequestException httpEx)
        {
            errorMessage = $"Erreur lors de l'appel au serveur : {httpEx.Message}";
        }
        catch (JSException jsEx)
        {
            errorMessage = $"Erreur lors de la génération du fichier texte : {jsEx.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur inattendue : {ex.Message}";
        }
    }

    private async Task ExportExecutedBordereauPdf(int bordereauNumber)
    {
        errorMessage = null;
        successMessage = null;

        var groupedRows = cnamBordereauExecuted.Where(r => r.BordereauNumber == bordereauNumber).ToList();
        if (!groupedRows.Any())
        {
            errorMessage = "Aucune ligne de ce bordereau n'a été trouvée.";
            return;
        }

        var totalTTC = groupedRows.Sum(r => r.TotalTTC);
        var totalHT = totalTTC / 1.07m;
        var totalTVA = totalTTC - totalHT;
        var bordereauReference = $"BOR-{bordereauNumber:000}";
        var pdfData = new
        {
            cabinet = cabinetInfo,
            title = $"Bordereau CNAM N° {bordereauReference}",
            summary = new
            {
                Date = DateTime.Today.ToString("dd/MM/yyyy"),
                Centre = cabinetInfo.NomEtablissement ?? string.Empty,
                BordereauNumber = bordereauReference,
                MontantHT = totalHT,
                Annee = cnamStart.Year.ToString(),
                NbFactures = groupedRows.Count,
                MontantTotalTTC = totalTTC,
                MontantTVA = totalTVA
            },
            rows = groupedRows.Select(r => new
            {
                r.FactureNumber,
                DateFacture = r.DateFacture?.ToString("dd/MM/yyyy"),
                PriseEnCharge = r.CodePatient ?? string.Empty,
                r.NumeroAssuree,
                r.PatientName,
                r.CodeBureau,
                r.Annee,
                r.NumeroDecision,
                r.Racine,
                r.Cle,
                MontantHT = r.TotalTTC / 1.07m,
                MontantTVA = r.TotalTTC - (r.TotalTTC / 1.07m),
                MontantTTC = r.TotalTTC
            }).ToList()
        };

        try
        {
            var safeBordereauNumber = SanitizeFileName(bordereauNumber.ToString());
            await JSRuntime.InvokeVoidAsync("generateBordereauPdf", $"bordereau_cnam_executed_{safeBordereauNumber}_{cnamStart:yyyyMMdd}_{cnamEnd:yyyyMMdd}.pdf", pdfData);
            successMessage = "Bordereau PDF exécuté généré.";
        }
        catch (JSException jsEx)
        {
            errorMessage = $"Erreur PDF : {jsEx.Message}";
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors de l'export PDF : {ex.Message}";
        }
    }

