    private bool ValidateCnamForm()
    {
        validationMessage = null;

        if (string.IsNullOrWhiteSpace(createPatient.Nom))
        {
            validationMessage = "Le nom du patient est requis.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(createPatient.Prenom))
        {
            validationMessage = "Le prénom du patient est requis.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(createPatient.Racine))
        {
            validationMessage = "La racine CNAM est requise.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(createPatient.Cle) || createPatient.Cle.Trim().Length < 2)
        {
            validationMessage = "La clé CNAM est requise et doit contenir au moins 2 caractères.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(createPatient.Qualite))
        {
            validationMessage = "La qualité CNAM est requise.";
            return false;
        }

        if (createProgram.NbSeances <= 0)
        {
            validationMessage = "Le nombre de séances doit être supérieur à zéro.";
            return false;
        }

        if (!createProgram.DateDebut.HasValue)
        {
            validationMessage = "La date de début du programme est requise.";
            return false;
        }

        if (createProgram.PrixSeanceTTC <= 0)
        {
            validationMessage = "Le prix séance TTC doit être supérieur à zéro.";
            return false;
        }

        return true;
    }

    private async Task SearchExistingPatients()
    {
