    private static string FormatNumeroAssuree(string? racine, string? cle, string? fallback = null)
    {
        var cleanRacine = string.IsNullOrWhiteSpace(racine) ? string.Empty : racine.Trim();
        var cleanCle = string.IsNullOrWhiteSpace(cle) ? string.Empty : cle.Trim();

        if (!string.IsNullOrEmpty(cleanRacine) && !string.IsNullOrEmpty(cleanCle))
        {
            return $"{cleanRacine}/{cleanCle}";
        }

        return fallback ?? string.Empty;
    }

    private string CreateComputedNumeroAssuree => FormatNumeroAssuree(createPatient.Racine, createPatient.Cle, createPatient.NumeroAssuree);

    private void RecalculateCreateProgram()
    {
        if (createProgram.DateDebut.HasValue && createProgram.NbSeances > 0 && createProgram.NbSeancesParSemaine > 0)
        {
            createProgram.DateFin = GetProgramEndDate(createProgram.DateDebut, createProgram.NbSeances, createProgram.NbSeancesParSemaine);
        }
        else
        {
            createProgram.DateFin = null;
        }

        if (createProgram.PrixSeanceTTC > 0 && createProgram.NbSeances > 0)
        {
            createProgram.PrixTTC = Math.Round(createProgram.NbSeances * createProgram.PrixSeanceTTC, 3);
        }

        if (createProgram.PrixTTC < 0)
        {
            createProgram.PrixTTC = 0;
        }

        if (createProgram.TVA < 0)
        {
            createProgram.TVA = 0;
        }

        if (createProgram.TVA == 0)
        {
            createProgram.PrixHT = Math.Round(createProgram.PrixTTC, 3);
            createProgram.MontantTVA = 0;
        }
        else
        {
            var rate = 1 + (createProgram.TVA / 100m);
            createProgram.PrixHT = Math.Round(createProgram.PrixTTC / rate, 3);
            createProgram.MontantTVA = Math.Round(createProgram.PrixTTC - createProgram.PrixHT, 2);
        }

        createProgram.PrixUnitaire = createProgram.NbSeances > 0
            ? Math.Round(createProgram.PrixHT / createProgram.NbSeances, 3)
            : 0;
    }

    private static DateTime? GetProgramEndDate(DateTime? startDate, int totalSessions, int sessionsPerWeek)
    {
        if (!startDate.HasValue || totalSessions <= 0 || sessionsPerWeek <= 0)
        {
            return startDate;
        }

        var allowedDays = sessionsPerWeek switch
        {
            1 => new[] { DayOfWeek.Monday },
            2 => new[] { DayOfWeek.Monday, DayOfWeek.Thursday },
            3 => new[] { DayOfWeek.Monday, DayOfWeek.Wednesday, DayOfWeek.Friday },
            _ => new[] { DayOfWeek.Monday, DayOfWeek.Wednesday, DayOfWeek.Friday }
        };

        var currentDate = startDate.Value.Date;
        int sessionsScheduled = 0;
        DateTime? lastDate = null;

        while (sessionsScheduled < totalSessions)
        {
            if (allowedDays.Contains(currentDate.DayOfWeek))
            {
                lastDate = currentDate;
                sessionsScheduled++;
                if (sessionsScheduled >= totalSessions)
                {
                    break;
                }
            }

            currentDate = currentDate.AddDays(1);
        }

        return lastDate;
    }

    private static bool IsPlaceholderOrderNumber(string? orderNumber)
    {
        if (string.IsNullOrWhiteSpace(orderNumber))
        {
            return true;
        }

        var trimmed = orderNumber.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            return true;
        }

        if (System.Text.RegularExpressions.Regex.IsMatch(trimmed, @"^[-\s]+(?:/\d{4})?$"))
        {
            return true;
        }

        var parts = trimmed.Split('/');
        if (parts.Length > 0)
        {
            var prefix = parts[0].Trim();
            if (string.IsNullOrWhiteSpace(prefix) || prefix.Trim('-').Length == 0)
            {
                return true;
            }
        }

        return false;
    }

    private static string GetProgramInvoiceNumber(PatientProgramDto program)
    {
        var numeroOrdre = program.NumeroOrdre?.Trim();
        var hasValidNumeroOrdre = !IsPlaceholderOrderNumber(numeroOrdre);

        if (hasValidNumeroOrdre)
        {
            if (!string.IsNullOrWhiteSpace(program.Annee) && !numeroOrdre!.Contains('/'))
            {
                return $"{numeroOrdre}/{program.Annee}";
            }

            return numeroOrdre!;
        }

        if (program.Id > 0 && !string.IsNullOrWhiteSpace(program.Annee))
        {
            return $"{program.Id:00}/{program.Annee}";
        }

        if (program.Id > 0)
        {
            return $"{program.Id:00}/{DateTime.Today.Year}";
        }

        return $"00/{DateTime.Today.Year}";
    }

