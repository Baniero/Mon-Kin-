        createSectionMessage = null;
        validationMessage = null;

        if (string.IsNullOrWhiteSpace(createPatient.Racine) || string.IsNullOrWhiteSpace(createPatient.Cle) || string.IsNullOrWhiteSpace(createPatient.Qualite))
        {
            return;
        }

        isSearchingExistingPatient = true;
        try
        {
            var racine = Uri.EscapeDataString(createPatient.Racine.Trim());
            var cle = Uri.EscapeDataString(createPatient.Cle.Trim());
            var qualite = Uri.EscapeDataString(createPatient.Qualite.Trim());
            existingPatients = await Http.GetFromJsonAsync<List<PatientDto>>($"api/patients/search?racine={racine}&cle={cle}&qualite={qualite}") ?? new List<PatientDto>();
        }
        catch (Exception ex)
        {
            errorMessage = "Erreur lors de la recherche du patient existant : " + ex.Message;
        }
        finally
        {
            isSearchingExistingPatient = false;
            existingPatientSearchPerformed = true;
        }
    }

    private async Task GenerateInvoiceAndSignatureAsync(PatientDto patient, PatientProgramDto program)
    {
        var invoiceNumber = GetProgramInvoiceNumber(program);
        var montantHT = program.PrixTTC / 1.07m;
        var montantTVA = program.PrixTTC - montantHT;

        var invoicePayload = new
        {
            cabinet = cabinetInfo,
            invoiceNumber,
            invoiceDate = DateTime.Today.ToString("yyyy-MM-dd"),
            program = new
            {
                programId = program.Id,
                patientId = program.PatientId,
                patientName = $"{patient.Nom} {patient.Prenom}".Trim(),
                codePatient = patient.CodePatient,
                numeroAssuree = patient.NumeroAssuree,
                couverture = patient.Couverture,
                qualite = patient.Qualite,
                titre = program.Titre,
                natureSeances = program.NatureSeances,
                nbSeances = program.NbSeances,
                dureeSeanceMinutes = program.DureeSeanceMinutes,
                dateDebut = program.DateDebut,
                dateFin = program.DateFin,
                prixUnitaire = program.PrixUnitaire,
                prixTTC = program.PrixTTC,
                codeBureau = program.CodeBureau,
                annee = program.Annee,
                numeroDecision = program.NumeroDecision,
                numeroOrdre = program.NumeroOrdre,
                factureNumber = invoiceNumber,
                MontantHT = montantHT,
                MontantTVA = montantTVA
            }
        };

        await JSRuntime.InvokeVoidAsync("generateInvoicePdf", $"facture_cnam_{program.Id}_{DateTime.Today:yyyyMMdd}.pdf", invoicePayload);

        var signatureRows = BuildSignatureRowsFromProgram(program);
        var signaturePayload = new
        {
            cabinet = cabinetInfo,
            program,
            patient,
            rows = signatureRows
        };

        await JSRuntime.InvokeVoidAsync("generateSignatureSheetPdf", $"fiche_signature_{program.Id}_{patient.CodePatient}.pdf", signaturePayload);
    }

    private List<object> BuildSignatureRowsFromProgram(PatientProgramDto program)
    {
        var rows = new List<object>();
        if (program.NbSeances <= 0 || !program.DateDebut.HasValue || !program.DateFin.HasValue)
        {
            return rows;
        }

        var schedule = new List<DateTime>();
        var allowedDays = program.NbSeancesParSemaine switch
        {
            1 => new[] { DayOfWeek.Monday },
            2 => new[] { DayOfWeek.Monday, DayOfWeek.Thursday },
            3 => new[] { DayOfWeek.Monday, DayOfWeek.Wednesday, DayOfWeek.Friday },
            _ => new[] { DayOfWeek.Monday, DayOfWeek.Wednesday, DayOfWeek.Friday }
        };

        var currentDate = program.DateDebut.Value.Date;
        while (schedule.Count < program.NbSeances && currentDate <= program.DateFin.Value.Date)
        {
            if (allowedDays.Contains(currentDate.DayOfWeek))
            {
                schedule.Add(currentDate);
            }
            currentDate = currentDate.AddDays(1);
        }

        for (int i = 0; i < program.NbSeances; i++)
        {
            rows.Add(new
            {
                Sequence = i + 1,
                Date = i < schedule.Count ? schedule[i].ToString("dd/MM/yyyy") : string.Empty,
                SignaturePatient = string.Empty,
                SignatureKine = string.Empty
            });
        }

        return rows;
    }

