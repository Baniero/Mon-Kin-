    private async Task SaveCnamPatientProgramAsync()
    {
        createSectionMessage = null;
        validationMessage = null;

        if (!ValidateCnamForm())
        {
            return;
        }

        createPatient.Couverture = "CNAM";
        createPatient.NumeroAssuree = CreateComputedNumeroAssuree;
        RecalculateCreateProgram();

        if (existingPatients.Any() && selectedExistingPatient == null)
        {
            validationMessage = "Un patient existant a été trouvé. Sélectionnez-le pour créer la prise en charge ou modifiez la racine/clé/qualité.";
            return;
        }

        isBusy = true;
        try
        {
            if (selectedExistingPatient != null)
            {
                createProgram.PatientId = selectedExistingPatient.Id;
                createProgram.DateFin = GetProgramEndDate(createProgram.DateDebut, createProgram.NbSeances, createProgram.NbSeancesParSemaine);

                await CreateProgramAndPrint(selectedExistingPatient);
                return;
            }

            PatientDto? createdPatient = null;
        try
        {
            var patientResponse = await Http.PostAsJsonAsync("api/patients", createPatient);
            if (!patientResponse.IsSuccessStatusCode)
            {
                createSectionMessage = "Erreur lors de la création du patient.";
                return;
            }

            createdPatient = await patientResponse.Content.ReadFromJsonAsync<PatientDto>();
            if (createdPatient == null)
            {
                createSectionMessage = "Le patient n'a pas pu être créé.";
                return;
            }
        }
        catch (Exception ex)
        {
            createSectionMessage = "Erreur API création patient : " + ex.Message;
            return;
        }

        createProgram.PatientId = createdPatient.Id;
        createProgram.DateFin = GetProgramEndDate(createProgram.DateDebut, createProgram.NbSeances, createProgram.NbSeancesParSemaine);

        PatientProgramDto? createdProgram = null;
        try
        {
            var programResponse = await Http.PostAsJsonAsync("api/patientprograms", createProgram);
            if (!programResponse.IsSuccessStatusCode)
            {
                createSectionMessage = "Patient créé, mais l'ajout du programme a échoué.";
                return;
            }

            createdProgram = await programResponse.Content.ReadFromJsonAsync<PatientProgramDto>();
            if (createdProgram == null)
            {
                createSectionMessage = "Le programme n'a pas pu être créé.";
                return;
            }
        }
        catch (Exception ex)
        {
            createSectionMessage = "Erreur API création programme : " + ex.Message;
            return;
        }

        await GenerateInvoiceAndSignatureAsync(createdPatient, createdProgram);
        createSectionMessage = "Patient et programme CNAM créés avec succès. Facture et fiche signature générées.";
        await LoadCnamPrograms();
    }
    finally
    {
        isBusy = false;
    }

