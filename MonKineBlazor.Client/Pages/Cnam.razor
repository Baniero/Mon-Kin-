@page "/cnam"
@using MonKineBlazor.Shared.Models
@using System.Net.Http.Json
@using Microsoft.JSInterop
@inject HttpClient Http
@inject IJSRuntime JSRuntime

<h1>CNAM</h1>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}
@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="mb-4">
    <div class="btn-group" role="group">
        <button class="btn btn-icon @(activeSection == CnamSection.Recovery ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetSection(CnamSection.Recovery)"><i class="bi bi-wallet2"></i>Recouvrement</button>
        <button class="btn btn-icon @(activeSection == CnamSection.Create ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetSection(CnamSection.Create)"><i class="bi bi-person-plus"></i>Création prise en charge</button>
        <button class="btn btn-icon @(activeSection == CnamSection.Invoice ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetSection(CnamSection.Invoice)"><i class="bi bi-receipt"></i>Facture séance</button>
        <button class="btn btn-icon @(activeSection == CnamSection.Bordereau ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetSection(CnamSection.Bordereau)"><i class="bi bi-file-earmark-spreadsheet"></i>Bordereau CNAM</button>
    </div>
</div>

<div class="card section-card mb-4">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Du</label>
                <InputDate class="form-control" @bind-Value="cnamStart" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Au</label>
                <InputDate class="form-control" @bind-Value="cnamEnd" />
            </div>
            <div class="col-md-3">
                <button class="btn btn-primary btn-icon w-100" @onclick="RefreshCurrentSection"><i class="bi bi-arrow-repeat"></i>Charger</button>
            </div>
            <div class="col-md-3 text-end">
                <span class="badge-soft">Période active</span>
            </div>
        </div>
    </div>
</div>

@if (activeSection == CnamSection.Recovery)
{
    <div class="card section-card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Recouvrement CNAM</span>
            <span class="badge-soft">Rapide</span>
        </div>
        <div class="card-body">
            @if (!cnamRecovery.Any())
            {
                <div class="alert alert-info">Aucun recouvrement CNAM trouvé pour cette période.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Patient</th>
                                <th>Couverture</th>
                                <th>Nb séances</th>
                                <th>Montant CNAM</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in cnamRecovery)
                            {
                                <tr>
                                    <td>@row.PatientName</td>
                                    <td>@row.Couverture</td>
                                    <td>@row.NbSeances</td>
                                    <td>@($"{row.MontantCnam:F2} DT")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <strong>Total CNAM à réclamer :</strong> @($"{cnamRecovery.Sum(r => r.MontantCnam):F2} DT")
                </div>
            }
        </div>
    </div>
}

@if (activeSection == CnamSection.Create)
{
    <div class="card section-card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Création prise en charge</span>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-12">
                    <h5>Patient CNAM</h5>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Code patient</label>
                    <InputText class="form-control" @bind-Value="createPatient.CodePatient" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Numéro dossier</label>
                    <InputText class="form-control" @bind-Value="createPatient.DossierPatient" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Nom</label>
                    <InputText class="form-control" @bind-Value="createPatient.Nom" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Prénom</label>
                    <InputText class="form-control" @bind-Value="createPatient.Prenom" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Racine</label>
                    <InputText class="form-control" @bind-Value="createPatient.Racine" @onchange="_ => SearchExistingPatients()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Clé</label>
                    <InputText class="form-control" @bind-Value="createPatient.Cle" @onchange="_ => SearchExistingPatients()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Qualité</label>
                    <InputSelect class="form-select" @bind-Value="createPatient.Qualite" @onchange="_ => SearchExistingPatients()">
                        <option value="">-- Sélectionnez --</option>
                        <option value="Assuré lui-même">Assuré lui-même</option>
                        <option value="Conjoint">Conjoint</option>
                        <option value="Mère">Mère</option>
                        <option value="Père">Père</option>
                        <option value="Enfant">Enfant</option>
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label">N° assurée</label>
                    <input class="form-control" value="@CreateComputedNumeroAssuree" readonly />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-outline-secondary w-100" @onclick="SearchExistingPatients" disabled="@(isSearchingExistingPatient || isBusy)">
                        @if (isSearchingExistingPatient)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        Rechercher patient CNAM
                    </button>
                </div>
                @if (existingPatientSearchPerformed)
                {
                    <div class="col-md-12">
                        @if (existingPatients.Any())
                        {
                            <div class="alert alert-warning d-flex justify-content-between align-items-center">
                                <span>Patient existant détecté avec la même racine / clé / qualité. Sélectionnez un patient ou modifiez les valeurs.</span>
                                <button class="btn btn-sm btn-primary" @onclick="() => showExistingPatientModal = true">Voir les patients existants</button>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info">Aucun patient existant trouvé avec cette racine, clé et qualité.</div>
                        }
                    </div>
                }
                @if (showExistingPatientModal)
                {
                    <div class="modal-backdrop fade show"></div>
                    <div class="modal d-block" tabindex="-1" style="background: rgba(0,0,0,0.5);">
                        <div class="modal-dialog modal-lg modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title">Patients CNAM existants</h5>
                                    <button type="button" class="btn-close" aria-label="Close" @onclick="() => showExistingPatientModal = false"></button>
                                </div>
                                <div class="modal-body">
                                    @if (!existingPatients.Any())
                                    {
                                        <div class="alert alert-info">Aucun patient à afficher. Modifiez les critères de recherche et relancez la recherche.</div>
                                    }
                                    else
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm table-striped">
                                                <thead>
                                                    <tr>
                                                        <th>Nom</th>
                                                        <th>Prénom</th>
                                                        <th>Code patient</th>
                                                        <th>Qualité</th>
                                                        <th class="text-end">Actions</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var patient in existingPatients)
                                                    {
                                                        <tr>
                                                            <td>@patient.Nom</td>
                                                            <td>@patient.Prenom</td>
                                                            <td>@patient.CodePatient</td>
                                                            <td>@patient.Qualite</td>
                                                            <td class="text-end">
                                                                <button class="btn btn-sm btn-outline-primary me-2" @onclick="() => SelectExistingPatient(patient)">Sélectionner</button>
                                                                <button class="btn btn-sm btn-success" @onclick="() => StartProgramForExistingPatient(patient)">Créer une prise en charge pour ce patient</button>
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                                <div class="modal-footer">
                                    <button class="btn btn-secondary" @onclick="() => showExistingPatientModal = false">Fermer</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                <div class="col-md-12">
                    @if (selectedExistingPatient != null)
                    {
                        <div class="alert alert-success">
                            Patient sélectionné : <strong>@selectedExistingPatient.Nom @selectedExistingPatient.Prenom</strong> - @selectedExistingPatient.CodePatient
                            <button class="btn btn-sm btn-outline-secondary ms-3" @onclick="ClearSelectedExistingPatient">Changer de patient</button>
                        </div>
                        @if (selectedPatientHistory.Any())
                        {
                            <div class="card card-body mb-3">
                                <h6>Historique CNAM du patient</h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-striped mb-0">
                                        <thead>
                                            <tr>
                                                <th>Date début</th>
                                                <th>Date fin</th>
                                                <th>Titre</th>
                                                <th>Nb séances</th>
                                                <th>Total TTC</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var history in selectedPatientHistory)
                                            {
                                                <tr>
                                                    <td>@history.DateDebut?.ToString("yyyy-MM-dd")</td>
                                                    <td>@history.DateFin?.ToString("yyyy-MM-dd")</td>
                                                    <td>@history.Titre</td>
                                                    <td>@history.NbSeances</td>
                                                    <td>@($"{history.PrixTTC:F2} DT")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                    }
                    <h5 class="mt-4">Programme</h5>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Titre</label>
                    <InputText class="form-control" @bind-Value="createProgram.Titre" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Nature</label>
                    <InputSelect class="form-select" @bind-Value="createProgram.NatureSeances">
                        <option value="">-- Sélectionnez --</option>
                        @foreach (var natureOption in GetNatureSeancesOptions())
                        {
                            <option value="@natureOption">@natureOption</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-4">
                    <label class="form-label">Type de programme</label>
                    <InputSelect class="form-select" @bind-Value="createProgram.TypeProgramme">
                        <option value="">-- Sélectionnez --</option>
                        @foreach (var typeOption in GetProgramTypeOptions())
                        {
                            <option value="@typeOption">@typeOption</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Nb séances</label>
                    <InputNumber class="form-control" @bind-Value="createProgram.NbSeances" @onchange="_ => RecalculateCreateProgram()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Séances / semaine</label>
                    <InputSelect class="form-select" @bind-Value="createProgram.NbSeancesParSemaine" @onchange="_ => RecalculateCreateProgram()">
                        @for (int i = 1; i <= 3; i++)
                        {
                            <option value="@i">@i</option>
                        }
                    </InputSelect>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Durée (min)</label>
                    <InputNumber class="form-control" @bind-Value="createProgram.DureeSeanceMinutes" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Date début</label>
                    <InputDate class="form-control" @bind-Value="createProgram.DateDebut" @onchange="_ => RecalculateCreateProgram()" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Date fin</label>
                    <InputDate class="form-control" @bind-Value="createProgram.DateFin" disabled />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Code bureau</label>
                    <InputText class="form-control" @bind-Value="createProgram.CodeBureau" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Année</label>
                    <InputText class="form-control" @bind-Value="createProgram.Annee" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">N° décision</label>
                    <InputText class="form-control" @bind-Value="createProgram.NumeroDecision" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">N° ordre</label>
                    <InputText class="form-control" @bind-Value="createProgram.NumeroOrdre" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Prix séance TTC</label>
                    <InputNumber class="form-control" step="0.001" @bind-Value="createProgram.PrixSeanceTTC" @onchange="_ => RecalculateCreateProgram()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Prix TTC</label>
                    <InputNumber class="form-control" step="0.001" @bind-Value="createProgram.PrixTTC" disabled />
                </div>
                <div class="col-md-2">
                    <label class="form-label">TVA (%)</label>
                    <InputNumber class="form-control" @bind-Value="createProgram.TVA" @onchange="_ => RecalculateCreateProgram()" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Montant TVA</label>
                    <InputNumber class="form-control" @bind-Value="createProgram.MontantTVA" disabled />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Prix HT</label>
                    <InputNumber class="form-control" @bind-Value="createProgram.PrixHT" disabled />
                </div>
                <div class="col-md-12 d-flex gap-2">
                    <button class="btn btn-success" @onclick="SaveCnamPatientProgramAsync" disabled="@(isBusy || isSearchingExistingPatient)">
                        @if (isBusy)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        }
                        Créer et imprimer
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="ResetCreateCnamForm" disabled="@(isBusy || isSearchingExistingPatient)">Réinitialiser</button>
                </div>
                @if (!string.IsNullOrEmpty(createSectionMessage))
                {
                    <div class="col-md-12 mt-3">
                        <div class="alert alert-info">@createSectionMessage</div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(validationMessage))
                {
                    <div class="col-md-12 mt-3">
                        <div class="alert alert-danger">@validationMessage</div>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (activeSection == CnamSection.Invoice)
{
    <div class="card section-card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Facture séance CNAM</span>
            <button class="btn btn-outline-secondary btn-icon" @onclick="ExportInvoicePdf" disabled="@(selectedProgram == null)"><i class="bi bi-file-earmark-pdf"></i>Exporter PDF</button>
        </div>
        <div class="card-body">
            @if (!cnamPrograms.Any())
            {
                <div class="alert alert-info">Cliquez sur "Charger" pour lister les programmes CNAM démarrés.</div>
            }
            else
            {
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Patient</th>
                                <th>N° assurée</th>
                                <th>Date début</th>
                                <th>Total TTC</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in cnamPrograms)
                            {
                                <tr class="@(selectedProgram?.ProgramId == item.ProgramId ? "table-active" : string.Empty)">
                                    <td>@item.PatientName</td>
                                    <td>@item.NumeroAssuree</td>
                                    <td>@item.DateDebut?.ToString("yyyy-MM-dd")</td>
                                    <td>@($"{item.PrixTTC:F2} DT")</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-primary" @onclick="() => SelectProgram(item)">Sélectionner</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (selectedProgram != null)
            {
                <div class="border rounded p-3">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h5>Cabinet</h5>
                            <p class="mb-1"><strong>Nom :</strong> @cabinetInfo.NomCabinet</p>
                            <p class="mb-1"><strong>CNAM :</strong> @cabinetInfo.CodeEtablissement</p>
                            <p class="mb-1"><strong>Responsable :</strong> @(string.IsNullOrWhiteSpace(cabinetInfo.NomEtablissement) ? (string.IsNullOrWhiteSpace(cabinetInfo.Qualite) ? "" : cabinetInfo.Qualite) : cabinetInfo.NomEtablissement)</p>
                            <p class="mb-1"><strong>Matricule fiscal :</strong> @cabinetInfo.MatriculeFiscal</p>
                            <p class="mb-1"><strong>N° EMPLOYEUR :</strong> @cabinetInfo.NumeroEmployeur</p>
                            <p class="mb-0"><strong>Code CNAM :</strong> @cabinetInfo.CodeCnam</p>
                        </div>
                        <div class="col-md-6">
                            <h5>Facture</h5>
                            <p class="mb-1"><strong>N° facture :</strong> @invoiceNumber</p>
                            <p class="mb-0"><strong>Date facture :</strong> @invoiceDate</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <h6>Assurée</h6>
                            <p class="mb-1"><strong>Patient :</strong> @selectedProgram.PatientName</p>
                            @if (!string.IsNullOrWhiteSpace(selectedProgram.NumeroAssuree))
                            {
                                <p class="mb-1"><strong>N° assurée :</strong> @selectedProgram.NumeroAssuree</p>
                            }
                            <p class="mb-1"><strong>Code patient :</strong> @selectedProgram.CodePatient</p>
                            <p class="mb-1"><strong>Qualité :</strong> @selectedProgram.Qualite</p>
                            <p class="mb-0"><strong>Couverture :</strong> @selectedProgram.Couverture</p>
                        </div>
                        <div class="col-md-6">
                            <h6>Séance</h6>
                            <p class="mb-1"><strong>Nature :</strong> @selectedProgram.NatureSeances</p>
                            <p class="mb-1"><strong>N° décision :</strong> @($"{selectedProgram.CodeBureau}/{selectedProgram.Annee}/{selectedProgram.NumeroDecision}")</p>
                            <p class="mb-1"><strong>Date début :</strong> @selectedProgram.DateDebut?.ToString("yyyy-MM-dd")</p>
                            <p class="mb-1"><strong>Date fin :</strong> @selectedProgram.DateFin?.ToString("yyyy-MM-dd")</p>
                            <p class="mb-1"><strong>Nb séances :</strong> @selectedProgram.NbSeances</p>
                            <p class="mb-1"><strong>Durée séance :</strong> @selectedProgram.DureeSeanceMinutes min</p>
                            <p class="mb-1"><strong>Prix unitaire :</strong> @($"{selectedProgram.PrixUnitaire:F2} DT")</p>
                            <p class="mb-0"><strong>Total TTC :</strong> @($"{selectedProgram.PrixTTC:F2} DT")</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(selectedProgram.NumeroAssuree))
                    {
                        <div class="row mb-3">
                            <div class="col-md-4"><strong>Code bordereau :</strong> @selectedProgram.CodeBureau</div>
                            <div class="col-md-4"><strong>Année :</strong> @selectedProgram.Annee</div>
                            <div class="col-md-4"><strong>N° décision :</strong> @selectedProgram.NumeroDecision</div>
                        </div>
                        <div class="row">
                            <div class="col-md-6"><strong>N° ordre :</strong> @selectedProgram.NumeroOrdre</div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
}

@if (activeSection == CnamSection.Bordereau)
{
    <div class="card section-card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Bordereau CNAM</span>
            <div>
                <button type="button" class="btn btn-outline-secondary btn-icon me-2" @onclick="ExportBordereauPdf" disabled="@(!HasSelectedBordereau)"><i class="bi bi-file-earmark-pdf"></i>Exporter Bordereau</button>
                <button type="button" class="btn btn-outline-secondary btn-icon" @onclick="ExportBordereauTxt" disabled="@(!HasSelectedBordereau)"><i class="bi bi-file-earmark-text"></i>Exporter TXT</button>
            </div>
        </div>
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Factures à exécuter</h5>
                <div>
                    <button class="btn btn-primary btn-icon me-2" @onclick="ExecuteSelectedBordereau" disabled="@(!HasSelectedBordereau)"><i class="bi bi-check2-circle"></i>Exécuter la sélection</button>
                    <button class="btn btn-outline-secondary btn-icon" @onclick="ClearBordereauSelection" disabled="@(!HasSelectedBordereau)"><i class="bi bi-x-circle"></i>Désélectionner</button>
                </div>
            </div>
            @if (!cnamBordereau.Any())
            {
                <div class="alert alert-info">Aucune facture à exécuter pour cette durée.</div>
            }
            else
            {
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th style="width: 40px"></th>
                                <th>Programme</th>
                                <th>N° facture</th>
                                <th>Date facture</th>
                                <th>Date fin</th>
                                <th>N° assurée</th>
                                <th>Patient</th>
                                <th>Total TTC</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in cnamBordereau)
                            {
                                <tr class=@(IsBordereauRowBlocked(row) ? "table-danger" : string.Empty)>
                                    <td>
                                        <input class="form-check-input" type="checkbox" checked=@IsSelectedBordereau(row.ProgramId) disabled=@(IsBordereauRowBlocked(row)) @onchange="e => ToggleBordereauSelection(row.ProgramId, e)" />
                                    </td>
                                    <td>@row.ProgramId</td>
                                    <td>@row.FactureNumber</td>
                                    <td>@row.DateFacture?.ToString("dd/MM/yyyy")</td>
                                    <td>@row.DateFin?.ToString("dd/MM/yyyy")</td>
                                    <td>@row.NumeroAssuree</td>
                                    <td>@row.PatientName</td>
                                    <td>@($"{row.TotalTTC:F2} DT")</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-success btn-icon" disabled="@(IsBordereauRowBlocked(row))" @onclick="() => ExecuteBordereau(row)"><i class="bi bi-play-circle"></i>Exécuter</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mt-3">
                    <strong>Total général TTC :</strong> @($"{cnamBordereau.Sum(r => r.TotalTTC):F2} DT")
                </div>
            }
        </div>
    </div>

    <div class="card section-card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Bordereau exécuté</span>
            <span class="badge-soft">Historique</span>
        </div>
        <div class="card-body">
            @if (!ExecutedBordereaux.Any())
            {
                <div class="alert alert-info">Aucun bordereau exécuté pour cette période.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>N° bordereau</th>
                                <th>Nb factures</th>
                                <th>Total TTC</th>
                                <th>Date exécution</th>
                                <th>Exécuté par</th>
                                <th>Encaisse</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var bordereau in ExecutedBordereaux)
                            {
                                <tr>
                                    <td>@bordereau.BordereauNumber</td>
                                    <td>@bordereau.NbFactures</td>
                                    <td>@($"{bordereau.TotalTTC:F2} DT")</td>
                                    <td>@bordereau.ExecutedAt?.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@bordereau.ExecutedBy</td>
                                    <td>@(bordereau.IsEncaisse ? "Oui" : "Non")</td>
                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ExportExecutedBordereauPdf(bordereau.BordereauNumber)">Exporter Bordereau</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary me-1" @onclick="() => ExportExecutedBordereauTxt(bordereau.BordereauNumber)">Exporter TXT</button>
                                        <button type="button" class="btn btn-sm btn-info me-1" @onclick="() => ToggleEncaisseStatus(bordereau.BordereauNumber, !bordereau.IsEncaisse)">@(bordereau.IsEncaisse ? "Marquer non encaissé" : "Marquer encaissé")</button>
                                        <button type="button" class="btn btn-sm btn-warning me-1" @onclick="() => CancelExecutedBordereau(bordereau.BordereauNumber)">Annuler exécution</button>
                                        <button type="button" class="btn btn-sm btn-danger" @onclick="() => DeleteExecutedBordereau(bordereau.BordereauNumber)">Supprimer définitivement</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

