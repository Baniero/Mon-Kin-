    private static string SanitizeFileName(string filename)
    {
        var invalidChars = System.IO.Path.GetInvalidFileNameChars();
        var sanitized = string.Concat(filename.Select(ch => invalidChars.Contains(ch) ? '_' : ch));
        return string.IsNullOrWhiteSpace(sanitized) ? "export" : sanitized;
    }

    private async Task ExecuteBordereau(CnamBordereauEntryDto entry)
    {
        errorMessage = null;
        successMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/finance/cnam-bordereau-execute", new CnamBordereauExecuteRequestDto
            {
                ProgramId = entry.ProgramId
            });

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"Impossible d'exécuter la facture : {response.ReasonPhrase}";
                return;
            }

            successMessage = "Facture exécutée et enregistrée dans le bordereau exécuté.";
            await LoadCnamBordereau();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors de l'exécution : {ex.Message}";
        }
    }

    private async Task ExecuteSelectedBordereau()
    {
        if (!HasSelectedBordereau)
        {
            errorMessage = "Sélectionnez au moins une facture à exécuter.";
            return;
        }

        errorMessage = null;
        successMessage = null;

        try
        {
            var response = await Http.PostAsJsonAsync("api/finance/cnam-bordereau-execute-bulk", new
            {
                ProgramIds = selectedBordereauProgramIds.ToList()
            });

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = $"Impossible d'exécuter la sélection : {response.ReasonPhrase}";
                return;
            }

            successMessage = "Factures sélectionnées exécutées et enregistrées dans le bordereau exécuté.";
            await LoadCnamBordereau();
        }
        catch (Exception ex)
        {
            errorMessage = $"Erreur lors de l'exécution de la sélection : {ex.Message}";
        }
    }

    private void ToggleBordereauSelection(int programId, ChangeEventArgs args)
    {
        var isChecked = args.Value is bool value && value;
        if (isChecked)
        {
            selectedBordereauProgramIds.Add(programId);
        }
        else
        {
            selectedBordereauProgramIds.Remove(programId);
        }
    }

    private bool IsSelectedBordereau(int programId) => selectedBordereauProgramIds.Contains(programId);

    private bool HasSelectedBordereau => selectedBordereauProgramIds.Any();

    private void ClearBordereauSelection()
    {
        selectedBordereauProgramIds.Clear();
    }

    private enum CnamSection
    {
        Recovery,
        Invoice,
        Bordereau
    }
