@using System.Reflection
@inject NavigationManager NavigationManager
@inject MonKineBlazor.Client.Services.AuthService AuthService
@inherits RouteView

@if (RouteData?.PageType != null)
{
    var pageType = RouteData.PageType;
    if (pageType.GetCustomAttribute<AllowAnonymousAttribute>() is not null)
    {
        <RouteView RouteData="RouteData" DefaultLayout="DefaultLayout" />
    }
    else if (!AuthService.IsAuthenticated)
    {
        var relativeUri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        if (string.IsNullOrWhiteSpace(relativeUri))
        {
            relativeUri = "/";
        }
        NavigationManager.NavigateTo($"/login?redirectUri={Uri.EscapeDataString(relativeUri)}&message=Please+login+to+access+this+page", true);
    }
    else if (pageType.GetCustomAttribute<AdminOnlyAttribute>() is not null && AuthService.CurrentUser?.Role != "admin")
    {
        NavigationManager.NavigateTo("/access-denied", true);
    }
    else
    {
        <RouteView RouteData="RouteData" DefaultLayout="DefaultLayout" />
    }
}
else
{
    <RouteView RouteData="RouteData" DefaultLayout="DefaultLayout" />
}
