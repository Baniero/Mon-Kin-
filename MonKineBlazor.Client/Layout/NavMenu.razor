<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid align-items-center d-flex">
        <a class="navbar-brand d-flex align-items-center" href="">
            <img src="logo.svg" alt="Logo Mon kiné" class="app-logo" />
            <span class="ms-2 app-title">Mon kiné</span>
        </a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="nav-icon bi bi-speedometer2" aria-hidden="true"></span>
                <span class="nav-text">Tableau de bord</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="patients">
                <span class="nav-icon bi bi-person-lines-fill" aria-hidden="true"></span>
                <span class="nav-text">Patients</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="appointments">
                <span class="nav-icon bi bi-calendar-check" aria-hidden="true"></span>
                <span class="nav-text">Rendez-vous</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="finance">
                <span class="nav-icon bi bi-wallet2" aria-hidden="true"></span>
                <span class="nav-text">Finance</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="cnam">
                <span class="nav-icon bi bi-file-earmark-medical" aria-hidden="true"></span>
                <span class="nav-text">CNAM</span>
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="manage-cabinet">
                <span class="nav-icon bi bi-building" aria-hidden="true"></span>
                <span class="nav-text">Gérer mon cabinet</span>
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}
