@inherits LayoutComponentBase
@inject MonKineBlazor.Client.Services.AuthService AuthService
<div class="page">
    @if (AuthService.IsAuthenticated)
    {
        <div class="sidebar">
            <NavMenu />
        </div>
    }

    <main>
        <div class="top-row px-4">
            <a href="https://www.facebook.com/Monappsolution/?locale=fr_FR" target="_blank" rel="noopener noreferrer">About</a>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>
