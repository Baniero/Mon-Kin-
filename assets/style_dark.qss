/* Mon Kine dark professional theme */
QWidget {
    background-color: #1b2229;
    color: #e6edf5;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 11pt;
}

QMainWindow, QDialog, QFrame {
    background-color: #1b2229;
    color: #e6edf5;
}

QLabel {
    color: #d8e6f3;
    font-size: 11pt;
}

QLabel#homeTitle {
    font-size: 20pt;
    font-weight: 700;
    color: #91d4ff;
}

QLabel#homeSubtitle {
    font-size: 11pt;
    color: #a8c1d6;
}

QLabel#sectionTitle {
    font-size: 14pt;
    font-weight: 700;
    color: #74c7ff;
}

QGroupBox {
    background-color: #232c35;
    border: 1px solid #3c4d5b;
    border-radius: 8px;
    margin-top: 10px;
    padding: 12px 10px 10px 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #74c7ff;
    background-color: #232c35;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QDateTimeEdit, QTextEdit, QPlainTextEdit {
    background-color: #2a3641;
    color: #e6edf5;
    border: 1px solid #506373;
    border-radius: 7px;
    padding: 6px 10px;
    min-height: 30px;
    selection-background-color: #2f89c5;
    selection-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #52aee6;
    background-color: #31414d;
}

QComboBox QAbstractItemView {
    background-color: #2a3641;
    color: #e6edf5;
    border: 1px solid #506373;
    selection-background-color: #2f89c5;
    selection-color: #ffffff;
}

QPushButton {
    background-color: #2f89c5;
    color: #f8fcff;
    border: 1px solid #246e9f;
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 32px;
    font-size: 10.5pt;
    font-weight: 700;
}

QPushButton:hover { background-color: #2679ae; }
QPushButton:pressed { background-color: #1f658f; }
QPushButton:disabled {
    background-color: #4a5661;
    color: #9fb0bf;
    border-color: #5b6873;
}

QToolButton {
    background-color: #232c35;
    color: #e6edf5;
    border: 1px solid #3e4f5d;
    border-radius: 8px;
    padding: 5px 10px;
    min-height: 30px;
    font-weight: 600;
}

QToolButton:hover {
    background-color: #2c3945;
    border-color: #5e7689;
}

QTableWidget, QTableView {
    background-color: #24303a;
    alternate-background-color: #2b3742;
    border: 1px solid #415362;
    border-radius: 8px;
    gridline-color: #394957;
    color: #e7eef6;
    selection-background-color: #2f89c5;
    selection-color: #ffffff;
}

QTableWidget::item, QTableView::item {
    padding: 6px 8px;
}

QTableWidget QPushButton, QTableView QPushButton {
    min-height: 24px;
    padding: 2px 10px;
    font-size: 10pt;
    border-radius: 6px;
    margin: 0;
}

QHeaderView::section {
    background-color: #2d4f67;
    color: #eaf6ff;
    border: none;
    padding: 7px 8px;
    min-height: 32px;
    font-size: 10.5pt;
    font-weight: 700;
}

QTabWidget::pane {
    border: 1px solid #415362;
    border-radius: 8px;
    background-color: #232d36;
}

QTabBar::tab {
    background-color: #2b3945;
    color: #c9dae8;
    border: 1px solid #435869;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 6px 14px;
    min-height: 30px;
    font-weight: 600;
}

QTabBar::tab:hover { background-color: #314353; }
QTabBar::tab:selected {
    background-color: #2f89c5;
    color: #ffffff;
    border-color: #246e9f;
}

QCheckBox {
    color: #d8e6f3;
    spacing: 7px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #5a6f81;
    border-radius: 4px;
    background-color: #27343f;
}

QCheckBox::indicator:checked {
    background-color: #2f89c5;
    border-color: #246e9f;
}

QListWidget {
    background-color: #24303a;
    border: 1px solid #415362;
    border-radius: 8px;
    alternate-background-color: #2b3742;
    color: #e7eef6;
}

QCalendarWidget QWidget {
    alternate-background-color: #2b3742;
}

QCalendarWidget QAbstractItemView:enabled {
    color: #e6edf5;
    selection-background-color: #2f89c5;
    selection-color: #ffffff;
}

QScrollBar:vertical {
    background-color: #2a3641;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #63788d;
    border-radius: 6px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover { background-color: #2f89c5; }
QScrollBar:horizontal {
    background-color: #2a3641;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #63788d;
    border-radius: 6px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover { background-color: #2f89c5; }
QScrollBar::add-line, QScrollBar::sub-line { border: none; background: none; }

QToolTip {
    background-color: #0f1720;
    color: #ffffff;
    border: 1px solid #33414c;
    border-radius: 6px;
    padding: 4px 8px;
}

QStatusBar {
    background-color: #24313b;
    color: #c8d9e8;
    border-top: 1px solid #3f5260;
}

QToolBar {
    background-color: #232c35;
    border: 1px solid #3c4d5b;
    spacing: 4px;
}

QProgressBar {
    background-color: #2a3641;
    border: 1px solid #415362;
    border-radius: 6px;
    text-align: center;
    color: #d8e6f3;
}

QProgressBar::chunk {
    background-color: #2f89c5;
    border-radius: 5px;
}
