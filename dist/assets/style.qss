/* Mon Kine professional theme */
QWidget {
    background-color: #f3f6fb;
    color: #1f2a37;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 11pt;
}

QMainWindow, QDialog, QFrame {
    background-color: #f3f6fb;
    color: #1f2a37;
}

QLabel {
    color: #1d2939;
    font-size: 11pt;
}

QLabel#homeTitle {
    font-size: 20pt;
    font-weight: 700;
    color: #1e3a8a;
}

QLabel#homeSubtitle {
    font-size: 11pt;
    color: #475569;
}

QLabel#sectionTitle {
    font-size: 14pt;
    font-weight: 700;
    color: #1d4ed8;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #ccd6e3;
    border-radius: 8px;
    margin-top: 10px;
    padding: 12px 10px 10px 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #2563eb;
    background-color: #ffffff;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QDateTimeEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #1f2a37;
    border: 1px solid #b8c5d8;
    border-radius: 7px;
    padding: 6px 10px;
    min-height: 30px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #2563eb;
    background-color: #f8fbff;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1f2a37;
    border: 1px solid #b8c5d8;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QPushButton {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #1e40af;
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 32px;
    font-size: 10.5pt;
    font-weight: 700;
}

QPushButton:hover { background-color: #1d4ed8; }
QPushButton:pressed { background-color: #1e40af; }
QPushButton:disabled {
    background-color: #a8b3c2;
    color: #edf2f7;
    border-color: #9aa7b8;
}

QToolButton {
    background-color: #ffffff;
    color: #1f2a37;
    border: 1px solid #ccd6e3;
    border-radius: 8px;
    padding: 5px 10px;
    min-height: 30px;
    font-weight: 600;
}

QToolButton:hover {
    background-color: #eef4ff;
    border-color: #9db2cf;
}

QTableWidget, QTableView {
    background-color: #ffffff;
    alternate-background-color: #f7faff;
    border: 1px solid #ccd6e3;
    border-radius: 8px;
    gridline-color: #d7e0eb;
    color: #1f2a37;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QTableWidget::item, QTableView::item {
    padding: 6px 8px;
}

QTableWidget QPushButton, QTableView QPushButton {
    min-height: 24px;
    padding: 2px 10px;
    font-size: 10pt;
    border-radius: 6px;
    margin: 0;
}

QHeaderView::section {
    background-color: #1d4ed8;
    color: #ffffff;
    border: none;
    padding: 7px 8px;
    min-height: 32px;
    font-size: 10.5pt;
    font-weight: 700;
}

QTabWidget::pane {
    border: 1px solid #ccd6e3;
    border-radius: 8px;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #e8eef8;
    color: #23324a;
    border: 1px solid #ccd6e3;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 6px 14px;
    min-height: 30px;
    font-weight: 600;
}

QTabBar::tab:hover { background-color: #dbe6f5; }
QTabBar::tab:selected {
    background-color: #2563eb;
    color: #ffffff;
    border-color: #1e40af;
}

QCheckBox {
    color: #1f2a37;
    spacing: 7px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #b8c5d8;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #2563eb;
    border-color: #1e40af;
}

QListWidget {
    background-color: #ffffff;
    border: 1px solid #ccd6e3;
    border-radius: 8px;
    alternate-background-color: #f7faff;
}

QCalendarWidget QWidget {
    alternate-background-color: #f7faff;
}

QCalendarWidget QAbstractItemView:enabled {
    color: #1f2a37;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QScrollBar:vertical {
    background-color: #e9eef5;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #93a6bf;
    border-radius: 6px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover { background-color: #2563eb; }
QScrollBar:horizontal {
    background-color: #e9eef5;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #93a6bf;
    border-radius: 6px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover { background-color: #2563eb; }
QScrollBar::add-line, QScrollBar::sub-line { border: none; background: none; }

QToolTip {
    background-color: #0f172a;
    color: #ffffff;
    border: 1px solid #1e293b;
    border-radius: 6px;
    padding: 4px 8px;
}

QStatusBar {
    background-color: #e8eef8;
    color: #23324a;
    border-top: 1px solid #ccd6e3;
}

QToolBar {
    background-color: #ffffff;
    border: 1px solid #ccd6e3;
    spacing: 4px;
}

QProgressBar {
    background-color: #e9eef5;
    border: 1px solid #ccd6e3;
    border-radius: 6px;
    text-align: center;
    color: #23324a;
}

QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 5px;
}
