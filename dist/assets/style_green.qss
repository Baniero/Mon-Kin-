/* Mon Kine green professional theme */
QWidget {
    background-color: #f2faf4;
    color: #1f3327;
    font-family: 'Segoe UI', 'Arial', sans-serif;
    font-size: 11pt;
}

QMainWindow, QDialog, QFrame {
    background-color: #f2faf4;
    color: #1f3327;
}

QLabel {
    color: #1d3b2a;
    font-size: 11pt;
}

QLabel#homeTitle {
    font-size: 20pt;
    font-weight: 700;
    color: #1f6a43;
}

QLabel#homeSubtitle {
    font-size: 11pt;
    color: #3f6a52;
}

QLabel#sectionTitle {
    font-size: 14pt;
    font-weight: 700;
    color: #1f7f4f;
}

QGroupBox {
    background-color: #ffffff;
    border: 1px solid #c8dfd0;
    border-radius: 8px;
    margin-top: 10px;
    padding: 12px 10px 10px 10px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
    color: #2e8b57;
    background-color: #ffffff;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTimeEdit, QDateTimeEdit, QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #1f3327;
    border: 1px solid #b8d5c1;
    border-radius: 7px;
    padding: 6px 10px;
    min-height: 30px;
    selection-background-color: #2e8b57;
    selection-color: #ffffff;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QTimeEdit:focus, QDateTimeEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #2e8b57;
    background-color: #f7fcf8;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #1f3327;
    border: 1px solid #b8d5c1;
    selection-background-color: #2e8b57;
    selection-color: #ffffff;
}

QPushButton {
    background-color: #2e8b57;
    color: #ffffff;
    border: 1px solid #246e45;
    border-radius: 8px;
    padding: 6px 14px;
    min-height: 32px;
    font-size: 10.5pt;
    font-weight: 700;
}

QPushButton:hover { background-color: #27784b; }
QPushButton:pressed { background-color: #205f3b; }
QPushButton:disabled {
    background-color: #a5b8ac;
    color: #edf3ef;
    border-color: #93a79b;
}

QToolButton {
    background-color: #ffffff;
    color: #1f3327;
    border: 1px solid #c8dfd0;
    border-radius: 8px;
    padding: 5px 10px;
    min-height: 30px;
    font-weight: 600;
}

QToolButton:hover {
    background-color: #eef8f1;
    border-color: #9fc8ae;
}

QTableWidget, QTableView {
    background-color: #ffffff;
    alternate-background-color: #eff9f2;
    border: 1px solid #b8d5c1;
    border-radius: 8px;
    gridline-color: #d3e6d9;
    color: #1f3327;
    selection-background-color: #2e8b57;
    selection-color: #ffffff;
}

QTableWidget::item, QTableView::item {
    padding: 6px 8px;
}

QTableWidget QPushButton, QTableView QPushButton {
    min-height: 24px;
    padding: 2px 10px;
    font-size: 10pt;
    border-radius: 6px;
    margin: 0;
}

QHeaderView::section {
    background-color: #2d7d4f;
    color: #ffffff;
    border: none;
    padding: 7px 8px;
    min-height: 32px;
    font-size: 10.5pt;
    font-weight: 700;
}

QTabWidget::pane {
    border: 1px solid #b8d5c1;
    border-radius: 8px;
    background-color: #ffffff;
}

QTabBar::tab {
    background-color: #e4f2e8;
    color: #264535;
    border: 1px solid #c8dfd0;
    border-bottom: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 6px 14px;
    min-height: 30px;
    font-weight: 600;
}

QTabBar::tab:hover { background-color: #d8ebdf; }
QTabBar::tab:selected {
    background-color: #2e8b57;
    color: #ffffff;
    border-color: #246e45;
}

QCheckBox {
    color: #1f3327;
    spacing: 7px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1px solid #b8d5c1;
    border-radius: 4px;
    background-color: #ffffff;
}

QCheckBox::indicator:checked {
    background-color: #2e8b57;
    border-color: #246e45;
}

QListWidget {
    background-color: #ffffff;
    border: 1px solid #c8dfd0;
    border-radius: 8px;
    alternate-background-color: #eff9f2;
}

QCalendarWidget QWidget {
    alternate-background-color: #eff9f2;
}

QCalendarWidget QAbstractItemView:enabled {
    color: #1f3327;
    selection-background-color: #2e8b57;
    selection-color: #ffffff;
}

QScrollBar:vertical {
    background-color: #e5f0e8;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #90b39d;
    border-radius: 6px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover { background-color: #2e8b57; }
QScrollBar:horizontal {
    background-color: #e5f0e8;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #90b39d;
    border-radius: 6px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover { background-color: #2e8b57; }
QScrollBar::add-line, QScrollBar::sub-line { border: none; background: none; }

QToolTip {
    background-color: #102015;
    color: #ffffff;
    border: 1px solid #2f4f3c;
    border-radius: 6px;
    padding: 4px 8px;
}

QStatusBar {
    background-color: #e4f2e8;
    color: #244436;
    border-top: 1px solid #c8dfd0;
}

QToolBar {
    background-color: #ffffff;
    border: 1px solid #c8dfd0;
    spacing: 4px;
}

QProgressBar {
    background-color: #e5f0e8;
    border: 1px solid #c8dfd0;
    border-radius: 6px;
    text-align: center;
    color: #244436;
}

QProgressBar::chunk {
    background-color: #2e8b57;
    border-radius: 5px;
}
